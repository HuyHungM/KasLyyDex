# Worker secret: signs the session cookie (server-only; >=32 chars)
SESSION_SECRET=

# Public Google Identity Services client id (verified against Google JWKS server-side)
GOOGLE_CLIENT_ID=

# Same-origin browser content boundary -> Axum content service on Northflank
RUST_CONTENT_API_ORIGIN=

# HMAC/JWT signing key for short-lived reader tickets (server-only; >=32 chars)
READER_TICKET_SECRET=
