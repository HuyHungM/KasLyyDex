# Neon Managed Auth (server-only; never prefix with NEXT_PUBLIC_)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Application database (server-only; pooled pg/Drizzle)
DATABASE_URL=

# HMAC/JWT signing key for short-lived reader tickets (server-only; >=32 chars)
READER_TICKET_SECRET=

# Optional operator bootstrap: comma-separated verified auth emails allowed to
# receive the admin role. Client input never grants roles.
OPERATOR_EMAIL_ALLOWLIST=

# Google OAuth is configured on the Neon branch; values are owner-supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Same-origin browser content boundary -> Axum content service
RUST_CONTENT_API_ORIGIN=
NEXT_PUBLIC_APP_URL=
