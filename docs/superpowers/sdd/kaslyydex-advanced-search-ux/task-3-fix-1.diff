 fn search_path(
     q: &str,
     page: u32,
     tags: &[String],
     status: Option<&str>,
     sort: &str,
+    lang: &str,
 ) -> Option<String> {
+    if !matches!(lang, "all" | "vi" | "en") {
+        return None;
+    }
     let offset = page.saturating_sub(1).checked_mul(24)?;
     let mut path = format!("/manga?limit=24&offset={offset}");
     if !q.is_empty() {
         path.push_str(&format!(
             "&title={}",
             utf8_percent_encode(q, NON_ALPHANUMERIC)
         ));
     }
     path.push_str(LIST_PARAMS);
     path.push('&');
     path.push_str(sort_param(sort)?);
     if let Some(status) = status {
         path.push_str(&format!("&status[]={}", status_param(status)?));
     }
     for tag in tags {
         path.push_str(&format!(
             "&includedTags[]={}",
             utf8_percent_encode(tag, NON_ALPHANUMERIC)
         ));
     }
+    // Official MangaDex /manga filter; omitted for `all` to keep legacy paths.
+    if lang != "all" {
+        path.push_str(&format!("&availableTranslatedLanguage[]={lang}"));
+    }
     Some(path)
 }
 
