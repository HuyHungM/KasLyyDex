+/// Required fields are never filled in; optional fields use DTO defaults.
+pub fn normalize_search_hit(hit: &Value) -> Result<MangaSummaryDto, Err> {
+    let hid = hit["hid"]
+        .as_str()
+        .filter(|hid| valid_opaque(hid))
+        .ok_or_else(upstream_err)?;
+    let title = hit["title"]
