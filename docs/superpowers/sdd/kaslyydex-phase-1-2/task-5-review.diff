+.skel-line.w90 { width: 90%; height: 70px; }
+.skel-head { display: flex; gap: 16px; }
+.skel-info { flex: 1; }
+@media (prefers-reduced-motion: no-preference) {
+  @keyframes breathe { 50% { opacity: .57; } }
