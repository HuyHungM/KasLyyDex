diff --git a/web/components/moderation/ModerationQueue.tsx b/web/components/moderation/ModerationQueue.tsx
new file mode 100644
index 0000000..5223ab5
--- /dev/null
+++ b/web/components/moderation/ModerationQueue.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+import { useState } from "react";
+import type { ReportDto, ReportListDto } from "@/lib/contracts";
+import { accountMutate, useAccountSession, useRemoteResource } from "@/lib/account/client";
+
+export default function ModerationQueue() {
+  const { session } = useAccountSession();
+  const identityKey = session.user?.id ?? "guest";
+  const signedIn = session.status === "authenticated";
+  const queue = useRemoteResource<ReportListDto>(
+    signedIn ? "/api/v1/moderation/reports?limit=20" : null,
+    identityKey,
+  );
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [targetType, setTargetType] = useState<"manga" | "chapter">("manga");
+  const [targetId, setTargetId] = useState("");
+  const [locked, setLocked] = useState(true);
+
+  async function act(path: string, method: "PATCH" | "PUT", body: unknown) {
+    setBusy(true);
+    setError(null);
+    setNotice(null);
+    try {
+      await accountMutate(path, method, body);
+      queue.reload();
+      setNotice("Đã cập nhật.");
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Yêu cầu kiểm duyệt không thành công.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  function moderate(comment: ReportDto, action: "hide" | "remove" | "restore") {
+    void act(`/api/v1/moderation/comments/${encodeURIComponent(comment.commentId)}`, "PATCH", { action });
+  }
+
+  if (!signedIn) {
+    return <section className="surface account-card"><h1>Kiểm duyệt</h1><p className="account-hint">Cần đăng nhập để truy cập hàng đợi kiểm duyệt.</p></section>;
+  }
+  if (queue.loading && !queue.data) return <section className="surface account-card">Đang tải hàng đợi…</section>;
+  if (queue.error) {
+    return (
+      <section className="surface account-card" role="alert">
+        <h1>Kiểm duyệt</h1>
+        <p className="account-error">{queue.error}</p>
+        <button type="button" className="btn" onClick={queue.reload}>Thử lại</button>
+      </section>
+    );
+  }
+
+  return (
+    <section className="surface account-card moderation-card">
+      <h1>Hàng đợi kiểm duyệt</h1>
+      <p className="account-hint">Ẩn/xóa bình luận, đóng báo cáo và khóa một chủ đề theo loại + id.</p>
+      {error ? <p className="account-error" role="alert">{error}</p> : null}
+      {notice ? <p className="account-hint" role="status">{notice}</p> : null}
+      <div className="moderation-list">
+        {(queue.data?.items ?? []).map((report) => (
+          <article key={report.id} className="moderation-row">
+            <div>
+              <strong>{report.comment?.authorName ?? "Độc giả"}</strong>
+              <p className="moderation-body">{report.comment?.body ?? "(nội dung không còn)"}</p>
+              <p className="account-hint">Lý do: {report.reason}</p>
+            </div>
+            <div className="comment-actions">
+              <button type="button" className="btn" disabled={busy} onClick={() => moderate(report, "hide")}>Ẩn</button>
+              <button type="button" className="btn" disabled={busy} onClick={() => moderate(report, "remove")}>Xóa</button>
+              <button type="button" className="btn" disabled={busy} onClick={() => moderate(report, "restore")}>Khôi phục</button>
+              <button type="button" className="link-btn" disabled={busy} onClick={() => void act(`/api/v1/moderation/reports/${encodeURIComponent(report.id)}`, "PATCH", { action: "resolve" })}>Đóng</button>
+              <button type="button" className="link-btn" disabled={busy} onClick={() => void act(`/api/v1/moderation/reports/${encodeURIComponent(report.id)}`, "PATCH", { action: "dismiss" })}>Bỏ qua</button>
+            </div>
+          </article>
+        ))}
+        {(queue.data?.items ?? []).length === 0 ? <p className="account-hint">Không có báo cáo mở.</p> : null}
+      </div>
+      <form className="account-form" onSubmit={(event) => {
+        event.preventDefault();
+        void act("/api/v1/moderation/threads", "PUT", { targetType, targetId, locked });
+      }}>
+        <label>
+          Khóa chủ đề
+          <select value={targetType} onChange={(event) => setTargetType(event.target.value as "manga" | "chapter")}>
+            <option value="manga">Truyện</option>
+            <option value="chapter">Chương</option>
+          </select>
+        </label>
+        <label>Id chủ đề<input value={targetId} maxLength={200} onChange={(event) => setTargetId(event.target.value)} /></label>
+        <label className="account-check">
+          <input type="checkbox" checked={locked} onChange={(event) => setLocked(event.target.checked)} />
+          Đóng bình luận mới
+        </label>
+        <button type="submit" className="btn btn-primary" disabled={busy || targetId.trim().length === 0}>Áp dụng</button>
+      </form>
+    </section>
+  );
+}
diff --git a/web/components/notifications/NotificationCenter.tsx b/web/components/notifications/NotificationCenter.tsx
new file mode 100644
index 0000000..8591518
--- /dev/null
+++ b/web/components/notifications/NotificationCenter.tsx
@@ -0,0 +1,144 @@
+"use client";
+
+import Link from "next/link";
+import { useEffect, useRef, useState } from "react";
+import type { NotificationDto, NotificationListDto } from "@/lib/contracts";
+import { accountMutate, useAccountSession, useRemoteResource } from "@/lib/account/client";
+import { refreshChapterNotifications } from "@/lib/community/client";
+
+type Props = { compact?: boolean };
+
+export default function NotificationCenter({ compact = false }: Props) {
+  const { session } = useAccountSession();
+  const identityKey = session.user?.id ?? "guest";
+  const signedIn = session.status === "authenticated";
+  const [open, setOpen] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const inbox = useRemoteResource<NotificationListDto>(
+    signedIn ? "/api/v1/notifications?limit=20" : null,
+    identityKey,
+  );
+  const access = useRemoteResource<{ moderator: boolean }>(
+    signedIn ? "/api/v1/moderation/access" : null,
+    identityKey,
+  );
+  const reloadRef = useRef(inbox.reload);
+  useEffect(() => {
+    reloadRef.current = inbox.reload;
+  }, [inbox.reload]);
+
+  useEffect(() => {
+    if (!signedIn) return;
+    let alive = true;
+    // Demand-driven refresh: no scheduler or background worker is claimed.
+    void refreshChapterNotifications()
+      .then(() => { if (alive) reloadRef.current(); })
+      .catch(() => undefined);
+    return () => { alive = false; };
+  }, [identityKey, signedIn]);
+
+  async function markRead(ids: string[]) {
+    if (ids.length === 0) return;
+    setBusy(true);
+    setError(null);
+    try {
+      await accountMutate("/api/v1/notifications/read", "POST", { ids });
+      reloadRef.current();
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Không đánh dấu được thông báo.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  function rows(items: NotificationDto[]) {
+    return (
+      <div className="notification-list">
+        {items.map((item) => (
+          <article key={item.id} className={`notification-item${item.readAt === null ? " unread" : ""}`}>
+            <div>
+              <strong>{item.title}</strong>
+              <p>{item.body}</p>
+              <time dateTime={new Date(item.createdAt).toISOString()}>
+                {new Date(item.createdAt).toLocaleString("vi-VN")}
+              </time>
+            </div>
+            <div className="comment-actions">
+              {item.href ? <Link href={item.href} onClick={() => void markRead([item.id])}>Mở</Link> : null}
+              {item.readAt === null ? (
+                <button type="button" className="link-btn" disabled={busy} onClick={() => void markRead([item.id])}>
+                  Đã đọc
+                </button>
+              ) : null}
+            </div>
+          </article>
+        ))}
+        {items.length === 0 ? <p className="account-hint">Không có thông báo nào.</p> : null}
+      </div>
+    );
+  }
+
+  if (!signedIn) {
+    if (compact) return null;
+    return (
+      <section className="surface account-card">
+        <h1>Thông báo</h1>
+        <p className="account-hint">Đăng nhập để xem thông báo bình luận, kiểm duyệt và chương mới.</p>
+      </section>
+    );
+  }
+
+  const items = inbox.data?.items ?? [];
+  const unread = inbox.data?.unreadCount ?? 0;
+  const unreadIds = items.filter((item) => item.readAt === null).map((item) => item.id);
+  const body = (
+    <>
+      {error ? <p className="account-error" role="alert">{error}</p> : null}
+      {inbox.error ? <p className="account-error" role="alert">{inbox.error}</p> : null}
+      {inbox.loading && !inbox.data ? <p className="account-hint">Đang tải thông báo…</p> : null}
+      {rows(items)}
+      <div className="comment-actions">
+        <button type="button" className="link-btn" disabled={busy || unreadIds.length === 0} onClick={() => void markRead(unreadIds)}>
+          Đánh dấu đã đọc
+        </button>
+        {compact ? <Link href="/thong-bao">Xem tất cả</Link> : null}
+        {access.data?.moderator ? <Link href="/kiem-duyet">Hàng đợi kiểm duyệt</Link> : null}
+      </div>
+    </>
+  );
+
+  if (!compact) {
+    return (
+      <section className="surface account-card notification-page">
+        <h1>Thông báo</h1>
+        {unread > 0 ? <p className="account-hint">{unread} thông báo chưa đọc.</p> : null}
+        {body}
+      </section>
+    );
+  }
+
+  return (
+    <div className="notification-center">
+      <button
+        type="button"
+        className="notification-bell"
+        aria-label={unread > 0 ? `Thông báo, ${unread} chưa đọc` : "Thông báo"}
+        aria-expanded={open}
+        onClick={() => setOpen((value) => !value)}
+      >
+        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
+          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
+        </svg>
+        {unread > 0 ? <span className="notification-badge" aria-hidden="true">{unread > 9 ? "9+" : unread}</span> : null}
+      </button>
+      {open ? (
+        <div className="notification-panel surface" role="dialog" aria-label="Trung tâm thông báo">
+          <h2>Thông báo</h2>
+          {body}
+        </div>
+      ) : null}
+    </div>
+  );
+}
