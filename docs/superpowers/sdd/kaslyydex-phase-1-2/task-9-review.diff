diff --git a/web/scripts/secret-scan-lib.mjs b/web/scripts/secret-scan-lib.mjs
new file mode 100644
index 0000000..248fea1
--- /dev/null
+++ b/web/scripts/secret-scan-lib.mjs
@@ -0,0 +1,24 @@
+// Deterministic, secret-free credential pattern scan. It looks for provider
+// credentials and non-empty secret assignments; fixture values are built at
+// runtime in tests and never appear literally in tracked files.
+export const PATTERNS = [
+  { name: "private-key", re: /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/ },
+  { name: "google-api-key", re: /AIza[0-9A-Za-z_-]{35}/ },
+  { name: "github-token", re: /gh[pousr]_[A-Za-z0-9]{36}/ },
+  { name: "openai-key", re: /sk-[A-Za-z0-9_-]{24,}/ },
+  { name: "aws-access-key", re: /AKIA[0-9A-Z]{16}/ },
+  { name: "database-url-with-password", re: /postgres(?:ql)?:\/\/[^\s:@/]+:[^\s@/]+@/i },
+  {
+    name: "non-empty-secret-assignment",
+    re: /^[ \t]*(?:NEON_AUTH_COOKIE_SECRET|READER_TICKET_SECRET|DATABASE_URL|GOOGLE_CLIENT_SECRET|NEON_AUTH_BASE_URL)[ \t]*=[ \t]*\S.*$/m,
+  },
+];
+
+export function scanText(text, file = "<text>") {
+  const findings = [];
+  for (const { name, re } of PATTERNS) {
+    const match = text.match(re);
+    if (match) findings.push({ file, pattern: name, line: text.slice(0, match.index).split("\n").length });
+  }
+  return findings;
+}
diff --git a/web/scripts/secret-scan.mjs b/web/scripts/secret-scan.mjs
new file mode 100644
index 0000000..5a174be
--- /dev/null
+++ b/web/scripts/secret-scan.mjs
@@ -0,0 +1,33 @@
+// Usage: node scripts/secret-scan.mjs [repoDir]
+// Scans tracked text files only; values are never printed.
+import { execFileSync } from "node:child_process";
+import { readFile } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { scanText } from "./secret-scan-lib.mjs";
+
+const repoDir = resolve(process.argv[2] ?? fileURLToPath(new URL("../..", import.meta.url)));
+const files = execFileSync("git", ["ls-files", "-z"], { cwd: repoDir, encoding: "utf8" })
+  .split("\0")
+  .filter(Boolean)
+  .filter((file) => /\.(?:md|mjs|js|ts|tsx|json|yml|yaml|sql|toml|example|txt)$/.test(file) || file.endsWith(".env.example"));
+
+const findings = [];
+for (const file of files) {
+  let text;
+  try {
+    text = await readFile(join(repoDir, file), "utf8");
+  } catch {
+    continue;
+  }
+  findings.push(...scanText(text, file));
+}
+
+if (findings.length > 0) {
+  for (const finding of findings) {
+    console.error(`${finding.file}:${finding.line}: ${finding.pattern}`);
+  }
+  console.error(`secret scan failed: ${findings.length} candidate(s)`);
+  process.exit(1);
+}
+console.log(`secret scan passed: ${files.length} tracked text files, 0 candidates`);
