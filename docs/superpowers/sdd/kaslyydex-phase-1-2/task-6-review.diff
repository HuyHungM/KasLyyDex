index 0000000..2a406f4
--- /dev/null
+++ b/web/lib/me/service.ts
@@ -0,0 +1,459 @@
+import "server-only";
+
+import { and, desc, eq, sql } from "drizzle-orm";
+import type { AppDatabase } from "../db/client";
+import * as tables from "../db/schema";
+import type { AccountIdentity } from "../auth/identity";
+import { roleFromVerifiedAllowlist } from "../validators";
+import type {
+  ImportHistoryItem,
+  ImportLibraryItem,
+  LibraryInput,
+  ProgressInput,
+  ReaderSettingsDto,
+} from "../validators";
+import { mergeLibrary, mergeProgress } from "../merge";
+
+export class ServiceError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, code: string, message: string) {
+    super(message);
+    this.name = "ServiceError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+function uniqueViolation(error: unknown): boolean {
+  if (!error || typeof error !== "object") return false;
+  const code = "code" in error ? String((error as { code: unknown }).code) : "";
+  const message = `${"message" in error ? String((error as { message: unknown }).message) : ""} ${
+    "cause" in error && error.cause && typeof error.cause === "object" && "message" in error.cause
+      ? String((error.cause as { message: unknown }).message)
+      : ""
+  }`;
+  return code === "23505" || /duplicate key|unique constraint/i.test(message);
+}
+
+function date(ms: number): Date {
+  return new Date(Number.isFinite(ms) ? ms : Date.now());
+}
+
+const excluded = (column: string) => sql.raw(`excluded."${column}"`);
+
+export type ProfileDto = {
+  id: string;
+  username: string | null;
+  displayName: string | null;
+  avatarUrl: string | null;
+  level: number;
+  totalXp: number;
+};
+
+export type LibraryDto = {
+  mangaId: string;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  status: string;
+  followedAt: number;
+  lastChapterId: string | null;
+  lastReadPublish: number;
+  revision: number;
+};
+
+export type ProgressDto = {
+  mangaId: string;
+  chapterId: string;
+  lang: string;
+  chapter: string | null;
+  title: string | null;
+  coverFile: string | null;
+  page: number;
+  total: number;
+  maxPage: number;
+  lastReadAt: number;
+  revision: number;
+};
+
+export type ImportSummary = {
+  libraryInserted: number;
+  libraryUpdated: number;
+  progressInserted: number;
+  progressUpdated: number;
+  skipped: number;
+  settingsApplied: boolean;
+};
+
+function profileDto(row: typeof tables.profiles.$inferSelect): ProfileDto {
+  return {
+    id: row.userId,
+    username: row.username,
+    displayName: row.displayName,
+    avatarUrl: row.avatarUrl,
+    // Explicit placeholder: Task 8 owns XP events and realm titles.
+    level: 1,
+    totalXp: row.totalXp,
+  };
+}
+
+function libraryDto(row: typeof tables.libraryEntries.$inferSelect): LibraryDto {
+  return {
+    mangaId: row.mangaId,
+    title: row.title,
+    coverFile: row.coverFile,
+    lang: row.lang,
+    status: row.status,
+    followedAt: row.followedAt,
+    lastChapterId: row.lastChapterId,
+    lastReadPublish: row.lastReadPublish,
+    revision: row.revision,
+  };
+}
+
+function progressDto(row: typeof tables.chapterProgress.$inferSelect): ProgressDto {
+  return {
+    mangaId: row.mangaId,
+    chapterId: row.chapterId,
+    lang: row.language,
+    chapter: row.chapter,
+    title: row.title,
+    coverFile: row.coverFile,
+    page: row.page,
+    total: row.total,
+    maxPage: row.maxPage,
+    lastReadAt: row.lastReadAt,
+    revision: row.revision,
+  };
+}
+
+/// Creates the application profile on first authenticated use. Role bootstrap
+/// is the only path to elevated privileges and requires a verified allowlisted
+/// email from the managed session, never a request field.
+export async function ensureProfile(
+  db: AppDatabase,
+  identity: AccountIdentity,
+  options: { now: number; allowlist: readonly string[] },
+): Promise<ProfileDto> {
+  await db.insert(tables.profiles).values({
+    userId: identity.id,
+    createdAt: date(options.now),
+    updatedAt: date(options.now),
+  }).onConflictDoNothing();
+
+  const role = roleFromVerifiedAllowlist(identity, options.allowlist);
+  if (role) {
+    await db.insert(tables.userRoles).values({ userId: identity.id, role }).onConflictDoNothing();
+  }
+  const rows = await db.select().from(tables.profiles).where(eq(tables.profiles.userId, identity.id)).limit(1);
+  if (rows.length === 0) throw new ServiceError(500, "PROFILE_UNAVAILABLE", "Account profile could not be loaded.");
+  return profileDto(rows[0]);
+}
+
+export async function updateProfile(
+  db: AppDatabase,
+  userId: string,
+  patch: { username?: string | null; displayName?: string | null; avatarUrl?: string | null },
+  now: number,
+): Promise<ProfileDto> {
+  const values: Partial<typeof tables.profiles.$inferInsert> = { updatedAt: date(now) };
+  if (Object.hasOwn(patch, "username")) values.username = patch.username ?? null;
+  if (Object.hasOwn(patch, "displayName")) values.displayName = patch.displayName ?? null;
+  if (Object.hasOwn(patch, "avatarUrl")) values.avatarUrl = patch.avatarUrl ?? null;
+  try {
+    await db.update(tables.profiles).set(values).where(eq(tables.profiles.userId, userId));
+  } catch (error) {
+    if (uniqueViolation(error)) throw new ServiceError(409, "USERNAME_TAKEN", "That username is already in use.");
+    throw error;
+  }
+  const rows = await db.select().from(tables.profiles).where(eq(tables.profiles.userId, userId)).limit(1);
+  return profileDto(rows[0]);
+}
+
+export async function listLibrary(db: AppDatabase, userId: string): Promise<LibraryDto[]> {
+  const rows = await db.select().from(tables.libraryEntries)
+    .where(eq(tables.libraryEntries.userId, userId))
+    .orderBy(desc(tables.libraryEntries.followedAt))
+    .limit(200);
+  return rows.map(libraryDto);
+}
+
+export async function putLibrary(
+  db: AppDatabase,
+  userId: string,
+  mangaId: string,
+  input: LibraryInput,
+  now: number,
+): Promise<LibraryDto> {
+  await db.insert(tables.libraryEntries).values({
+    userId,
+    mangaId,
+    title: input.title,
+    coverFile: input.coverFile,
+    lang: input.lang,
+    status: input.status,
+    followedAt: now,
+    lastReadPublish: 0,
+    revision: 1,
+    updatedAt: date(now),
+  }).onConflictDoUpdate({
+    target: [tables.libraryEntries.userId, tables.libraryEntries.mangaId],
+    set: {
+      title: excluded("title"),
+      coverFile: excluded("cover_file"),
+      lang: excluded("lang"),
+      status: excluded("status"),
+      // Server owns the mutation time and monotonically increasing revision.
+      followedAt: sql`greatest(${tables.libraryEntries.followedAt}, ${excluded("followed_at")})`,
+      revision: sql`${tables.libraryEntries.revision} + 1`,
+      updatedAt: date(now),
+    },
+  });
+  const rows = await db.select().from(tables.libraryEntries)
+    .where(and(eq(tables.libraryEntries.userId, userId), eq(tables.libraryEntries.mangaId, mangaId)))
+    .limit(1);
+  return libraryDto(rows[0]);
+}
+
+export async function deleteLibrary(db: AppDatabase, userId: string, mangaId: string): Promise<boolean> {
+  const rows = await db.select().from(tables.libraryEntries)
+    .where(and(eq(tables.libraryEntries.userId, userId), eq(tables.libraryEntries.mangaId, mangaId)))
+    .limit(1);
+  if (rows.length === 0) return false;
+  await db.delete(tables.libraryEntries)
+    .where(and(eq(tables.libraryEntries.userId, userId), eq(tables.libraryEntries.mangaId, mangaId)));
+  return true;
+}
+
+export async function putProgress(
+  db: AppDatabase,
+  userId: string,
+  chapterId: string,
+  input: ProgressInput,
+  now: number,
+): Promise<ProgressDto> {
+  await db.insert(tables.chapterProgress).values({
+    userId,
+    mangaId: input.mangaId,
+    chapterId,
+    language: input.lang,
+    chapter: input.chapter,
+    title: input.title,
+    coverFile: input.coverFile,
+    page: input.page,
+    maxPage: input.page,
+    total: input.total,
+    lastReadAt: now,
+    revision: 1,
+    updatedAt: date(now),
+  }).onConflictDoUpdate({
+    target: [
+      tables.chapterProgress.userId,
+      tables.chapterProgress.mangaId,
+      tables.chapterProgress.chapterId,
+      tables.chapterProgress.language,
+    ],
+    set: {
+      // Current page may move backward for a reread; observed maximum may not.
+      page: excluded("page"),
+      maxPage: sql`greatest(${tables.chapterProgress.maxPage}, ${excluded("page")})`,
+      total: excluded("total"),
+      chapter: excluded("chapter"),
+      title: excluded("title"),
+      coverFile: excluded("cover_file"),
+      lastReadAt: sql`greatest(${tables.chapterProgress.lastReadAt} + 1, ${excluded("last_read_at")})`,
+      revision: sql`${tables.chapterProgress.revision} + 1`,
+      updatedAt: date(now),
+    },
+  });
+  const rows = await db.select().from(tables.chapterProgress).where(and(
+    eq(tables.chapterProgress.userId, userId),
+    eq(tables.chapterProgress.mangaId, input.mangaId),
+    eq(tables.chapterProgress.chapterId, chapterId),
+    eq(tables.chapterProgress.language, input.lang),
+  )).limit(1);
+  return progressDto(rows[0]);
+}
+
+export async function listProgress(db: AppDatabase, userId: string): Promise<ProgressDto[]> {
+  const rows = await db.select().from(tables.chapterProgress)
+    .where(eq(tables.chapterProgress.userId, userId))
+    .orderBy(desc(tables.chapterProgress.lastReadAt))
+    .limit(100);
+  return rows.map(progressDto);
+}
+
+export async function deleteProgress(db: AppDatabase, userId: string, chapterId: string): Promise<boolean> {
+  const rows = await db.select().from(tables.chapterProgress)
+    .where(and(eq(tables.chapterProgress.userId, userId), eq(tables.chapterProgress.chapterId, chapterId)))
+    .limit(1);
+  if (rows.length === 0) return false;
+  await db.delete(tables.chapterProgress)
+    .where(and(eq(tables.chapterProgress.userId, userId), eq(tables.chapterProgress.chapterId, chapterId)));
+  return true;
+}
+
+export function getLevel(): { level: number; totalXp: number; source: string } {
+  return { level: 1, totalXp: 0, source: "placeholder" };
+}
+
+export async function getSettings(db: AppDatabase, userId: string): Promise<ReaderSettingsDto> {
+  const rows = await db.select().from(tables.readerPreferences)
+    .where(eq(tables.readerPreferences.userId, userId)).limit(1);
+  if (rows.length === 0) return { mode: "vertical", fit: true, bg: "light", speed: 3 };
+  return { mode: rows[0].mode as ReaderSettingsDto["mode"], fit: rows[0].fit, bg: rows[0].bg as ReaderSettingsDto["bg"], speed: rows[0].speed };
+}
+
+export async function putSettings(
+  db: AppDatabase,
+  userId: string,
+  input: ReaderSettingsDto,
+  now: number,
+): Promise<ReaderSettingsDto> {
+  await db.insert(tables.readerPreferences).values({ ...input, userId, updatedAt: date(now) })
+    .onConflictDoUpdate({
+      target: tables.readerPreferences.userId,
+      set: { ...input, updatedAt: date(now) },
+    });
+  return input;
+}
+
+/// Idempotent guest merge. Uses one transaction and atomic conflict updates so
+/// duplicated or concurrent imports cannot create duplicate rows or lower the
+/// server's observed maximum.
+export async function importGuest(
+  db: AppDatabase,
+  userId: string,
+  payload: {
+    library: ImportLibraryItem[];
+    history: (ImportHistoryItem & { chapterId: string })[];
+    settings: ReaderSettingsDto | null;
+    skipped: number;
+  },
+  now: number,
+): Promise<ImportSummary> {
+  const summary: ImportSummary = {
+    libraryInserted: 0,
+    libraryUpdated: 0,
+    progressInserted: 0,
+    progressUpdated: 0,
+    skipped: payload.skipped,
+    settingsApplied: false,
+  };
+  await db.transaction(async (tx) => {
+    for (const item of payload.library) {
+      const existing = await tx.select().from(tables.libraryEntries)
+        .where(and(eq(tables.libraryEntries.userId, userId), eq(tables.libraryEntries.mangaId, item.mangaId)))
+        .limit(1);
+      const localNewer = !existing[0] || mergeLibrary(
+        {
+          mangaId: existing[0].mangaId,
+          title: existing[0].title,
+          coverFile: existing[0].coverFile,
+          lang: existing[0].lang,
+          status: existing[0].status,
+          followedAt: existing[0].followedAt,
+          lastChapterId: existing[0].lastChapterId,
+          lastReadPublish: existing[0].lastReadPublish,
+        },
+        item,
+      ).changed;
+      if (!existing[0]) summary.libraryInserted += 1;
+      else if (localNewer) summary.libraryUpdated += 1;
+      else { summary.skipped += 1; continue; }
+
+      await tx.insert(tables.libraryEntries).values({
+        userId,
+        mangaId: item.mangaId,
+        title: item.title,
+        coverFile: item.coverFile,
+        lang: item.lang,
+        status: item.status,
+        followedAt: item.followedAt,
+        lastReadPublish: 0,
+        revision: 1,
+        updatedAt: date(now),
+      }).onConflictDoUpdate({
+        target: [tables.libraryEntries.userId, tables.libraryEntries.mangaId],
+        set: {
+          title: sql`CASE WHEN ${excluded("followed_at")} > ${tables.libraryEntries.followedAt} THEN ${excluded("title")} ELSE ${tables.libraryEntries.title} END`,
+          coverFile: sql`CASE WHEN ${excluded("followed_at")} > ${tables.libraryEntries.followedAt} THEN ${excluded("cover_file")} ELSE ${tables.libraryEntries.coverFile} END`,
+          lang: sql`CASE WHEN ${excluded("followed_at")} > ${tables.libraryEntries.followedAt} THEN ${excluded("lang")} ELSE ${tables.libraryEntries.lang} END`,
+          status: sql`CASE WHEN ${tables.libraryEntries.status} = 'completed' OR ${excluded("followed_at")} <= ${tables.libraryEntries.followedAt} THEN ${tables.libraryEntries.status} ELSE ${excluded("status")} END`,
+          followedAt: sql`greatest(${tables.libraryEntries.followedAt}, ${excluded("followed_at")})`,
+          revision: sql`${tables.libraryEntries.revision} + CASE WHEN ${excluded("followed_at")} > ${tables.libraryEntries.followedAt} THEN 1 ELSE 0 END`,
+          updatedAt: date(now),
+        },
+      });
+    }
+
+    for (const item of payload.history) {
+      const existing = await tx.select().from(tables.chapterProgress).where(and(
+        eq(tables.chapterProgress.userId, userId),
+        eq(tables.chapterProgress.mangaId, item.mangaId),
+        eq(tables.chapterProgress.chapterId, item.chapterId),
+        eq(tables.chapterProgress.language, item.lang),
+      )).limit(1);
+      if (!existing[0]) summary.progressInserted += 1;
+      else {
+        const current = {
+          mangaId: existing[0].mangaId,
+          chapterId: existing[0].chapterId,
+          lang: existing[0].language,
+          page: existing[0].page,
+          maxPage: existing[0].maxPage,
+          total: existing[0].total,
+          chapter: existing[0].chapter,
+          title: existing[0].title,
+          lastReadAt: existing[0].lastReadAt,
+        };
+        if (mergeProgress(current, item).changed) summary.progressUpdated += 1;
+        else { summary.skipped += 1; continue; }
+      }
+      await tx.insert(tables.chapterProgress).values({
+        userId,
+        mangaId: item.mangaId,
+        chapterId: item.chapterId,
+        language: item.lang,
+        chapter: item.chapter,
+        title: item.title,
+        coverFile: item.coverFile ?? null,
+        page: item.page,
+        maxPage: item.page,
+        total: item.total,
+        lastReadAt: item.ts,
+        revision: 1,
+        updatedAt: date(now),
+      }).onConflictDoUpdate({
+        target: [
+          tables.chapterProgress.userId,
+          tables.chapterProgress.mangaId,
+          tables.chapterProgress.chapterId,
+          tables.chapterProgress.language,
+        ],
+        set: {
+          page: sql`CASE WHEN ${excluded("last_read_at")} > ${tables.chapterProgress.lastReadAt} THEN ${excluded("page")} ELSE ${tables.chapterProgress.page} END`,
+          maxPage: sql`CASE WHEN ${excluded("last_read_at")} > ${tables.chapterProgress.lastReadAt} THEN greatest(${tables.chapterProgress.maxPage}, ${excluded("page")}) ELSE ${tables.chapterProgress.maxPage} END`,
+          total: sql`CASE WHEN ${excluded("last_read_at")} > ${tables.chapterProgress.lastReadAt} THEN ${excluded("total")} ELSE ${tables.chapterProgress.total} END`,
+          chapter: sql`CASE WHEN ${excluded("last_read_at")} > ${tables.chapterProgress.lastReadAt} THEN ${excluded("chapter")} ELSE ${tables.chapterProgress.chapter} END`,
+          title: sql`CASE WHEN ${excluded("last_read_at")} > ${tables.chapterProgress.lastReadAt} THEN ${excluded("title")} ELSE ${tables.chapterProgress.title} END`,
+          lastReadAt: sql`greatest(${tables.chapterProgress.lastReadAt}, ${excluded("last_read_at")})`,
+          revision: sql`${tables.chapterProgress.revision} + CASE WHEN ${excluded("last_read_at")} > ${tables.chapterProgress.lastReadAt} THEN 1 ELSE 0 END`,
+          updatedAt: date(now),
+        },
+      });
+    }
+
+    if (payload.settings) {
+      await tx.insert(tables.readerPreferences).values({ ...payload.settings, userId, updatedAt: date(now) })
+        .onConflictDoUpdate({
+          target: tables.readerPreferences.userId,
+          set: { ...payload.settings, updatedAt: date(now) },
+        });
+      summary.settingsApplied = true;
+    }
+  });
+  return summary;
+}
diff --git a/web/lib/merge.ts b/web/lib/merge.ts
new file mode 100644
index 0000000..4588892
--- /dev/null
+++ b/web/lib/merge.ts
@@ -0,0 +1,102 @@
+// Pure merge rules shared by the service and its tests. Local import data is
+// advisory: newer server state always wins, max observed page never regresses,
+// and imports never create XP, completions or roles.
+
+export type LibraryState = {
+  mangaId: string;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  status: string;
+  followedAt: number;
+  lastChapterId: string | null;
+  lastReadPublish: number;
+};
+
+export type LibraryIncoming = {
+  mangaId: string;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  status: string;
+  followedAt: number;
+};
+
+export function mergeLibrary(
+  existing: LibraryState,
+  incoming: LibraryIncoming,
+): { changed: boolean; value: LibraryState } {
+  if (incoming.followedAt <= existing.followedAt) return { changed: false, value: existing };
+  return {
+    changed: true,
+    value: {
+      ...existing,
+      title: incoming.title,
+      coverFile: incoming.coverFile,
+      lang: incoming.lang,
+      // A completed server row is never downgraded by a guest import.
+      status: existing.status === "completed" ? existing.status : incoming.status,
+      followedAt: incoming.followedAt,
+      lastChapterId: existing.lastChapterId,
+      lastReadPublish: existing.lastReadPublish,
+    },
+  };
+}
+
+export type ProgressState = {
+  mangaId: string;
+  chapterId: string;
+  lang: string;
+  page: number;
+  maxPage: number;
+  total: number;
+  chapter: string | null;
+  title: string | null;
+  lastReadAt: number;
+};
+
+export type ProgressIncoming = {
+  mangaId: string;
+  chapterId: string;
+  lang: string;
+  page: number;
+  total: number;
+  chapter: string | null;
+  title: string | null;
+  ts: number;
+};
+
+export function mergeProgress(
+  existing: ProgressState | null,
+  incoming: ProgressIncoming,
+): { changed: boolean; value: ProgressState } {
+  if (!existing) {
+    return {
+      changed: true,
+      value: {
+        mangaId: incoming.mangaId,
+        chapterId: incoming.chapterId,
+        lang: incoming.lang,
+        page: incoming.page,
+        maxPage: incoming.page,
+        total: incoming.total,
+        chapter: incoming.chapter,
+        title: incoming.title,
+        lastReadAt: incoming.ts,
+      },
+    };
+  }
+  if (incoming.ts <= existing.lastReadAt) return { changed: false, value: existing };
+  return {
+    changed: true,
+    value: {
+      ...existing,
+      page: incoming.page,
+      maxPage: Math.max(existing.maxPage, incoming.page),
+      total: incoming.total,
+      chapter: incoming.chapter,
+      title: incoming.title,
+      lastReadAt: incoming.ts,
+    },
+  };
+}
diff --git a/web/lib/validators.ts b/web/lib/validators.ts
new file mode 100644
index 0000000..8b2e765
--- /dev/null
+++ b/web/lib/validators.ts
@@ -0,0 +1,374 @@
+// Browser-safe input boundary. Nothing here trusts client-supplied ids, roles,
+// XP, levels or timestamps; callers derive identity from the managed session.
+
+export type ReaderSettingsDto = {
+  mode: "vertical" | "horizontal";
+  fit: boolean;
+  bg: "light" | "sepia" | "dark";
+  speed: number;
+};
+
+export const DEFAULT_READER_SETTINGS: ReaderSettingsDto = {
+  mode: "vertical",
+  fit: true,
+  bg: "light",
+  speed: 3,
+};
+
+export const LIBRARY_STATUSES = ["reading", "planned", "completed", "paused", "dropped"] as const;
+export type LibraryStatus = (typeof LIBRARY_STATUSES)[number];
+
+export class ValidationError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, code: string, message: string) {
+    super(message);
+    this.name = "ValidationError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+const MAX_ID = 200;
+const MAX_TEXT = 300;
+const MAX_IMPORT_ITEMS = 200;
+const MAX_IMPORT_HISTORY = 100;
+const MAX_JSON_BYTES = 24 * 1024;
+const MAX_CLIENT_AGE_MS = 365 * 24 * 60 * 60 * 1000;
+const MAX_CLIENT_SKEW_MS = 5 * 60 * 1000;
+
+function assertAllowedKeys(value: Record<string, unknown>, allowed: readonly string[]): void {
+  const unknown = Object.keys(value).filter((key) => !allowed.includes(key));
+  if (unknown.length > 0) {
+    throw new ValidationError(400, "INVALID_INPUT", `Unexpected field: ${unknown[0]}`);
+  }
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function plainText(value: unknown, max = MAX_TEXT): string | null {
+  if (value === null || value === undefined) return null;
+  if (typeof value !== "string") throw new ValidationError(400, "INVALID_INPUT", "Expected text.");
+  const trimmed = value.trim();
+  if (trimmed.length > max || /[\u0000-\u001f\u007f]/.test(trimmed)) {
+    throw new ValidationError(400, "INVALID_INPUT", "Text is too long or contains control characters.");
+  }
+  return trimmed;
+}
+
+function requiredText(value: unknown, field: string, max = MAX_ID): string {
+  const parsed = plainText(value, max);
+  if (!parsed) throw new ValidationError(400, "INVALID_INPUT", `${field} is required.`);
+  return parsed;
+}
+
+function optionalId(value: unknown): string | null {
+  if (value === null || value === undefined || value === "") return null;
+  const parsed = plainText(value, MAX_ID);
+  if (!parsed || /[/?#]/.test(parsed)) return null;
+  return parsed;
+}
+
+function integerIn(value: unknown, min: number, max: number, field: string): number {
+  if (typeof value !== "number" || !Number.isInteger(value) || value < min || value > max) {
+    throw new ValidationError(400, "INVALID_INPUT", `${field} is out of range.`);
+  }
+  return value;
+}
+
+function language(value: unknown): string {
+  if (value === undefined || value === null || value === "") return "vi";
+  const parsed = plainText(value, 20) ?? "vi";
+  if (!/^[A-Za-z][A-Za-z-]{1,19}$/.test(parsed)) {
+    throw new ValidationError(400, "INVALID_INPUT", "Invalid language.");
+  }
+  return parsed;
+}
+
+/// Same-origin mutation guard. `Origin` must match the request's own host and
+/// scheme, including forwarded headers in a platform deployment.
+export function requireOrigin(request: Request): void {
+  if (request.method === "GET" || request.method === "HEAD" || request.method === "OPTIONS") return;
+  const origin = request.headers.get("origin");
+  if (!origin) throw new ValidationError(403, "ORIGIN_REJECTED", "Origin header is required.");
+  const url = new URL(request.url);
+  const forwardedHost = request.headers.get("x-forwarded-host")?.split(",")[0]?.trim();
+  const forwardedProto = request.headers.get("x-forwarded-proto")?.split(",")[0]?.trim();
+  const host = forwardedHost || url.host;
+  const protocol = forwardedProto || url.protocol.replace(":", "");
+  if (origin !== `${protocol}://${host}`) {
+    throw new ValidationError(403, "ORIGIN_REJECTED", "Cross-origin mutation rejected.");
+  }
+}
+
+export async function readJson(request: Request, maxBytes = MAX_JSON_BYTES): Promise<Record<string, unknown>> {
+  const contentType = request.headers.get("content-type") ?? "";
+  if (!/^application\/json\b/i.test(contentType)) {
+    throw new ValidationError(415, "UNSUPPORTED_MEDIA_TYPE", "Expected application/json.");
+  }
+  const declared = Number(request.headers.get("content-length") ?? "0");
+  if (Number.isFinite(declared) && declared > maxBytes) {
+    throw new ValidationError(413, "PAYLOAD_TOO_LARGE", "Request body is too large.");
+  }
+  const text = await request.text();
+  if (Buffer.byteLength(text, "utf8") > maxBytes) {
+    throw new ValidationError(413, "PAYLOAD_TOO_LARGE", "Request body is too large.");
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    throw new ValidationError(400, "INVALID_JSON", "Request body is not valid JSON.");
+  }
+  if (!isObject(parsed)) throw new ValidationError(400, "INVALID_INPUT", "Expected a JSON object.");
+  return parsed;
+}
+
+/// Client timestamps may annotate local history only. Reject nan/infinity,
+/// ancient values and implausible future dates before they touch the database.
+export function boundedClientTime(value: unknown, nowMs = Date.now()): number | null {
+  if (typeof value !== "number" || !Number.isFinite(value) || !Number.isInteger(value)) return null;
+  if (value < nowMs - MAX_CLIENT_AGE_MS || value > nowMs + MAX_CLIENT_SKEW_MS) return null;
+  return value;
+}
+
+export function parseResourceId(value: unknown, field = "id"): string {
+  if (typeof value !== "string" || !value.trim()) {
+    throw new ValidationError(400, "INVALID_INPUT", `${field} is required.`);
+  }
+  return requiredText(value, field, MAX_ID);
+}
+
+export function normalizeUsername(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const normalized = value.trim().toLowerCase();
+  return /^[a-z0-9._]{3,24}$/.test(normalized) ? normalized : null;
+}
+
+export function parseProfilePatch(body: Record<string, unknown>): {
+  username?: string | null;
+  displayName?: string | null;
+  avatarUrl?: string | null;
+} {
+  assertAllowedKeys(body, ["username", "displayName", "avatarUrl"]);
+  const patch: { username?: string | null; displayName?: string | null; avatarUrl?: string | null } = {};
+  if (Object.hasOwn(body, "username")) {
+    if (body.username === null || body.username === "") patch.username = null;
+    else {
+      const username = normalizeUsername(body.username);
+      if (!username) throw new ValidationError(400, "INVALID_INPUT", "Username must be 3-24 letters, digits, dots or underscores.");
+      patch.username = username;
+    }
+  }
+  if (Object.hasOwn(body, "displayName")) {
+    const displayName = plainText(body.displayName, 60);
+    if (displayName === null && body.displayName !== null) {
+      throw new ValidationError(400, "INVALID_INPUT", "Display name must be 1-60 characters.");
+    }
+    patch.displayName = displayName || null;
+  }
+  if (Object.hasOwn(body, "avatarUrl")) {
+    const avatarUrl = plainText(body.avatarUrl, 512);
+    if (avatarUrl !== null) {
+      let parsed: URL;
+      try {
+        parsed = new URL(avatarUrl);
+      } catch {
+        throw new ValidationError(400, "INVALID_INPUT", "Avatar URL is invalid.");
+      }
+      if (parsed.protocol !== "https:" || !parsed.hostname) {
+        throw new ValidationError(400, "INVALID_INPUT", "Avatar URL must be https.");
+      }
+    }
+    patch.avatarUrl = avatarUrl || null;
+  }
+  return patch;
+}
+
+export type LibraryInput = {
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  status: LibraryStatus;
+};
+
+export function parseLibraryInput(body: Record<string, unknown>): LibraryInput {
+  assertAllowedKeys(body, ["title", "coverFile", "lang", "status"]);
+  const title = requiredText(body.title, "title", 200);
+  const coverFile = optionalId(body.coverFile);
+  const lang = language(body.lang);
+  const status = body.status === undefined ? "reading" : plainText(body.status, 20);
+  if (!status || !LIBRARY_STATUSES.includes(status as LibraryStatus)) {
+    throw new ValidationError(400, "INVALID_INPUT", "Unknown library status.");
+  }
+  return { title, coverFile, lang, status: status as LibraryStatus };
+}
+
+export type ProgressInput = {
+  mangaId: string;
+  lang: string;
+  page: number;
+  total: number;
+  chapter: string | null;
+  title: string | null;
+  coverFile: string | null;
+};
+
+export function parseProgressInput(body: Record<string, unknown>): ProgressInput {
+  assertAllowedKeys(body, ["mangaId", "lang", "page", "total", "chapter", "title", "coverFile"]);
+  const mangaId = parseResourceId(body.mangaId, "mangaId");
+  const lang = language(body.lang);
+  const total = integerIn(body.total, 1, 10_000, "total");
+  const page = integerIn(body.page, 1, 10_000, "page");
+  if (page > total) throw new ValidationError(400, "INVALID_INPUT", "page cannot exceed total.");
+  return {
+    mangaId,
+    lang,
+    page,
+    total,
+    chapter: optionalId(body.chapter),
+    title: plainText(body.title, 200),
+    coverFile: optionalId(body.coverFile),
+  };
+}
+
+export function parseSettingsInput(body: Record<string, unknown>): ReaderSettingsDto {
+  assertAllowedKeys(body, ["mode", "fit", "bg", "speed"]);
+  const mode = body.mode === undefined ? DEFAULT_READER_SETTINGS.mode : body.mode;
+  const bg = body.bg === undefined ? DEFAULT_READER_SETTINGS.bg : body.bg;
+  if (mode !== "vertical" && mode !== "horizontal") {
+    throw new ValidationError(400, "INVALID_INPUT", "Unknown reader mode.");
+  }
+  if (bg !== "light" && bg !== "sepia" && bg !== "dark") {
+    throw new ValidationError(400, "INVALID_INPUT", "Unknown reader background.");
+  }
+  if (body.fit !== undefined && typeof body.fit !== "boolean") {
+    throw new ValidationError(400, "INVALID_INPUT", "fit must be a boolean.");
+  }
+  return {
+    mode,
+    fit: body.fit === undefined ? DEFAULT_READER_SETTINGS.fit : body.fit,
+    bg,
+    speed: body.speed === undefined ? DEFAULT_READER_SETTINGS.speed : integerIn(body.speed, 1, 5, "speed"),
+  };
+}
+
+export type ImportLibraryItem = LibraryInput & { mangaId: string; followedAt: number };
+export type ImportHistoryItem = {
+  mangaId: string;
+  chapterId: string;
+  lang: string;
+  page: number;
+  total: number;
+  chapter: string | null;
+  title: string | null;
+  coverFile: string | null;
+  ts: number;
+};
+
+function importLibraryItem(value: unknown, nowMs: number): ImportLibraryItem | null {
+  if (!isObject(value)) return null;
+  const followedAt = boundedClientTime(value.followedAt, nowMs);
+  let mangaId: string;
+  try {
+    mangaId = parseResourceId(
+      typeof value.mangaId === "string" ? value.mangaId : undefined,
+      "mangaId",
+    );
+  } catch {
+    return null;
+  }
+  if (followedAt === null) return null;
+  try {
+    const input = parseLibraryInput({
+      title: value.title ?? mangaId,
+      coverFile: value.coverFile,
+      lang: value.lang,
+      status: value.status ?? "reading",
+    });
+    return { ...input, mangaId, followedAt };
+  } catch {
+    return null;
+  }
+}
+
+function importHistoryItem(value: unknown, nowMs: number): ImportHistoryItem | null {
+  if (!isObject(value)) return null;
+  const ts = boundedClientTime(value.ts, nowMs);
+  if (ts === null) return null;
+  try {
+    const input = parseProgressInput({
+      mangaId: value.mangaId,
+      lang: value.lang,
+      page: value.page ?? 1,
+      total: value.total ?? value.page ?? 1,
+      chapter: value.chapter,
+      title: value.title,
+      coverFile: value.coverFile,
+    });
+    return { ...input, chapterId: "", ts } as ImportHistoryItem;
+  } catch {
+    return null;
+  }
+}
+
+export function parseImportPayload(body: Record<string, unknown>, nowMs = Date.now()): {
+  library: ImportLibraryItem[];
+  history: (ImportHistoryItem & { chapterId: string })[];
+  settings: ReaderSettingsDto | null;
+  skipped: number;
+  invalid: number;
+} {
+  assertAllowedKeys(body, ["library", "history", "settings"]);
+  let skipped = 0;
+  const arrays: Record<string, unknown[]> = {};
+  for (const field of ["library", "history"] as const) {
+    const value = body[field];
+    if (value === undefined) arrays[field] = [];
+    else if (!Array.isArray(value)) {
+      throw new ValidationError(400, "INVALID_INPUT", `${field} must be an array.`);
+    } else arrays[field] = value.slice(0, field === "library" ? MAX_IMPORT_ITEMS : MAX_IMPORT_HISTORY);
+  }
+  const library = arrays.library
+    .map((item) => importLibraryItem(item, nowMs))
+    .filter((item): item is ImportLibraryItem => {
+      if (!item) skipped += 1;
+      return item !== null;
+    });
+
+  // History entries need a chapter id, which is a path parameter in the
+  // normal progress API but part of the local payload during an import.
+  const history = arrays.history.flatMap((raw) => {
+    if (!isObject(raw) || typeof raw.chapterId !== "string" || !raw.chapterId.trim()) {
+      skipped += 1;
+      return [];
+    }
+    const parsed = importHistoryItem(raw, nowMs);
+    if (!parsed) {
+      skipped += 1;
+      return [];
+    }
+    return [{ ...parsed, chapterId: raw.chapterId.trim().slice(0, MAX_ID) }];
+  });
+
+  let settings: ReaderSettingsDto | null = null;
+  if (body.settings !== undefined) {
+    if (!isObject(body.settings)) throw new ValidationError(400, "INVALID_INPUT", "settings must be an object.");
+    settings = parseSettingsInput(body.settings);
+  }
+  return { library, history, settings, skipped, invalid: skipped };
+}
+
+/// Explicit operator configuration only. A client never sends a role, and an
+/// unverified email can never bootstrap one.
+export function roleFromVerifiedAllowlist(
+  identity: { email: string | null; emailVerified: boolean },
+  allowlist: readonly string[],
+): "admin" | null {
+  if (!identity.emailVerified || !identity.email || allowlist.length === 0) return null;
+  const allowed = new Set(allowlist.map((email) => email.trim().toLowerCase()).filter(Boolean));
+  return allowed.has(identity.email.trim().toLowerCase()) ? "admin" : null;
+}
