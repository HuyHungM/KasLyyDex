+/* Account flows: compact, text-first forms that survive the dark/light theme. */
+.account-grid { display: grid; gap: 18px; max-width: 760px; }
+.account-card { padding: 22px; width: 100%; }
+.account-card h2 { font-size: 1.25rem; margin-bottom: 10px; }
+.account-form { display: grid; gap: 12px; margin: 16px 0; }
+.account-form label { display: grid; gap: 6px; font-size: .9rem; color: var(--muted); }
+.account-form input, .account-form select {
+  width: 100%; border: 1px solid var(--line); border-radius: 9px;
+  background: var(--bg); color: var(--text); padding: 10px 12px; font: inherit;
