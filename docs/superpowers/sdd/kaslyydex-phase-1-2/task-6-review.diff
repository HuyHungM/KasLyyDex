--- /dev/null
+++ b/web/components/account/HistoryView.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import Link from "next/link";
+import { useSyncExternalStore } from "react";
+import { coverImageUrl, type ProgressEntryDto } from "@/lib/contracts";
+import { chapterLabel } from "@/lib/format";
+import { getHistory, subscribe, type GuestHistory } from "@/lib/guest";
+import { useAccountSession, useRemoteResource } from "@/lib/account/client";
+
+const NO_HISTORY: GuestHistory[] = [];
+
+function LocalHistory() {
+  const entries = useSyncExternalStore(subscribe, getHistory, () => NO_HISTORY);
+  if (entries.length === 0) return <div className="surface empty"><h2>Chưa có lịch sử đọc</h2><p>Mở một chương để bắt đầu.</p></div>;
+  return (
+    <div className="history-list">
+      {entries.map((entry) => (
+        <Link key={`${entry.mangaId}:${entry.chapterId}`} href={`/read/${encodeURIComponent(entry.chapterId)}?manga=${encodeURIComponent(entry.mangaId)}&lang=${encodeURIComponent(entry.lang)}`} className="history-row">
+          <span><strong>{entry.mangaTitle}</strong><small>{chapterLabel(entry.chapter)} · thiết bị này</small></span>
+          {entry.total ? <progress max={entry.total} value={entry.page ?? 1} /> : null}
+        </Link>
+      ))}
+    </div>
+  );
+}
+
+function SyncedHistory() {
+  const remote = useRemoteResource<{ items: ProgressEntryDto[] }>("/api/v1/me/progress");
+  if (remote.loading && !remote.data) return <div className="surface account-card">Đang tải lịch sử…</div>;
+  if (remote.error || !remote.data) {
+    return <div className="surface account-card" role="alert"><p>{remote.error ?? "Không tải được lịch sử."}</p><button type="button" className="btn" onClick={remote.reload}>Thử lại</button></div>;
+  }
+  if (remote.data.items.length === 0) return <div className="surface empty"><h2>Chưa có lịch sử đọc</h2><p>Tiến độ sẽ được đồng bộ khi bạn mở truyện.</p></div>;
+  return (
+    <div className="history-list">
+      {remote.data.items.map((item) => (
+        <Link key={`${item.mangaId}:${item.chapterId}:${item.lang}`} href={`/read/${encodeURIComponent(item.chapterId)}?manga=${encodeURIComponent(item.mangaId)}&lang=${encodeURIComponent(item.lang)}`} className="history-row">
+          <span>
+            <strong>{item.title ?? item.mangaId}</strong>
+            <small>{chapterLabel(item.chapter)} · đã đọc tới trang {item.maxPage}/{item.total}</small>
+          </span>
+          {item.coverFile ? <img src={coverImageUrl({ id: item.mangaId, cover_file: item.coverFile }, 96) ?? ""} alt="" loading="lazy" /> : null}
+          <progress max={item.total} value={item.page} />
+        </Link>
+      ))}
+    </div>
+  );
+}
+
+export default function HistoryView() {
+  const { session } = useAccountSession();
+  if (session.status === "authenticated") return <SyncedHistory />;
+  return <LocalHistory />;
+}
diff --git a/web/components/account/ProfileForm.tsx b/web/components/account/ProfileForm.tsx
new file mode 100644
index 0000000..efc796a
--- /dev/null
+++ b/web/components/account/ProfileForm.tsx
@@ -0,0 +1,76 @@
+"use client";
+
+import { useState } from "react";
+import type { AccountProfileDto } from "@/lib/contracts";
+import { accountMutate, useAccountSession, useRemoteResource } from "@/lib/account/client";
+
+function ProfileFields({ profile, onSaved }: { profile: AccountProfileDto; onSaved: () => void }) {
+  const [username, setUsername] = useState(profile.username ?? "");
+  const [displayName, setDisplayName] = useState(profile.displayName ?? "");
+  const [avatarUrl, setAvatarUrl] = useState(profile.avatarUrl ?? "");
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<string | null>(null);
+
+  async function submit(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setBusy(true);
+    setMessage(null);
+    try {
+      await accountMutate("/api/v1/me", "PATCH", {
+        username: username.trim() || null,
+        displayName: displayName.trim() || null,
+        avatarUrl: avatarUrl.trim() || null,
+      });
+      setMessage("Đã lưu hồ sơ.");
+      onSaved();
+    } catch (error) {
+      setMessage(error instanceof Error ? error.message : "Không lưu được hồ sơ.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form className="account-form" onSubmit={(event) => void submit(event)}>
+      <label>Tên người dùng
+        <input value={username} onChange={(event) => setUsername(event.target.value)} maxLength={24} placeholder="3–24 ký tự a-z, 0-9, ., _" />
+      </label>
+      <label>Tên hiển thị
+        <input value={displayName} onChange={(event) => setDisplayName(event.target.value)} maxLength={60} />
+      </label>
+      <label>Ảnh đại diện (https)
+        <input type="url" value={avatarUrl} onChange={(event) => setAvatarUrl(event.target.value)} maxLength={512} placeholder="https://…" />
+      </label>
+      <button type="submit" className="btn btn-primary" disabled={busy}>{busy ? "Đang lưu…" : "Lưu hồ sơ"}</button>
+      {message ? <p className={message.startsWith("Đã") ? "account-hint" : "account-error"} role="status">{message}</p> : null}
+    </form>
+  );
+}
+
+export default function ProfileForm() {
+  const { session } = useAccountSession();
+  const remote = useRemoteResource<{ profile: AccountProfileDto }>(
+    session.status === "authenticated" ? "/api/v1/me" : null,
+  );
+
+  if (session.status !== "authenticated") return null;
+  if (remote.loading && !remote.data) return <div className="surface account-card">Đang tải hồ sơ…</div>;
+  if (remote.error || !remote.data) {
+    return (
+      <div className="surface account-card" role="alert">
+        <p>{remote.error ?? "Không tải được hồ sơ."}</p>
+        <button type="button" className="btn" onClick={remote.reload}>Thử lại</button>
+      </div>
+    );
+  }
+  const { profile } = remote.data;
+  return (
+    <div className="surface account-card">
+      <h2>Hồ sơ</h2>
+      <p className="account-hint">
+        Cấp {profile.level} · {profile.totalXp} XP — điểm kinh nghiệm chỉ là giá trị giữ chỗ cho đến khi ghi nhận hoàn thành chương.
+      </p>
+      <ProfileFields key={`${profile.id}:${profile.username ?? ""}:${profile.displayName ?? ""}`} profile={profile} onSaved={remote.reload} />
+    </div>
+  );
+}
