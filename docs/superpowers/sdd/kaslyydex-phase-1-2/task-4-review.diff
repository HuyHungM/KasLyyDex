diff --git a/web/scripts/auth.test.mjs b/web/scripts/auth.test.mjs
new file mode 100644
index 0000000..3293fd4
--- /dev/null
+++ b/web/scripts/auth.test.mjs
@@ -0,0 +1,176 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { exportJWK, generateKeyPair, SignJWT } from "jose";
+import { startHttpServer, startNext, stop } from "./test-helpers.mjs";
+
+// These tests exercise the real Neon SDK adapter against a local fixture upstream.
+// They are fixture-only: no Neon project, Google OAuth tenant, or live session is used.
+const { AuthConfigurationError, getAuth, readAuthConfig, verifyNeonJwt } = await import(
+  "../lib/auth/server.ts"
+);
+
+let unconfigured;
+let configuredFixture;
+let configuredNext;
+
+before(async () => {
+  unconfigured = await startNext();
+  configuredFixture = await startHttpServer((_req, res) => {
+    res.writeHead(200, {
+      "content-type": "application/json",
+      "set-cookie": "__Secure-neon-auth.session_token=fixture; Path=/; HttpOnly; SameSite=Lax",
+    });
+    res.end(JSON.stringify({ ok: true }));
+  });
+  configuredNext = await startNext({
+    NEON_AUTH_BASE_URL: `${configuredFixture.baseUrl}/neondb/auth`,
+    NEON_AUTH_COOKIE_SECRET: "fixture-secret-with-at-least-32-characters",
+  });
+});
+
+after(async () => {
+  await stop(configuredNext?.child);
+  await stop(unconfigured?.child);
+  await configuredFixture?.close();
+});
+
+test("auth config validates explicit server env and never invents credentials", () => {
+  assert.throws(
+    () => readAuthConfig({}),
+    (error) => error instanceof AuthConfigurationError
+      && error.code === "AUTH_NOT_CONFIGURED"
+      && error.missing.includes("NEON_AUTH_BASE_URL")
+      && error.missing.includes("NEON_AUTH_COOKIE_SECRET"),
+  );
+  assert.throws(
+    () => readAuthConfig({ NEON_AUTH_BASE_URL: "not a url", NEON_AUTH_COOKIE_SECRET: "x".repeat(40) }),
+    (error) => error.code === "AUTH_CONFIG_INVALID",
+  );
+  assert.throws(
+    () => readAuthConfig({ NEON_AUTH_BASE_URL: "https://auth.example.com", NEON_AUTH_COOKIE_SECRET: "short" }),
+    (error) => error.code === "AUTH_CONFIG_INVALID",
+  );
+  const config = readAuthConfig({
+    NEON_AUTH_BASE_URL: "https://ep-1.neonauth.example.com/neondb/auth",
+    NEON_AUTH_COOKIE_SECRET: "fixture-secret-with-at-least-32-characters",
+  });
+  assert.equal(config.origin, "https://ep-1.neonauth.example.com");
+  assert.equal(config.baseUrl, "https://ep-1.neonauth.example.com/neondb/auth");
+});
+
+test("the real Neon SDK creates a lazy server instance only with valid config", () => {
+  const previous = process.env.NEON_AUTH_BASE_URL;
+  const previousSecret = process.env.NEON_AUTH_COOKIE_SECRET;
+  try {
+    process.env.NEON_AUTH_BASE_URL = "https://ep-1.neonauth.example.com/neondb/auth";
+    process.env.NEON_AUTH_COOKIE_SECRET = "fixture-secret-with-at-least-32-characters";
+    const auth = getAuth();
+    assert.equal(typeof auth.handler, "function");
+    assert.equal(typeof auth.getSession, "function");
+    assert.equal(typeof auth.signIn.email, "function");
+  } finally {
+    if (previous === undefined) delete process.env.NEON_AUTH_BASE_URL;
+    else process.env.NEON_AUTH_BASE_URL = previous;
+    if (previousSecret === undefined) delete process.env.NEON_AUTH_COOKIE_SECRET;
+    else process.env.NEON_AUTH_COOKIE_SECRET = previousSecret;
+  }
+});
+
+test("missing auth config returns structured 503 only on auth routes", async () => {
+  for (const [path, init] of [
+    ["/api/auth/get-session", undefined],
+    ["/api/auth/sign-in/email", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ email: "reader@example.com", password: "secret" }),
+    }],
+  ]) {
+    const res = await fetch(`${unconfigured.baseUrl}${path}`, init);
+    assert.equal(res.status, 503, path);
+    assert.match(res.headers.get("content-type") ?? "", /application\/json/);
+    const body = await res.json();
+    assert.equal(body.error.code, "AUTH_NOT_CONFIGURED", path);
+    assert.equal(body.error.details.service, "auth", path);
+    assert.deepEqual(body.error.details.missing?.split(",").sort(), [
+      "NEON_AUTH_BASE_URL",
+      "NEON_AUTH_COOKIE_SECRET",
+    ]);
+    assert.deepEqual(res.headers.getSetCookie(), [], "must not mint a fake session");
+  }
+
+  const health = await fetch(`${unconfigured.baseUrl}/api/v1/health`);
+  assert.equal(health.status, 200);
+});
+
+test("fixture-only SDK proxy forwards email/password and Google provider requests", async () => {
+  const emailRes = await fetch(`${configuredNext.baseUrl}/api/auth/sign-in/email`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ email: "reader@example.com", password: "fixture-password" }),
+  });
+  assert.equal(emailRes.status, 200);
+
+  const googleRes = await fetch(`${configuredNext.baseUrl}/api/auth/sign-in/social`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ provider: "google", callbackURL: "/api/auth/callback/google" }),
+  });
+  assert.equal(googleRes.status, 200);
+
+  assert.ok(configuredFixture.requests.some((r) => r.url.includes("sign-in/email")));
+  const googleRequest = configuredFixture.requests.find((r) => r.url.includes("sign-in/social"));
+  assert.ok(googleRequest);
+  assert.match(googleRequest.body, /"provider":"google"/);
+});
+
+test("fixture-only SDK proxy rewrites session cookies to Secure and HttpOnly in production", async () => {
+  const res = await fetch(`${configuredNext.baseUrl}/api/auth/get-session`);
+  assert.equal(res.status, 200);
+  const cookies = res.headers.getSetCookie();
+  assert.ok(cookies.length > 0);
+  for (const cookie of cookies) {
+    assert.match(cookie, /__Secure-neon-auth/);
+    assert.match(cookie, /;\s*Secure\b/i, cookie);
+    assert.match(cookie, /;\s*HttpOnly\b/i, cookie);
+    assert.match(cookie, /SameSite=Lax/i, cookie);
+  }
+});
+
+test("fixture-only JWT/JWKS verifier checks EdDSA signature, issuer and audience", async () => {
+  const { publicKey, privateKey } = await generateKeyPair("EdDSA");
+  const jwk = await exportJWK(publicKey);
+  jwk.kid = "fixture-key";
+  jwk.use = "sig";
+  jwk.alg = "EdDSA";
+
+  const fixture = await startHttpServer((_req, res) => {
+    res.writeHead(200, { "content-type": "application/json" });
+    res.end(JSON.stringify({ keys: [jwk] }));
+  });
+  const previousBaseUrl = process.env.NEON_AUTH_BASE_URL;
+  const previousSecret = process.env.NEON_AUTH_COOKIE_SECRET;
+  try {
+    const baseUrl = `${fixture.baseUrl}/neondb/auth`;
+    process.env.NEON_AUTH_BASE_URL = baseUrl;
+    process.env.NEON_AUTH_COOKIE_SECRET = "fixture-secret-with-at-least-32-characters";
+    const origin = new URL(baseUrl).origin;
+    const sign = (issuer) => new SignJWT({ sub: "opaque-user-id" })
+      .setProtectedHeader({ alg: "EdDSA", kid: "fixture-key" })
+      .setIssuedAt()
+      .setExpirationTime("5m")
+      .setIssuer(issuer)
+      .setAudience(origin)
+      .sign(privateKey);
+
+    const valid = await verifyNeonJwt(await sign(origin));
+    assert.equal(valid?.sub, "opaque-user-id");
+    assert.equal(await verifyNeonJwt(await sign("https://wrong-issuer.example.com")), null);
+    assert.ok(fixture.requests.some((r) => r.url.includes(".well-known/jwks.json")));
+  } finally {
+    if (previousBaseUrl === undefined) delete process.env.NEON_AUTH_BASE_URL;
+    else process.env.NEON_AUTH_BASE_URL = previousBaseUrl;
+    if (previousSecret === undefined) delete process.env.NEON_AUTH_COOKIE_SECRET;
+    else process.env.NEON_AUTH_COOKIE_SECRET = previousSecret;
+    await fixture.close();
+  }
+});
diff --git a/web/scripts/content-proxy.test.mjs b/web/scripts/content-proxy.test.mjs
new file mode 100644
index 0000000..67dcc72
--- /dev/null
+++ b/web/scripts/content-proxy.test.mjs
@@ -0,0 +1,143 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { existsSync } from "node:fs";
+import { connect } from "node:net";
+import { join } from "node:path";
+import { after, before, test } from "node:test";
+import { freePort, repoDir, startHttpServer, startNext, stop, webDir } from "./test-helpers.mjs";
+
+// Local topology only. The MangaDex fixture stands in for the remote service;
+// no remote MangaDex request is needed and no credentials are involved.
+const { contentPath, createContentClient } = await import("../lib/contracts.ts");
+
+let mangadexFixture;
+let axum;
+let axumUrl;
+let proxied;
+let unconfigured;
+
+function waitForTcp(port, deadlineMs = 20_000) {
+  return new Promise((resolve, reject) => {
+    const deadline = Date.now() + deadlineMs;
+    const attempt = () => {
+      const socket = connect({ host: "127.0.0.1", port });
+      socket.once("connect", () => { socket.destroy(); resolve(); });
+      socket.once("error", (error) => {
+        socket.destroy();
+        if (Date.now() > deadline) reject(error);
+        else setTimeout(attempt, 100);
+      });
+    };
+    attempt();
+  });
+}
+
+before(async () => {
+  mangadexFixture = await startHttpServer((req, res) => {
+    res.writeHead(200, { "content-type": "application/json" });
+    if (req.url.startsWith("/chapter")) {
+      res.end(JSON.stringify({
+        total: 1,
+        data: [{
+          id: "fixture-chapter-1",
+          attributes: {
+            chapter: "1",
+            pages: 2,
+            externalUrl: null,
+            translatedLanguage: "vi",
+            readableAt: "2026-11-20T00:00:00Z",
+          },
+          relationships: [{ type: "manga", id: "fixture-manga-1" }],
+        }],
+      }));
+      return;
+    }
+    if (req.url.startsWith("/manga?")) {
+      res.end(JSON.stringify({
+        total: 1,
+        data: [{
+          id: "fixture-manga-1",
+          attributes: {
+            title: { vi: "Fixture Manga" },
+            status: "ongoing",
+            description: { vi: "Local fixture" },
+          },
+          relationships: [],
+        }],
+      }));
+      return;
+    }
+    res.end(JSON.stringify({ total: 0, data: [] }));
+  });
+
+  const port = await freePort();
+  axumUrl = `http://127.0.0.1:${port}`;
+  const binary = join(repoDir, "target", "debug", process.platform === "win32" ? "server.exe" : "server");
+  assert.ok(existsSync(binary), `build the Axum server first: cargo build -p server (missing ${binary})`);
+  axum = spawn(binary, [], {
+    cwd: repoDir,
+    env: {
+      ...process.env,
+      PORT: String(port),
+      MANGADEX_API_ORIGIN: mangadexFixture.baseUrl,
+      DIST_DIR: join(webDir, "public"),
+    },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  await waitForTcp(port);
+
+  proxied = await startNext({ RUST_CONTENT_API_ORIGIN: axumUrl });
+  unconfigured = await startNext();
+});
+
+after(async () => {
+  await stop(proxied?.child);
+  await stop(unconfigured?.child);
+  if (axum && axum.exitCode === null) axum.kill("SIGKILL");
+  await mangadexFixture?.close();
+});
+
+test("Axum keeps legacy endpoints and exposes the /api/content namespace", async () => {
+  for (const path of ["/api/latest", "/api/content/latest"]) {
+    const res = await fetch(`${axumUrl}${path}`);
+    assert.equal(res.status, 200, path);
+    const body = await res.json();
+    assert.ok(Array.isArray(body), path);
+    assert.equal(body[0]?.title, "Fixture Manga", path);
+  }
+});
+
+test("Next proxies /api/content/latest through the real local Axum server", async () => {
+  assert.equal(contentPath("latest"), "/api/content/latest");
+  assert.equal(contentPath("manga", "abc"), "/api/content/manga/abc");
+
+  const client = createContentClient(proxied.baseUrl);
+  const latest = await client.latest();
+  assert.ok(Array.isArray(latest));
+  assert.equal(latest[0].title, "Fixture Manga");
+
+  const direct = await fetch(`${proxied.baseUrl}/api/content/latest`);
+  assert.equal(direct.status, 200);
+  assert.match(direct.headers.get("content-type") ?? "", /application\/json/);
+  assert.match(direct.headers.get("cache-control") ?? "", /max-age=60/);
+});
+
+test("Next proxy passes Axum's structured rejection for malformed content IDs", async () => {
+  const res = await fetch(`${proxied.baseUrl}/api/content/manga/not-a-uuid`);
+  assert.equal(res.status, 400);
+  const body = await res.json();
+  assert.equal(body.error.code, "VALIDATION_ERROR");
+  assert.equal(typeof body.error.message, "string");
+});
+
+test("missing content origin returns a structured 503 without breaking public routes", async () => {
+  const res = await fetch(`${unconfigured.baseUrl}/api/content/latest`);
+  assert.equal(res.status, 503);
+  const body = await res.json();
+  assert.equal(body.error.code, "CONTENT_NOT_CONFIGURED");
+  assert.equal(body.error.details.service, "content");
+  assert.equal(body.error.details.missing, "RUST_CONTENT_API_ORIGIN");
+
+  const health = await fetch(`${unconfigured.baseUrl}/api/v1/health`);
+  assert.equal(health.status, 200);
+});
diff --git a/web/scripts/database.test.mjs b/web/scripts/database.test.mjs
new file mode 100644
index 0000000..23ebe7a
--- /dev/null
+++ b/web/scripts/database.test.mjs
@@ -0,0 +1,105 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+import { test } from "node:test";
+import { PGlite } from "@electric-sql/pglite";
+import { getTableName } from "drizzle-orm";
+
+const { readDatabaseConfig } = await import("../lib/db/client.ts");
+const { profiles } = await import("../lib/db/schema.ts");
+
+const migrationUrl = new URL("../drizzle/0000_application.sql", import.meta.url);
+
+async function freshDatabase() {
+  const db = new PGlite();
+  const sql = await readFile(fileURLToPath(migrationUrl), "utf8");
+  await db.exec(sql);
+  return { db, sql };
+}
+
+test("application migration owns only profiles and never touches Neon Auth tables", async () => {
+  const { db, sql } = await freshDatabase();
+  try {
+    assert.doesNotMatch(sql, /neon_auth/i, "Drizzle SQL must not manage Neon-owned identity tables");
+    assert.doesNotMatch(sql, /CREATE\s+SCHEMA/i);
+
+    const tables = await db.query(`
+      SELECT table_schema, table_name
+      FROM information_schema.tables
+      WHERE table_schema NOT IN ('pg_catalog', 'information_schema')
+      ORDER BY table_schema, table_name
+    `);
+    assert.deepEqual(
+      tables.rows.map((row) => `${row.table_schema}.${row.table_name}`),
+      ["public.profiles"],
+      "only the application profiles table may be created",
+    );
+
+    const columns = await db.query(`
+      SELECT column_name, data_type, is_nullable
+      FROM information_schema.columns
+      WHERE table_schema = 'public' AND table_name = 'profiles'
+      ORDER BY ordinal_position
+    `);
+    assert.deepEqual(columns.rows, [
+      { column_name: "user_id", data_type: "text", is_nullable: "NO" },
+      { column_name: "created_at", data_type: "timestamp with time zone", is_nullable: "NO" },
+      { column_name: "updated_at", data_type: "timestamp with time zone", is_nullable: "NO" },
+    ]);
+
+    const pk = await db.query(`
+      SELECT a.attname
+      FROM pg_index i
+      JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = ANY(i.indkey)
+      WHERE i.indrelid = 'public.profiles'::regclass AND i.indisprimary
+    `);
+    assert.deepEqual(pk.rows.map((row) => row.attname), ["user_id"]);
+
+    const authSchemas = await db.query(`
+      SELECT schema_name FROM information_schema.schemata WHERE schema_name = 'neon_auth'
+    `);
+    assert.equal(authSchemas.rows.length, 0, "Neon Auth owns its own schema, not this migration");
+  } finally {
+    await db.close();
+  }
+});
+
+test("profiles accept opaque user ids and enforce uniqueness inside a transaction", async () => {
+  const { db } = await freshDatabase();
+  try {
+    const opaqueId = "google|not-a-uuid|opaque-123";
+    await db.exec(`
+      INSERT INTO profiles (user_id) VALUES ('${opaqueId}');
+    `);
+    const found = await db.query("SELECT user_id FROM profiles WHERE user_id = $1", [opaqueId]);
+    assert.deepEqual(found.rows, [{ user_id: opaqueId }]);
+
+    await assert.rejects(
+      db.exec(`INSERT INTO profiles (user_id) VALUES ('${opaqueId}');`),
+      /duplicate key|unique/i,
+    );
+
+    await assert.rejects(
+      db.transaction(async (tx) => {
+        await tx.query("INSERT INTO profiles (user_id) VALUES ($1)", ["rollback-user"]);
+        throw new Error("force rollback");
+      }),
+      /force rollback/,
+    );
+    const rolledBack = await db.query("SELECT user_id FROM profiles WHERE user_id = $1", ["rollback-user"]);
+    assert.equal(rolledBack.rows.length, 0);
+  } finally {
+    await db.close();
+  }
+});
+
+test("Drizzle schema and database config stay application-only and lazy", () => {
+  assert.equal(getTableName(profiles), "profiles");
+  const keys = Object.keys(profiles);
+  assert.ok(keys.includes("userId"));
+  assert.ok(!keys.some((key) => /auth|session|account/i.test(key)));
+  assert.throws(
+    () => readDatabaseConfig({}),
+    (error) => error.code === "DATABASE_NOT_CONFIGURED" && error.missing.includes("DATABASE_URL"),
+  );
+});
diff --git a/web/scripts/test-helpers.mjs b/web/scripts/test-helpers.mjs
new file mode 100644
index 0000000..60e8cfb
--- /dev/null
+++ b/web/scripts/test-helpers.mjs
@@ -0,0 +1,99 @@
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { createServer as createHttpServer } from "node:http";
+import { createServer } from "node:net";
+import { fileURLToPath } from "node:url";
+
+export const webDir = fileURLToPath(new URL("..", import.meta.url));
+export const repoDir = fileURLToPath(new URL("../..", import.meta.url));
+const nextBin = fileURLToPath(new URL("../node_modules/next/dist/bin/next", import.meta.url));
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const probe = createServer();
+    probe.once("error", reject);
+    probe.listen(0, "127.0.0.1", () => {
+      const { port } = probe.address();
+      probe.close(() => resolve(port));
+    });
+  });
+}
+
+export function envWithoutExternalConfig(overrides = {}) {
+  const env = { ...process.env };
+  for (const key of Object.keys(env)) {
+    if (/DATABASE|POSTGRES|NEON|AUTH|GOOGLE_CLIENT|RUST_CONTENT_API_ORIGIN|MANGADEX_API_ORIGIN/i.test(key)) {
+      delete env[key];
+    }
+  }
+  return { ...env, NODE_ENV: "production", ...overrides };
+}
+
+async function waitForTcp(port, deadlineMs = 30_000) {
+  const deadline = Date.now() + deadlineMs;
+  let lastError;
+  while (Date.now() < deadline) {
+    try {
+      const res = await fetch(`http://127.0.0.1:${port}/favicon.ico`, {
+        signal: AbortSignal.timeout(2_000),
+      });
+      await res.arrayBuffer();
+      return;
+    } catch (error) {
+      lastError = error;
+      await new Promise((resolve) => setTimeout(resolve, 200));
+    }
+  }
+  throw new Error(`server on ${port} did not become ready: ${lastError}`);
+}
+
+export async function startNext(overrides = {}) {
+  const port = await freePort();
+  const baseUrl = `http://127.0.0.1:${port}`;
+  const child = spawn(
+    process.execPath,
+    [nextBin, "start", "-p", String(port), "-H", "127.0.0.1"],
+    { cwd: webDir, env: envWithoutExternalConfig(overrides), stdio: ["ignore", "pipe", "pipe"] },
+  );
+  let output = "";
+  child.stdout.on("data", (chunk) => { output += chunk; });
+  child.stderr.on("data", (chunk) => { output += chunk; });
+  try {
+    await waitForTcp(port);
+  } catch (error) {
+    child.kill("SIGKILL");
+    throw new Error(`${error.message}\n${output}`);
+  }
+  return { child, baseUrl, output: () => output };
+}
+
+export async function stop(child) {
+  if (!child || child.exitCode !== null) return;
+  const exited = once(child, "exit", { signal: AbortSignal.timeout(5_000) }).catch(() => {});
+  child.kill("SIGTERM");
+  await exited;
+  if (child.exitCode === null) child.kill("SIGKILL");
+}
+
+export async function startHttpServer(handler) {
+  const port = await freePort();
+  const requests = [];
+  const server = createHttpServer((req, res) => {
+    const chunks = [];
+    req.on("data", (chunk) => chunks.push(chunk));
+    req.on("end", () => {
+      const body = Buffer.concat(chunks).toString("utf8");
+      requests.push({ method: req.method, url: req.url, body, headers: req.headers });
+      Promise.resolve(handler(req, res, body)).catch((error) => {
+        res.writeHead(500, { "content-type": "application/json" });
+        res.end(JSON.stringify({ error: error.message }));
+      });
+    });
+  });
+  await new Promise((resolve) => server.listen(port, "127.0.0.1", resolve));
+  return {
+    baseUrl: `http://127.0.0.1:${port}`,
+    requests,
+    close: () => new Promise((resolve) => server.close(resolve)),
+  };
+}
