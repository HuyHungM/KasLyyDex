diff --git a/web/lib/auth/server.ts b/web/lib/auth/server.ts
new file mode 100644
index 0000000..0d534be
--- /dev/null
+++ b/web/lib/auth/server.ts
@@ -0,0 +1,101 @@
+import "server-only";
+
+import { createNeonAuth, type NeonAuth } from "@neon/auth/next/server";
+import { createRemoteJWKSet, jwtVerify } from "jose";
+import { errorEnvelope } from "../contracts";
+
+export type AuthConfig = {
+  baseUrl: string;
+  cookieSecret: string;
+  origin: string;
+};
+
+type AuthErrorCode = "AUTH_NOT_CONFIGURED" | "AUTH_CONFIG_INVALID";
+
+export class AuthConfigurationError extends Error {
+  readonly code: AuthErrorCode;
+  readonly missing: string[];
+
+  constructor(code: AuthErrorCode, message: string, missing: string[] = []) {
+    super(message);
+    this.name = "AuthConfigurationError";
+    this.code = code;
+    this.missing = missing;
+  }
+}
+
+export function readAuthConfig(env: NodeJS.ProcessEnv = process.env): AuthConfig {
+  const baseUrl = env.NEON_AUTH_BASE_URL?.trim();
+  const cookieSecret = env.NEON_AUTH_COOKIE_SECRET?.trim();
+  const missing = [
+    ...(!baseUrl ? ["NEON_AUTH_BASE_URL"] : []),
+    ...(!cookieSecret ? ["NEON_AUTH_COOKIE_SECRET"] : []),
+  ];
+  if (missing.length > 0) {
+    throw new AuthConfigurationError(
+      "AUTH_NOT_CONFIGURED",
+      "Neon Managed Auth is not configured.",
+      missing,
+    );
+  }
+
+  let url: URL;
+  try {
+    url = new URL(baseUrl!);
+  } catch {
+    throw new AuthConfigurationError("AUTH_CONFIG_INVALID", "NEON_AUTH_BASE_URL must be a URL.");
+  }
+  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password) {
+    throw new AuthConfigurationError("AUTH_CONFIG_INVALID", "NEON_AUTH_BASE_URL is invalid.");
+  }
+  if (cookieSecret!.length < 32) {
+    throw new AuthConfigurationError(
+      "AUTH_CONFIG_INVALID",
+      "NEON_AUTH_COOKIE_SECRET must be at least 32 characters.",
+    );
+  }
+  return { baseUrl: url.toString().replace(/\/$/, ""), cookieSecret: cookieSecret!, origin: url.origin };
+}
+
+export function authErrorResponse(error: unknown): Response | null {
+  if (!(error instanceof AuthConfigurationError)) return null;
+  const details: Record<string, string> = { service: "auth" };
+  if (error.missing.length > 0) details.missing = error.missing.join(",");
+  return Response.json(errorEnvelope(error.code, error.message, details), { status: 503 });
+}
+
+let auth: NeonAuth | undefined;
+
+// createNeonAuth validates the cookie secret eagerly, so construct it only on
+// the first route that actually needs authentication.
+export function getAuth(): NeonAuth {
+  if (!auth) {
+    const config = readAuthConfig();
+    auth = createNeonAuth({
+      baseUrl: config.baseUrl,
+      cookies: { secret: config.cookieSecret, sameSite: "lax" },
+    });
+  }
+  return auth;
+}
+
+let jwks: ReturnType<typeof createRemoteJWKSet> | undefined;
+let jwksFor = "";
+
+export async function verifyNeonJwt(token: string) {
+  try {
+    const config = readAuthConfig();
+    if (!jwks || jwksFor !== config.baseUrl) {
+      jwks = createRemoteJWKSet(new URL(`${config.baseUrl}/.well-known/jwks.json`));
+      jwksFor = config.baseUrl;
+    }
+    const { payload } = await jwtVerify(token, jwks, {
+      algorithms: ["EdDSA"],
+      issuer: config.origin,
+      audience: config.origin,
+    });
+    return payload;
+  } catch {
+    return null;
+  }
+}
diff --git a/web/lib/contracts.ts b/web/lib/contracts.ts
new file mode 100644
index 0000000..b9db079
--- /dev/null
+++ b/web/lib/contracts.ts
@@ -0,0 +1,125 @@
+// Browser-safe contracts shared by the Next BFF and later native clients.
+
+export type ApiErrorEnvelope = {
+  error: {
+    code: string;
+    message: string;
+    details: Record<string, string>;
+  };
+};
+
+export function errorEnvelope(
+  code: string,
+  message: string,
+  details: Record<string, string> = {},
+): ApiErrorEnvelope {
+  return { error: { code, message, details } };
+}
+
+export function serviceUnavailableResponse(
+  service: "auth" | "content" | "database",
+  missing: string[],
+): Response {
+  return Response.json(
+    errorEnvelope(
+      `${service.toUpperCase()}_NOT_CONFIGURED`,
+      `${service} service is not configured.`,
+      { service, missing: missing.join(",") },
+    ),
+    { status: 503 },
+  );
+}
+
+export type MangaSummaryDto = {
+  id: string;
+  title: string;
+  cover_file: string | null;
+  status: string;
+  year: number | null;
+  description: string;
+  tags: string[];
+  tag_ids: string[];
+  author: string;
+  artist: string;
+  rating: number | null;
+  follows: number | null;
+  latest_chapter: string | null;
+};
+
+export type LatestMangaDto = MangaSummaryDto & {
+  chapters: { id: string; chapter: string | null; lang: string; publish_at: string }[];
+};
+
+export type ChapterDto = {
+  id: string;
+  chapter: string | null;
+  volume: string | null;
+  title: string;
+  lang: string;
+  pages: number;
+  external_url: string | null;
+  publish_at: string;
+  group: string;
+};
+
+export type PagesResponse = { pages: string[] };
+
+export type ContentEndpoint =
+  | "latest"
+  | "popular"
+  | "tags"
+  | "rank"
+  | "search"
+  | "manga"
+  | "chapter";
+
+export function contentPath(endpoint: ContentEndpoint, ...segments: string[]): string {
+  const tail = segments.map(encodeURIComponent).join("/");
+  return `/api/content/${endpoint}${tail ? `/${tail}` : ""}`;
+}
+
+export class ContentClientError extends Error {
+  readonly status: number;
+  readonly body: ApiErrorEnvelope | null;
+
+  constructor(status: number, body: ApiErrorEnvelope | null) {
+    super(`Content request failed with status ${status}`);
+    this.status = status;
+    this.body = body;
+  }
+}
+
+export type ContentClient = {
+  latest(signal?: AbortSignal): Promise<LatestMangaDto[]>;
+  popular(signal?: AbortSignal): Promise<MangaSummaryDto[]>;
+  manga(id: string, signal?: AbortSignal): Promise<MangaSummaryDto>;
+  chapters(id: string, signal?: AbortSignal): Promise<{ vi: ChapterDto[]; en: ChapterDto[] }>;
+  pages(chapterId: string, signal?: AbortSignal): Promise<PagesResponse>;
+};
+
+export function createContentClient(origin = "/api/content"): ContentClient {
+  const root = origin.endsWith("/api/content")
+    ? origin.slice(0, -"/api/content".length)
+    : origin.replace(/\/$/, "");
+
+  async function get<T>(path: string, signal?: AbortSignal): Promise<T> {
+    const res = await fetch(`${root}${path}`, { signal, cache: "no-store" });
+    const payload = await res.json().catch(() => null);
+    if (!res.ok) throw new ContentClientError(res.status, payload as ApiErrorEnvelope | null);
+    return payload as T;
+  }
+
+  return {
+    latest: (signal) => get<LatestMangaDto[]>(contentPath("latest"), signal),
+    popular: (signal) => get<MangaSummaryDto[]>(contentPath("popular"), signal),
+    manga: (id, signal) => get<MangaSummaryDto>(contentPath("manga", id), signal),
+    chapters: (id, signal) => get<{ vi: ChapterDto[]; en: ChapterDto[] }>(
+      contentPath("manga", id, "chapters"),
+      signal,
+    ),
+    pages: (chapterId, signal) => get<PagesResponse>(
+      contentPath("chapter", chapterId, "pages"),
+      signal,
+    ),
+  };
+}
diff --git a/web/lib/db/client.ts b/web/lib/db/client.ts
new file mode 100644
index 0000000..a066f91
--- /dev/null
+++ b/web/lib/db/client.ts
@@ -0,0 +1,62 @@
+import "server-only";
+
+import { drizzle } from "drizzle-orm/node-postgres";
+import { Pool } from "pg";
+import { errorEnvelope } from "../contracts";
+import * as schema from "./schema";
+
+export type DatabaseConfig = { url: string };
+
+export class DatabaseConfigurationError extends Error {
+  readonly code: "DATABASE_NOT_CONFIGURED" | "DATABASE_CONFIG_INVALID";
+  readonly missing: string[];
+
+  constructor(
+    code: "DATABASE_NOT_CONFIGURED" | "DATABASE_CONFIG_INVALID",
+    message: string,
+    missing: string[] = [],
+  ) {
+    super(message);
+    this.name = "DatabaseConfigurationError";
+    this.code = code;
+    this.missing = missing;
+  }
+}
+
+export function readDatabaseConfig(env: NodeJS.ProcessEnv = process.env): DatabaseConfig {
+  const url = env.DATABASE_URL?.trim();
+  if (!url) {
+    throw new DatabaseConfigurationError(
+      "DATABASE_NOT_CONFIGURED",
+      "Application database is not configured.",
+      ["DATABASE_URL"],
+    );
+  }
+  try {
+    const parsed = new URL(url);
+    if (!["postgres:", "postgresql:"].includes(parsed.protocol)) throw new Error("protocol");
+  } catch {
+    throw new DatabaseConfigurationError("DATABASE_CONFIG_INVALID", "DATABASE_URL is invalid.");
+  }
+  return { url };
+}
+
+export function databaseErrorResponse(error: unknown): Response | null {
+  if (!(error instanceof DatabaseConfigurationError)) return null;
+  const details: Record<string, string> = { service: "database" };
+  if (error.missing.length > 0) details.missing = error.missing.join(",");
+  return Response.json(errorEnvelope(error.code, error.message, details), { status: 503 });
+}
+
+function connect(url: string) {
+  const pool = new Pool({ connectionString: url, max: 5 });
+  return { pool, db: drizzle({ client: pool, schema }) };
+}
+
+let connection: ReturnType<typeof connect> | undefined;
+
+// Pool creation stays lazy so builds and public routes need no DATABASE_URL.
+export function getDatabase() {
+  if (!connection) connection = connect(readDatabaseConfig().url);
+  return connection.db;
+}
