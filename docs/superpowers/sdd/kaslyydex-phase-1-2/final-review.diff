+      "READER_TICKET_SECRET=",
+      "process.env.NEON_AUTH_COOKIE_SECRET = fixtureValue;",
+      "const label = 'public health returns ok';",
+    ].join("\n"),
+  );
+  assert.deepEqual(findings, []);
+});
