@@ -0,0 +1,22 @@
+import "server-only";
+import { connection } from "next/server";
+import { createContentClient, type ContentClient } from "@/lib/contracts";
+
+/// Server Components call Axum directly through the same typed client; the
+/// browser uses the same-origin proxy. No route ever calls MangaDex itself.
+export async function serverContent(): Promise<ContentClient> {
+  await connection();
+  const origin = process.env.RUST_CONTENT_API_ORIGIN?.trim();
+  if (!origin) throw new Error("CONTENT_NOT_CONFIGURED");
+  return createContentClient(origin);
+}
+
+export function contentUnavailable(message: string) {
+  return (
+    <div className="empty" role="alert">
+      <h2>Chưa có dữ liệu truyện</h2>
+      <p>{message}</p>
+      <p>Không thể kết nối tới dịch vụ nội dung. Vui lòng thử lại sau.</p>
+    </div>
+  );
+}
diff --git a/web/lib/contracts.ts b/web/lib/contracts.ts
new file mode 100644
index 0000000..ca59f01
--- /dev/null
+++ b/web/lib/contracts.ts
@@ -0,0 +1,344 @@
+// Browser-safe contracts shared by the Next BFF and later native clients.
+
+// Account DTOs are browser-safe: no email, role or privileged state leaks into
+// public content components.
+export type AccountProfileDto = {
+  id: string;
+  username: string | null;
+  displayName: string | null;
+  avatarUrl: string | null;
+  level: number;
+  totalXp: number;
+  title: string;
+};
+
+export type LibraryEntryDto = {
+  mangaId: string;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  status: string;
+  followedAt: number;
+  lastChapterId: string | null;
+  lastReadPublish: number;
+  revision: number;
+};
+
+export type ProgressEntryDto = {
+  mangaId: string;
+  chapterId: string;
+  lang: string;
+  chapter: string | null;
+  title: string | null;
+  coverFile: string | null;
+  page: number;
+  total: number;
+  maxPage: number;
+  lastReadAt: number;
+  revision: number;
+};
+
+export type ImportSummaryDto = {
+  libraryInserted: number;
+  libraryUpdated: number;
+  progressInserted: number;
+  progressUpdated: number;
+  skipped: number;
+  settingsApplied: boolean;
+};
+
+export type ApiErrorEnvelope = {
+  error: {
+    code: string;
+    message: string;
+    details: Record<string, string>;
+  };
+};
+
+export function errorEnvelope(
+  code: string,
+  message: string,
+  details: Record<string, string> = {},
+): ApiErrorEnvelope {
+  return { error: { code, message, details } };
+}
+
+export function serviceUnavailableResponse(
+  service: "auth" | "content" | "database",
+  missing: string[],
+): Response {
+  return Response.json(
+    errorEnvelope(
+      `${service.toUpperCase()}_NOT_CONFIGURED`,
+      `${service} service is not configured.`,
+      { service, missing: missing.join(",") },
+    ),
+    { status: 503 },
+  );
+}
+
+export type MangaSummaryDto = {
+  id: string;
+  title: string;
+  cover_file: string | null;
+  status: string;
+  year: number | null;
+  description: string;
+  tags: string[];
+  tag_ids: string[];
+  author: string;
+  artist: string;
+  rating: number | null;
+  follows: number | null;
+  latest_chapter: string | null;
+};
+
+export type LatestChapterSummaryDto = {
+  id: string;
+  chapter: string | null;
+  lang: string;
+  publish_at: string;
+};
+
+export type LatestMangaDto = MangaSummaryDto & {
+  chapters: LatestChapterSummaryDto[];
+};
+
+export type TagDto = { id: string; name: string; group: string };
+
+export type SearchResponse = { results: MangaSummaryDto[]; total: number };
+
+export type ChaptersResponse = { vi: ChapterDto[]; en: ChapterDto[] };
+
+export type ChapterDto = {
+  id: string;
+  chapter: string | null;
+  volume: string | null;
+  title: string;
+  lang: string;
+  pages: number;
+  external_url: string | null;
+  publish_at: string;
+  group: string;
+};
+
+/// Single-chapter authority from Axum/MangaDex entity metadata. The public
+/// chapter lists are capped at 2000 and cannot establish ownership alone.
+export type ChapterMetadataDto = {
+  id: string;
+  manga_id: string;
+  lang: string;
+  pages: number;
+  external_url: string | null;
+  unavailable: boolean;
+  chapter: string | null;
+  title: string;
+};
+
+export type PagesResponse = { pages: string[] };
+
+/// Bounded continuation page for chapter notifications. `partial` is true when
+/// MangaDex's 10,000 offset limit prevents reaching older candidates.
+export type ChapterFeedPageDto = {
+  items: ChapterDto[];
+  total: number;
+  offset: number;
+  limit: number;
+  next_offset: number | null;
+  partial: boolean;
+};
+
+export type NotificationFeedParams = {
+  lang: "vi" | "en";
+  since?: string | null;
+  offset?: number;
+  limit?: number;
+};
+
+// Task 7 browser-safe community DTOs. Bodies are plain text; hidden/removed
+// bodies are null outside the authenticated moderator queue.
+export type CommentStatus = "visible" | "hidden" | "removed";
+
+export type CommentDto = {
+  id: string;
+  targetType: "manga" | "chapter";
+  targetId: string;
+  parentId: string | null;
+  userId: string;
+  authorName: string;
+  body: string | null;
+  spoiler: boolean;
+  status: CommentStatus;
+  createdAt: number;
+  updatedAt: number;
+  replies: CommentDto[];
+};
+
+export type CommentListDto = { items: CommentDto[]; nextCursor: string | null };
+
+export type ReportDto = {
+  id: string;
+  commentId: string;
+  reason: string;
+  status: "open" | "resolved" | "dismissed";
+  createdAt: number;
+  comment: CommentDto | null;
+};
+
+export type ReportListDto = { items: ReportDto[]; nextCursor: string | null };
+
+export type NotificationDto = {
+  id: string;
+  type: string;
+  title: string;
+  body: string;
+  href: string | null;
+  readAt: number | null;
+  createdAt: number;
+};
+
+export type NotificationListDto = {
+  items: NotificationDto[];
+  unreadCount: number;
+  nextCursor: string | null;
+};
+
+export type ThreadDto = {
+  targetType: "manga" | "chapter";
+  targetId: string;
+  locked: boolean;
+};
+
+export type ContentEndpoint =
+  | "latest"
+  | "popular"
+  | "tags"
+  | "rank"
+  | "search"
+  | "manga"
+  | "chapter"
+  | "notifications"
+  | "img";
+
+export function contentPath(endpoint: ContentEndpoint, ...segments: string[]): string {
+  const tail = segments.map(encodeURIComponent).join("/");
+  return `/api/content/${endpoint}${tail ? `/${tail}` : ""}`;
+}
+
+export class ContentClientError extends Error {
+  readonly status: number;
+  readonly body: ApiErrorEnvelope | null;
+
+  constructor(status: number, body: ApiErrorEnvelope | null) {
+    super(`Content request failed with status ${status}`);
+    this.status = status;
+    this.body = body;
+  }
+}
+
+/// All MangaDex image bytes flow through Axum's `/api/content/img` handler.
+export function contentImageUrl(upstream: string): string {
+  return `${contentPath("img")}?u=${encodeURIComponent(upstream)}`;
+}
+
+export function coverImageUrl(
+  manga: Pick<MangaSummaryDto, "id" | "cover_file">,
+  size = 256,
+): string | null {
+  if (!manga.cover_file) return null;
+  return contentImageUrl(
+    `https://uploads.mangadex.org/covers/${manga.id}/${manga.cover_file}.${size}.jpg`,
+  );
+}
+
+/// Defensive boundary normalization for any legacy `/api/img?u=` page URL that
+/// may still arrive from cached content. No upstream fetch happens here.
+export function normalizePageUrls(pages: string[]): string[] {
+  return pages.map((page) => {
+    if (!page.startsWith("/api/img?")) return page;
+    const upstream = new URL(page, "http://content.local").searchParams.get("u");
+    return upstream ? contentImageUrl(upstream) : page;
+  });
+}
+
+export type SearchParams = {
+  q?: string;
+  tags?: string[];
+  status?: string;
+  sort?: string;
+  page?: number;
+};
+
+export function searchQuery(params: SearchParams): string {
+  const query = new URLSearchParams();
+  if (params.q?.trim()) query.set("q", params.q.trim());
+  const tags = (params.tags ?? []).filter(Boolean);
+  if (tags.length > 0) query.set("tags", tags.join(","));
+  if (params.status) query.set("status", params.status);
+  if (params.sort && params.sort !== "follows") query.set("sort", params.sort);
+  if (params.page && params.page > 1) query.set("page", String(params.page));
+  const encoded = query.toString();
+  return encoded ? `?${encoded}` : "";
+}
+
+export type ContentClient = {
+  latest(signal?: AbortSignal): Promise<LatestMangaDto[]>;
+  popular(signal?: AbortSignal): Promise<MangaSummaryDto[]>;
+  tags(signal?: AbortSignal): Promise<TagDto[]>;
+  rank(kind: "follows" | "rating", signal?: AbortSignal): Promise<MangaSummaryDto[]>;
+  search(params: SearchParams, signal?: AbortSignal): Promise<SearchResponse>;
+  manga(id: string, signal?: AbortSignal): Promise<MangaSummaryDto>;
+  chapters(id: string, signal?: AbortSignal): Promise<ChaptersResponse>;
+  chapterMetadata(id: string, signal?: AbortSignal): Promise<ChapterMetadataDto>;
+  notificationFeed(id: string, params: NotificationFeedParams, signal?: AbortSignal): Promise<ChapterFeedPageDto>;
+  pages(chapterId: string, signal?: AbortSignal): Promise<PagesResponse>;
+};
+
+export function createContentClient(origin = "/api/content"): ContentClient {
+  const root = origin.endsWith("/api/content")
+    ? origin.slice(0, -"/api/content".length)
+    : origin.replace(/\/$/, "");
+
+  async function get<T>(path: string, signal?: AbortSignal): Promise<T> {
+    const res = await fetch(`${root}${path}`, { signal, cache: "no-store" });
+    const payload = await res.json().catch(() => null);
+    if (!res.ok) throw new ContentClientError(res.status, payload as ApiErrorEnvelope | null);
+    return payload as T;
+  }
+
+  return {
+    latest: (signal) => get<LatestMangaDto[]>(contentPath("latest"), signal),
+    popular: (signal) => get<MangaSummaryDto[]>(contentPath("popular"), signal),
+    tags: (signal) => get<TagDto[]>(contentPath("tags"), signal),
+    rank: (kind, signal) => get<MangaSummaryDto[]>(
+      `${contentPath("rank")}?kind=${kind}`,
+      signal,
+    ),
+    search: (params, signal) => get<SearchResponse>(
+      `${contentPath("search")}${searchQuery(params)}`,
+      signal,
+    ),
+    manga: (id, signal) => get<MangaSummaryDto>(contentPath("manga", id), signal),
+    chapters: (id, signal) => get<ChaptersResponse>(
+      contentPath("manga", id, "chapters"),
+      signal,
+    ),
+    chapterMetadata: (id, signal) => get<ChapterMetadataDto>(contentPath("chapter", id), signal),
+    notificationFeed: (id, params, signal) => {
+      const query = new URLSearchParams();
+      query.set("lang", params.lang);
+      if (params.since) query.set("since", params.since);
+      if (params.offset !== undefined) query.set("offset", String(params.offset));
+      if (params.limit !== undefined) query.set("limit", String(params.limit));
+      const encoded = query.toString();
+      return get<ChapterFeedPageDto>(
+        `${contentPath("notifications", "feed", id)}${encoded ? `?${encoded}` : ""}`,
+        signal,
+      );
+    },
+    pages: async (chapterId, signal) => {
+      const result = await get<PagesResponse>(contentPath("chapter", chapterId, "pages"), signal);
+      return { pages: normalizePageUrls(result.pages ?? []) };
+    },
+  };
+}
diff --git a/web/lib/db/client.ts b/web/lib/db/client.ts
new file mode 100644
index 0000000..2eb5fe6
--- /dev/null
+++ b/web/lib/db/client.ts
@@ -0,0 +1,64 @@
+import "server-only";
+
+import { drizzle } from "drizzle-orm/node-postgres";
+import { Pool } from "pg";
+import { errorEnvelope } from "../contracts";
+import * as schema from "./schema";
+
+export type DatabaseConfig = { url: string };
+
+export class DatabaseConfigurationError extends Error {
+  readonly code: "DATABASE_NOT_CONFIGURED" | "DATABASE_CONFIG_INVALID";
+  readonly missing: string[];
+
+  constructor(
+    code: "DATABASE_NOT_CONFIGURED" | "DATABASE_CONFIG_INVALID",
+    message: string,
+    missing: string[] = [],
+  ) {
+    super(message);
+    this.name = "DatabaseConfigurationError";
+    this.code = code;
+    this.missing = missing;
+  }
+}
+
+export function readDatabaseConfig(env: NodeJS.ProcessEnv = process.env): DatabaseConfig {
+  const url = env.DATABASE_URL?.trim();
+  if (!url) {
+    throw new DatabaseConfigurationError(
+      "DATABASE_NOT_CONFIGURED",
+      "Application database is not configured.",
+      ["DATABASE_URL"],
+    );
+  }
+  try {
+    const parsed = new URL(url);
+    if (!["postgres:", "postgresql:"].includes(parsed.protocol)) throw new Error("protocol");
+  } catch {
+    throw new DatabaseConfigurationError("DATABASE_CONFIG_INVALID", "DATABASE_URL is invalid.");
+  }
+  return { url };
+}
+
+export function databaseErrorResponse(error: unknown): Response | null {
+  if (!(error instanceof DatabaseConfigurationError)) return null;
+  const details: Record<string, string> = { service: "database" };
+  if (error.missing.length > 0) details.missing = error.missing.join(",");
+  return Response.json(errorEnvelope(error.code, error.message, details), { status: 503 });
+}
+
+function connect(url: string) {
+  const pool = new Pool({ connectionString: url, max: 5 });
+  return { pool, db: drizzle({ client: pool, schema }) };
+}
+
+export type AppDatabase = ReturnType<typeof connect>["db"];
+
+let connection: ReturnType<typeof connect> | undefined;
+
+// Pool creation stays lazy so builds and public routes need no DATABASE_URL.
+export function getDatabase() {
+  if (!connection) connection = connect(readDatabaseConfig().url);
+  return connection.db;
+}
diff --git a/web/lib/db/schema.ts b/web/lib/db/schema.ts
new file mode 100644
index 0000000..2b617d8
--- /dev/null
+++ b/web/lib/db/schema.ts
@@ -0,0 +1,229 @@
+import { bigint, boolean, check, integer, pgTable, primaryKey, text, timestamp, uniqueIndex, index } from "drizzle-orm/pg-core";
+import { sql } from "drizzle-orm";
+
+// Application-owned tables only. Neon Managed Auth owns its identity/session
+// tables in its own schema and they are never managed from this file. Opaque
+// auth user ids stay text: never parse them as UUIDs or derive trust from them.
+export const profiles = pgTable("profiles", {
+  userId: text("user_id").primaryKey(),
+  // Stored normalized (trimmed + lowercase); the unique index is the final guard.
+  username: text("username"),
+  displayName: text("display_name"),
+  avatarUrl: text("avatar_url"),
+  // Server-owned XP/level. Never client-writable; kept consistent with the
+  // xp_events ledger by the single completion transaction.
+  totalXp: integer("total_xp").default(0).notNull(),
+  level: integer("level").default(1).notNull(),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [uniqueIndex("profiles_username_key").on(table.username)]);
+
+// Roles are explicitly bootstrapped from a verified allowlisted auth email.
+export const userRoles = pgTable("user_roles", {
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  role: text("role").notNull(),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [primaryKey({ columns: [table.userId, table.role] })]);
+
+export const libraryEntries = pgTable("library_entries", {
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  mangaId: text("manga_id").notNull(),
+  title: text("title").notNull(),
+  coverFile: text("cover_file"),
+  lang: text("lang").notNull().default("vi"),
+  status: text("status").notNull().default("reading"),
+  // Milliseconds since epoch, server-owned for normal writes; imported client
+  // times are bounded before they reach this column.
+  followedAt: bigint("followed_at", { mode: "number" }).notNull(),
+  lastChapterId: text("last_chapter_id"),
+  lastReadPublish: bigint("last_read_publish", { mode: "number" }).notNull().default(0),
+  revision: integer("revision").notNull().default(1),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [primaryKey({ columns: [table.userId, table.mangaId] })]);
+
+export const chapterProgress = pgTable("chapter_progress", {
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  mangaId: text("manga_id").notNull(),
+  chapterId: text("chapter_id").notNull(),
+  language: text("language").notNull().default("vi"),
+  chapter: text("chapter"),
+  title: text("title"),
+  coverFile: text("cover_file"),
+  // `page` is the current position and may move backward for rereads.
+  page: integer("page").notNull(),
+  // `maxPage` is the furthest observed page and never regresses; Task 8 will
+  // derive completion checkpoints from it, never from a client percentage.
+  maxPage: integer("max_page").notNull(),
+  total: integer("total").notNull(),
+  lastReadAt: bigint("last_read_at", { mode: "number" }).notNull(),
+  revision: integer("revision").notNull().default(1),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [
+  primaryKey({ columns: [table.userId, table.mangaId, table.chapterId, table.language] }),
+  index("chapter_progress_user_recent_idx").on(table.userId, table.lastReadAt),
+]);
+
+export const readerPreferences = pgTable("reader_preferences", {
+  userId: text("user_id").primaryKey().references(() => profiles.userId, { onDelete: "cascade" }),
+  mode: text("mode").notNull().default("vertical"),
+  fit: boolean("fit").notNull().default(true),
+  bg: text("bg").notNull().default("light"),
+  speed: integer("speed").notNull().default(3),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+});
+
+// Task 7: application-owned community tables. Locks live on the thread, never
+// on a comment status; all user ids stay opaque text from the managed session.
+export const commentThreads = pgTable("comment_threads", {
+  targetType: text("target_type").notNull(),
+  targetId: text("target_id").notNull(),
+  locked: boolean("locked").notNull().default(false),
+  lockedBy: text("locked_by"),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [
+  primaryKey({ columns: [table.targetType, table.targetId] }),
+  check("comment_threads_target_type_check", sql`${table.targetType} in ('manga', 'chapter')`),
+]);
+
+export const comments = pgTable("comments", {
+  id: text("id").primaryKey(),
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  targetType: text("target_type").notNull(),
+  targetId: text("target_id").notNull(),
+  parentId: text("parent_id"),
+  body: text("body"),
+  spoiler: boolean("spoiler").notNull().default(false),
+  status: text("status").notNull().default("visible"),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [
+  index("comments_thread_idx").on(table.targetType, table.targetId, table.createdAt),
+  index("comments_parent_idx").on(table.parentId),
+  check("comments_status_check", sql`${table.status} in ('visible', 'hidden', 'removed')`),
+  check("comments_target_type_check", sql`${table.targetType} in ('manga', 'chapter')`),
+  check("comments_no_self_parent", sql`${table.parentId} is null or ${table.parentId} <> ${table.id}`),
+]);
+
+export const commentReports = pgTable("comment_reports", {
+  id: text("id").primaryKey(),
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  commentId: text("comment_id").notNull().references(() => comments.id, { onDelete: "cascade" }),
+  reason: text("reason").notNull(),
+  status: text("status").notNull().default("open"),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+  resolvedAt: timestamp("resolved_at", { withTimezone: true }),
+  resolvedBy: text("resolved_by"),
+}, (table) => [
+  uniqueIndex("comment_reports_open_key").on(table.userId, table.commentId)
+    .where(sql`${table.status} = 'open'`),
+  index("comment_reports_queue_idx").on(table.status, table.createdAt),
+  check("comment_reports_status_check", sql`${table.status} in ('open', 'resolved', 'dismissed')`),
+]);
+
+export const notifications = pgTable("notifications", {
+  id: text("id").primaryKey(),
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  type: text("type").notNull(),
+  eventKey: text("event_key").notNull(),
+  title: text("title").notNull(),
+  body: text("body").notNull(),
+  href: text("href"),
+  readAt: timestamp("read_at", { withTimezone: true }),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [
+  uniqueIndex("notifications_event_key").on(table.userId, table.eventKey),
+  index("notifications_inbox_idx").on(table.userId, table.createdAt),
+]);
+
+export const notificationCursors = pgTable("notification_cursors", {
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  mangaId: text("manga_id").notNull(),
+  language: text("language").notNull(),
+  lastPublish: bigint("last_publish", { mode: "number" }).notNull(),
+  // Composite cursor component: legacy rows keep '' and are re-evaluated for
+  // chapters sharing the stored publish time; event keys dedupe the repeat.
+  lastChapterId: text("last_chapter_id").notNull().default(""),
+  // Continuation state for the bounded notification feed. `scan_publish` is the
+  // exclusive since bound, `scan_offset` walks its page within one timestamp.
+  scanPublish: bigint("scan_publish", { mode: "number" }).notNull().default(0),
+  scanOffset: integer("scan_offset").notNull().default(0),
+  // A timestamp cohort being reconciled. Pending rows are the deterministic
+  // replay queue for equal publish times whose upstream order is unspecified.
+  cohortPublish: bigint("cohort_publish", { mode: "number" }),
+  cohortComplete: boolean("cohort_complete").notNull().default(false),
+  updatedAt: timestamp("updated_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [primaryKey({ columns: [table.userId, table.mangaId, table.language] })]);
+
+export const notificationPending = pgTable("notification_pending", {
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  mangaId: text("manga_id").notNull(),
+  language: text("language").notNull(),
+  chapterId: text("chapter_id").notNull(),
+  publish: bigint("publish", { mode: "number" }).notNull(),
+  chapter: text("chapter"),
+  title: text("title"),
+}, (table) => [
+  primaryKey({ columns: [table.userId, table.mangaId, table.language, table.chapterId] }),
+  index("notification_pending_cohort_idx").on(table.userId, table.mangaId, table.language, table.publish),
+]);
+
+// Task 8: server-signed reader sessions. The ticket signature binds these
+// exact values; the persisted row is checked against the caller on every use.
+export const readerSessions = pgTable("reader_sessions", {
+  id: text("id").primaryKey(),
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  chapterId: text("chapter_id").notNull(),
+  mangaId: text("manga_id").notNull(),
+  language: text("language").notNull(),
+  pageCount: integer("page_count").notNull(),
+  issuedAt: bigint("issued_at", { mode: "number" }).notNull(),
+  expiresAt: bigint("expires_at", { mode: "number" }).notNull(),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [index("reader_sessions_user_idx").on(table.userId, table.issuedAt)]);
+
+// Distinct observed pages per session. The PK is the monotone union guard; a
+// legacy `lastPageSeen` value adds exactly one row, never a page range.
+export const readerCheckpoints = pgTable("reader_checkpoints", {
+  sessionId: text("session_id").notNull().references(() => readerSessions.id, { onDelete: "cascade" }),
+  page: integer("page").notNull(),
+  seenAt: bigint("seen_at", { mode: "number" }).notNull(),
+}, (table) => [primaryKey({ columns: [table.sessionId, table.page] })]);
+
+export const readingCompletions = pgTable("reading_completions", {
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  chapterId: text("chapter_id").notNull(),
+  mangaId: text("manga_id").notNull(),
+  language: text("language").notNull(),
+  pageCount: integer("page_count").notNull(),
+  lastPageSeen: integer("last_page_seen").notNull(),
+  readerSessionId: text("reader_session_id").notNull(),
+  completedAt: bigint("completed_at", { mode: "number" }).notNull(),
+}, (table) => [primaryKey({ columns: [table.userId, table.chapterId] })]);
+
+export const xpEvents = pgTable("xp_events", {
+  id: text("id").primaryKey(),
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  eventType: text("event_type").notNull(),
+  chapterId: text("chapter_id").notNull(),
+  amount: integer("amount").notNull(),
+  ruleVersion: text("rule_version").notNull(),
+  createdAt: timestamp("created_at", { withTimezone: true }).defaultNow().notNull(),
+}, (table) => [uniqueIndex("xp_events_user_type_chapter_key").on(table.userId, table.eventType, table.chapterId)]);
+
+// Deterministic cosmetic realm seed; boundaries mirror the pure TypeScript and
+// Rust shared-domain fixtures.
+export const cultivationRealms = pgTable("cultivation_realms", {
+  key: text("key").primaryKey(),
+  minLevel: integer("min_level").notNull(),
+  maxLevel: integer("max_level").notNull(),
+  name: text("name").notNull(),
+}, (table) => [check("cultivation_realms_range_check", sql`${table.minLevel} <= ${table.maxLevel}`)]);
+
+// Durable, sliding-window counters. pg_advisory_xact_lock in the service keeps
+// concurrent requests for one user/action from racing past the limit.
+export const actionEvents = pgTable("action_events", {
+  id: text("id").primaryKey(),
+  userId: text("user_id").notNull().references(() => profiles.userId, { onDelete: "cascade" }),
+  action: text("action").notNull(),
+  occurredAt: bigint("occurred_at", { mode: "number" }).notNull(),
+}, (table) => [index("action_events_window_idx").on(table.userId, table.action, table.occurredAt)]);
diff --git a/web/lib/format.ts b/web/lib/format.ts
new file mode 100644
index 0000000..7dbc1b8
--- /dev/null
+++ b/web/lib/format.ts
@@ -0,0 +1,61 @@
+// Pure presentation helpers shared by Server and Client Components.
+
+export function statusText(status: string): string {
+  return (
+    {
+      ongoing: "Đang tiến hành",
+      completed: "Hoàn thành",
+      hiatus: "Tạm ngưng",
+      cancelled: "Đã hủy",
+    }[status] || status
+  );
+}
+
+export function chapterName(number?: string | null): string {
+  return number ? `Chương ${number}` : "Truyện ngắn";
+}
+
+export function chapterLabel(chapter?: string | null): string {
+  return chapterName(chapter);
+}
+
+export function tagLabel(name: string): string {
+  // MangaDex tags arrive as "Title Case"; trim the descriptor suffix in Vietnamese UI.
+  return name.replace(/\s*\((?:Manga|Manhwa|Manhua)\)\s*$/i, "").trim() || name;
+}
+
+export function fmtDate(iso: string): string {
+  if (!/^\d{4}-\d{2}-\d{2}/.test(iso)) return "";
+  return `${iso.slice(8, 10)}/${iso.slice(5, 7)}/${iso.slice(0, 4)}`;
+}
+
+export function relDate(iso: string, now = Date.now()): string {
+  const time = Date.parse(iso);
+  if (!Number.isFinite(time)) return "";
+  const minutes = Math.floor((now - time) / 60_000);
+  if (minutes < 1) return "vừa xong";
+  if (minutes < 60) return `${minutes} phút trước`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return `${hours} giờ trước`;
+  const days = Math.floor(hours / 24);
+  return days < 30 ? `${days} ngày trước` : fmtDate(iso);
+}
+
+/// Search URL construction mirrors the Leptos `filter_url` wire format:
+/// tags are a comma-separated single query value.
+export function filterUrl(
+  q: string,
+  tags: string[],
+  status: string,
+  sort: string,
+  page: number,
+): string {
+  const params = new URLSearchParams();
+  if (q.trim()) params.set("q", q.trim());
+  if (tags.length > 0) params.set("tags", tags.join(","));
+  if (status) params.set("status", status);
+  if (sort && sort !== "follows") params.set("sort", sort);
+  if (page > 1) params.set("page", String(page));
+  const query = params.toString();
+  return `/search${query ? `?${query}` : ""}`;
+}
diff --git a/web/lib/guest.ts b/web/lib/guest.ts
new file mode 100644
index 0000000..c243979
--- /dev/null
+++ b/web/lib/guest.ts
@@ -0,0 +1,287 @@
+// Guest state at one boundary: accepts the old Next camelCase entries and the
+// Leptos snake_case entries, writes one canonical shape, and never throws when
+// storage is full, corrupt or unavailable.
+
+export const KEYS = {
+  history: "truyenviet:history",
+  library: "truyenviet:library",
+  reader: "truyenviet:reader",
+  theme: "truyenviet:theme",
+} as const;
+
+export const STORAGE_EVENT = "kaslyydex:guest-change";
+
+export type GuestHistory = {
+  mangaId: string;
+  mangaTitle: string;
+  chapterId: string;
+  chapter: string | null;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  ts: number;
+  page: number | null;
+  total: number | null;
+};
+
+export type GuestLibraryEntry = {
+  mangaId: string;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  followedAt: number;
+  lastChapterId: string | null;
+  lastReadPublish: number;
+};
+
+export type ReaderSettings = {
+  mode: "vertical" | "horizontal";
+  fit: boolean;
+  bg: "light" | "sepia" | "dark";
+  speed: number;
+};
+
+export const DEFAULT_SETTINGS: ReaderSettings = {
+  mode: "vertical",
+  fit: true,
+  bg: "light",
+  speed: 3,
+};
+
+type Loose = Record<string, unknown>;
+
+function obj(value: unknown): Loose {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as Loose) : {};
+}
+
+function pick(source: Loose, camel: string, snake: string): unknown {
+  return source[camel] ?? source[snake];
+}
+
+function text(value: unknown): string {
+  return typeof value === "string" ? value : "";
+}
+
+function nullableText(value: unknown): string | null {
+  return typeof value === "string" && value ? value : null;
+}
+
+function number(value: unknown, fallback = 0): number {
+  return typeof value === "number" && Number.isFinite(value) ? value : fallback;
+}
+
+function positive(value: unknown): number | null {
+  const parsed = typeof value === "number" ? value : Number(value);
+  return Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : null;
+}
+
+function store(): Pick<Storage, "getItem" | "setItem"> | null {
+  try {
+    const candidate = globalThis.localStorage;
+    return candidate ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function readRaw(key: string): string | null {
+  try {
+    return store()?.getItem(key) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+function writeRaw(key: string, value: string): void {
+  try {
+    store()?.setItem(key, value);
+    if (typeof globalThis.dispatchEvent === "function") {
+      globalThis.dispatchEvent(new Event(STORAGE_EVENT));
+    }
+  } catch {
+    // Storage is a nice-to-have: never block reading or navigation.
+  }
+}
+
+function parseList(raw: string | null): Loose[] {
+  if (!raw) return [];
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    return Array.isArray(parsed) ? parsed.map(obj) : [];
+  } catch {
+    return [];
+  }
+}
+
+export function normalizeHistoryEntry(value: unknown): GuestHistory | null {
+  const raw = obj(value);
+  const mangaId = text(pick(raw, "mangaId", "manga_id"));
+  const chapterId = text(pick(raw, "chapterId", "chapter_id"));
+  if (!mangaId || !chapterId) return null;
+  return {
+    mangaId,
+    mangaTitle: text(pick(raw, "mangaTitle", "manga_title")) || mangaId,
+    chapterId,
+    chapter: nullableText(raw.chapter),
+    title: text(raw.title) || text(pick(raw, "chapterTitle", "chapter_title")),
+    coverFile: nullableText(pick(raw, "coverFile", "cover_file")),
+    lang: text(raw.lang) || "vi",
+    ts: number(raw.ts, Date.now()),
+    page: positive(pick(raw, "page", "page")),
+    total: positive(raw.total),
+  };
+}
+
+let historyCache = { raw: "", value: [] as GuestHistory[] };
+
+export function getHistory(): GuestHistory[] {
+  const raw = readRaw(KEYS.history) ?? "";
+  if (raw !== historyCache.raw) {
+    const entries = parseList(raw || null)
+      .map(normalizeHistoryEntry)
+      .filter((entry): entry is GuestHistory => entry !== null);
+    entries.sort((a, b) => b.ts - a.ts);
+    historyCache = { raw, value: entries.slice(0, 30) };
+  }
+  return historyCache.value;
+}
+
+export function getHistoryFor(mangaId: string): GuestHistory | null {
+  return getHistory().find((entry) => entry.mangaId === mangaId) ?? null;
+}
+
+export type HistoryInput = Omit<GuestHistory, "ts" | "page" | "total">;
+
+export function pushHistory(input: HistoryInput): void {
+  const previous = getHistoryFor(input.mangaId);
+  const page = previous?.chapterId === input.chapterId ? previous.page : null;
+  const total = previous?.chapterId === input.chapterId ? previous.total : null;
+  const next = [
+    { ...input, ts: Date.now(), page, total },
+    ...getHistory().filter((entry) => entry.mangaId !== input.mangaId),
+  ].slice(0, 30);
+  writeRaw(KEYS.history, JSON.stringify(next));
+}
+
+/// Chapter-local restoration: only a matching chapterId and a valid page within
+/// the current page count may restore a position.
+export function restoredPage(history: GuestHistory | null, chapterId: string, totalPages: number): number {
+  if (!history || history.chapterId !== chapterId || totalPages <= 0) return 0;
+  const page = history.page;
+  if (page === null || page < 1 || page > totalPages) return 0;
+  return page - 1;
+}
+
+export function saveProgress(chapterId: string, page: number, total: number): void {
+  if (total <= 0) return;
+  const current = getHistory();
+  const target = current.find((entry) => entry.chapterId === chapterId);
+  if (!target || target.page === page && target.total === total) return;
+  const next = current.map((entry) =>
+    entry.chapterId === chapterId ? { ...entry, page, total } : entry,
+  );
+  writeRaw(KEYS.history, JSON.stringify(next));
+}
+
+export function normalizeLibraryEntry(value: unknown): GuestLibraryEntry | null {
+  const raw = obj(value);
+  const mangaId = text(pick(raw, "mangaId", "manga_id"));
+  if (!mangaId) return null;
+  return {
+    mangaId,
+    title: text(raw.title) || mangaId,
+    coverFile: nullableText(pick(raw, "coverFile", "cover_file")),
+    lang: text(raw.lang) || "vi",
+    followedAt: number(pick(raw, "followedAt", "followed_at"), Date.now()),
+    lastChapterId: nullableText(pick(raw, "lastChapterId", "last_chapter_id")),
+    lastReadPublish: number(pick(raw, "lastReadPublish", "last_read_publish")),
+  };
+}
+
+let libraryCache = { raw: "", value: [] as GuestLibraryEntry[] };
+
+export function getLibrary(): GuestLibraryEntry[] {
+  const raw = readRaw(KEYS.library) ?? "";
+  if (raw !== libraryCache.raw) {
+    const entries = parseList(raw || null)
+      .map(normalizeLibraryEntry)
+      .filter((entry): entry is GuestLibraryEntry => entry !== null);
+    libraryCache = { raw, value: entries.slice(0, 200) };
+  }
+  return libraryCache.value;
+}
+
+export function toggleLibrary(entry: Omit<GuestLibraryEntry, "followedAt" | "lastChapterId" | "lastReadPublish">): boolean {
+  const current = getLibrary();
+  const exists = current.some((item) => item.mangaId === entry.mangaId);
+  const next = exists
+    ? current.filter((item) => item.mangaId !== entry.mangaId)
+    : [{ ...entry, followedAt: Date.now(), lastChapterId: null, lastReadPublish: 0 }, ...current];
+  writeRaw(KEYS.library, JSON.stringify(next.slice(0, 200)));
+  return !exists;
+}
+
+export function setLibraryLast(mangaId: string, chapterId: string, publishMs: number): void {
+  const next = getLibrary().map((entry) => {
+    if (entry.mangaId !== mangaId || !chapterId || entry.lastChapterId === chapterId) return entry;
+    return { ...entry, lastChapterId: chapterId, lastReadPublish: publishMs };
+  });
+  writeRaw(KEYS.library, JSON.stringify(next));
+}
+
+export function normalizeSettings(value: unknown): ReaderSettings {
+  const raw = obj(value);
+  const mode = text(pick(raw, "mode", "mode"));
+  const bg = text(raw.bg);
+  const parsedSpeed = number(raw.speed, DEFAULT_SETTINGS.speed);
+  const speed = parsedSpeed >= 1 && parsedSpeed <= 5
+    ? Math.round(parsedSpeed)
+    : DEFAULT_SETTINGS.speed;
+  return {
+    mode: mode === "horizontal" ? "horizontal" : "vertical",
+    fit: typeof raw.fit === "boolean" ? raw.fit : DEFAULT_SETTINGS.fit,
+    bg: bg === "sepia" || bg === "dark" ? bg : "light",
+    speed,
+  };
+}
+
+let settingsCache = { raw: "", value: DEFAULT_SETTINGS };
+
+export function getSettings(): ReaderSettings {
+  const raw = readRaw(KEYS.reader) ?? "";
+  if (raw !== settingsCache.raw) {
+    let parsed: unknown = null;
+    try {
+      parsed = raw ? JSON.parse(raw) : null;
+    } catch {
+      parsed = null;
+    }
+    settingsCache = { raw, value: normalizeSettings(parsed) };
+  }
+  return settingsCache.value;
+}
+
+export function saveSettings(settings: ReaderSettings): void {
+  writeRaw(KEYS.reader, JSON.stringify(normalizeSettings(settings)));
+}
+
+export function getTheme(): "dark" | "light" {
+  return readRaw(KEYS.theme) === "light" ? "light" : "dark";
+}
+
+export function saveTheme(theme: "dark" | "light"): void {
+  writeRaw(KEYS.theme, theme);
+}
+
+export function subscribe(listener: () => void): () => void {
+  if (typeof globalThis.addEventListener === "function") {
+    globalThis.addEventListener(STORAGE_EVENT, listener);
+  }
+  if (typeof window !== "undefined") window.addEventListener("storage", listener);
+  return () => {
+    if (typeof globalThis.removeEventListener === "function") {
+      globalThis.removeEventListener(STORAGE_EVENT, listener);
+    }
+    if (typeof window !== "undefined") window.removeEventListener("storage", listener);
+  };
+}
diff --git a/web/lib/health.ts b/web/lib/health.ts
new file mode 100644
index 0000000..194f267
--- /dev/null
+++ b/web/lib/health.ts
@@ -0,0 +1,122 @@
+import "server-only";
+
+import { Pool } from "pg";
+import { AuthConfigurationError, readAuthConfig } from "./auth/server";
+import { DatabaseConfigurationError, readDatabaseConfig } from "./db/client";
+
+export type ReadinessCheck = "ok" | "missing" | "invalid" | "unavailable" | "skipped";
+
+export type ReadinessReport = {
+  status: "ready" | "unavailable";
+  checks: { configuration: ReadinessCheck; database: ReadinessCheck; upstream: ReadinessCheck };
+  // Env names only. Values, URLs and upstream messages never enter this report.
+  missing: string[];
+};
+
+const CHECK_TIMEOUT_MS = 1_500;
+
+function invalidContentOrigin(env: NodeJS.ProcessEnv): boolean {
+  const raw = env.RUST_CONTENT_API_ORIGIN?.trim();
+  if (!raw) return false;
+  try {
+    const url = new URL(raw);
+    return !["http:", "https:"].includes(url.protocol) || Boolean(url.username || url.password);
+  } catch {
+    return true;
+  }
+}
+
+async function databaseReachable(url: string): Promise<boolean> {
+  const pool = new Pool({
+    connectionString: url,
+    max: 1,
+    connectionTimeoutMillis: CHECK_TIMEOUT_MS,
+    query_timeout: CHECK_TIMEOUT_MS,
+  });
+  try {
+    const client = await pool.connect();
+    try {
+      await client.query("SELECT 1");
+      return true;
+    } finally {
+      client.release();
+    }
+  } catch {
+    return false;
+  } finally {
+    await pool.end().catch(() => {});
+  }
+}
+
+async function upstreamReachable(origin: string): Promise<boolean> {
+  try {
+    const response = await fetch(`${origin}/api/v1/ready`, {
+      cache: "no-store",
+      redirect: "manual",
+      signal: AbortSignal.timeout(CHECK_TIMEOUT_MS),
+    });
+    return response.ok;
+  } catch {
+    return false;
+  }
+}
+
+/// Readiness is deliberately separate from the credential-free liveness route.
+/// It validates configuration without printing values, then performs bounded
+/// DB and content-upstream probes. Missing local config is a normal 503.
+export async function checkReadiness(env: NodeJS.ProcessEnv = process.env): Promise<ReadinessReport> {
+  const missing: string[] = [];
+  let databaseUrl = "";
+  let contentOrigin = "";
+
+  try {
+    databaseUrl = readDatabaseConfig(env).url;
+  } catch (error) {
+    if (error instanceof DatabaseConfigurationError && error.missing.length > 0) {
+      missing.push(...error.missing);
+    } else {
+      missing.push("DATABASE_URL");
+    }
+  }
+  try {
+    readAuthConfig(env);
+  } catch (error) {
+    if (error instanceof AuthConfigurationError && error.missing.length > 0) {
+      missing.push(...error.missing);
+    } else {
+      missing.push("NEON_AUTH_BASE_URL", "NEON_AUTH_COOKIE_SECRET");
+    }
+  }
+  const ticket = env.READER_TICKET_SECRET?.trim();
+  if (!ticket || ticket.length < 32) missing.push("READER_TICKET_SECRET");
+  const origin = env.RUST_CONTENT_API_ORIGIN?.trim();
+  if (!origin) missing.push("RUST_CONTENT_API_ORIGIN");
+  else if (invalidContentOrigin(env)) missing.push("RUST_CONTENT_API_ORIGIN");
+  else contentOrigin = new URL(origin).origin;
+
+  const checks: ReadinessReport["checks"] = {
+    configuration: missing.length === 0 ? "ok" : "missing",
+    database: "skipped",
+    upstream: "skipped",
+  };
+  if (databaseUrl) checks.database = (await databaseReachable(databaseUrl)) ? "ok" : "unavailable";
+  if (contentOrigin) checks.upstream = (await upstreamReachable(contentOrigin)) ? "ok" : "unavailable";
+
+  return {
+    status: missing.length === 0 && checks.database === "ok" && checks.upstream === "ok"
+      ? "ready"
+      : "unavailable",
+    checks,
+    missing: [...new Set(missing)].sort(),
+  };
+}
+
+export function readinessResponse(report: ReadinessReport): Response {
+  return Response.json(
+    { status: report.status, checks: report.checks, missing: report.missing },
+    {
+      status: report.status === "ready" ? 200 : 503,
+      headers: { "cache-control": "private, no-store" },
+    },
+  );
+}
diff --git a/web/lib/me/handlers.ts b/web/lib/me/handlers.ts
new file mode 100644
index 0000000..9552be8
--- /dev/null
+++ b/web/lib/me/handlers.ts
@@ -0,0 +1,209 @@
+import "server-only";
+
+import type { AppDatabase } from "../db/client";
+import { DatabaseConfigurationError, getDatabase } from "../db/client";
+import { AuthConfigurationError, getAuth } from "../auth/server";
+import { identityFromSession, type AccountIdentity } from "../auth/identity";
+import { errorEnvelope } from "../contracts";
+import { logErrorEvent, withObservedRoute } from "../observability";
+import {
+  boundedClientTime,
+  parseImportPayload,
+  parseLanguage,
+  parseLibraryInput,
+  parseProfilePatch,
+  parseProgressInput,
+  parseResourceId,
+  parseSettingsInput,
+  readJson,
+  requireOrigin,
+  ValidationError,
+} from "../validators";
+import { ServiceError, ensureProfile, getLevel, importGuest, listLibrary, listProgress, putLibrary, putProgress, deleteLibrary, deleteProgress, getSettings, putSettings, updateProfile } from "./service";
+
+export type MeDeps = {
+  db: () => AppDatabase;
+  identity: () => Promise<AccountIdentity | null>;
+  now: () => number;
+  allowlist: readonly string[];
+};
+
+export function privateJson(data: unknown, status = 200): Response {
+  return Response.json(data, {
+    status,
+    headers: {
+      "cache-control": "private, no-store",
+      vary: "Cookie",
+      "x-content-type-options": "nosniff",
+    },
+  });
+}
+
+export function errorToResponse(error: unknown): Response {
+  logErrorEvent(error);
+  if (error instanceof ValidationError) {
+    return privateJson(errorEnvelope(error.code, error.message), error.status);
+  }
+  if (error instanceof ServiceError) {
+    return privateJson(errorEnvelope(error.code, error.message), error.status);
+  }
+  if (error instanceof AuthConfigurationError || error instanceof DatabaseConfigurationError) {
+    const details: Record<string, string> = { service: error instanceof AuthConfigurationError ? "auth" : "database" };
+    if (error.missing.length > 0) details.missing = error.missing.join(",");
+    return privateJson(errorEnvelope(error.code, error.message, details), 503);
+  }
+  return privateJson(errorEnvelope("INTERNAL_ERROR", "Account request failed."), 500);
+}
+
+/// Testable account API factory. Production route files supply the real pooled
+/// database and managed-session resolver; tests supply PGlite plus an identity
+/// obtained from the real SDK fixture. No header/env bypass exists here.
+export function createMeApi(deps: MeDeps) {
+  const now = () => deps.now();
+  const db = () => deps.db();
+
+  async function withUser(
+    request: Request,
+    action: (user: AccountIdentity) => Promise<Response>,
+    mutate = false,
+  ): Promise<Response> {
+    try {
+      if (mutate) requireOrigin(request);
+      const user = await deps.identity();
+      if (!user) {
+        return privateJson(errorEnvelope("UNAUTHENTICATED", "Sign in to access account data."), 401);
+      }
+      await ensureProfile(db(), user, { now: now(), allowlist: deps.allowlist });
+      return await action(user);
+    } catch (error) {
+      return errorToResponse(error);
+    }
+  }
+
+  return {
+    meGet: (request: Request) => withUser(request, async (user) => {
+      const profile = await ensureProfile(db(), user, { now: now(), allowlist: deps.allowlist });
+      const settings = await getSettings(db(), user.id);
+      return privateJson({ profile, settings });
+    }),
+
+    mePatch: (request: Request) => withUser(request, async (user) => {
+      const patch = parseProfilePatch(await readJson(request));
+      const profile = await updateProfile(db(), user.id, patch, now());
+      return privateJson({ profile });
+    }, true),
+
+    levelGet: (request: Request) => withUser(request, async (user) =>
+      privateJson(await getLevel(db(), user.id))),
+
+    libraryGet: (request: Request) => withUser(request, async (user) => {
+      const items = await listLibrary(db(), user.id);
+      return privateJson({ items });
+    }),
+
+    libraryPut: (request: Request, params: { mangaId: string }) => withUser(request, async (user) => {
+      const mangaId = parseResourceId(params.mangaId, "mangaId");
+      const input = parseLibraryInput(await readJson(request));
+      const item = await putLibrary(db(), user.id, mangaId, input, now());
+      return privateJson({ item });
+    }, true),
+
+    libraryDelete: (request: Request, params: { mangaId: string }) => withUser(request, async (user) => {
+      const mangaId = parseResourceId(params.mangaId, "mangaId");
+      const deleted = await deleteLibrary(db(), user.id, mangaId);
+      if (!deleted) return privateJson(errorEnvelope("NOT_FOUND", "Library entry not found."), 404);
+      return privateJson({ deleted: true });
+    }, true),
+
+    progressGet: (request: Request) => withUser(request, async (user) => {
+      const items = await listProgress(db(), user.id);
+      return privateJson({ items });
+    }),
+
+    progressPut: (request: Request, params: { chapterId: string }) => withUser(request, async (user) => {
+      const chapterId = parseResourceId(params.chapterId, "chapterId");
+      const input = parseProgressInput(await readJson(request));
+      const item = await putProgress(db(), user.id, chapterId, input, now());
+      return privateJson({ item });
+    }, true),
+
+    progressDelete: (request: Request, params: { chapterId: string }) => withUser(request, async (user) => {
+      const chapterId = parseResourceId(params.chapterId, "chapterId");
+      const query = new URL(request.url).searchParams;
+      const mangaId = parseResourceId(query.get("mangaId"), "mangaId");
+      const rawLanguage = query.get("lang");
+      if (!rawLanguage) throw new ValidationError(400, "INVALID_INPUT", "lang is required to delete progress.");
+      const language = parseLanguage(rawLanguage);
+      const deleted = await deleteProgress(db(), user.id, chapterId, mangaId, language);
+      if (!deleted) return privateJson(errorEnvelope("NOT_FOUND", "Progress entry not found."), 404);
+      return privateJson({ deleted: true });
+    }, true),
+
+    settingsGet: (request: Request) => withUser(request, async (user) => {
+      const settings = await getSettings(db(), user.id);
+      return privateJson(settings);
+    }),
+
+    settingsPut: (request: Request) => withUser(request, async (user) => {
+      const settings = parseSettingsInput(await readJson(request));
+      return privateJson(await putSettings(db(), user.id, settings, now()));
+    }, true),
+
+    importPost: (request: Request) => withUser(request, async (user) => {
+      const body = await readJson(request);
+      const timestamp = now();
+      const payload = parseImportPayload(body, timestamp);
+      // The bounded timestamp is enforced per item; this is a defensive check
+      // that the server clock itself is usable.
+      if (boundedClientTime(timestamp, timestamp) === null) {
+        throw new ValidationError(400, "INVALID_INPUT", "Server timestamp is invalid.");
+      }
+      const summary = await importGuest(db(), user.id, payload, timestamp);
+      return privateJson(summary);
+    }, true),
+  };
+}
+
+export function resolveSessionIdentity(data: unknown): AccountIdentity | null {
+  return identityFromSession(data);
+}
+
+function readOperatorAllowlist(env: NodeJS.ProcessEnv = process.env): string[] {
+  return (env.OPERATOR_EMAIL_ALLOWLIST ?? "")
+    .split(",")
+    .map((email) => email.trim().toLowerCase())
+    .filter(Boolean);
+}
+
+/// Production wiring only: the user id comes from the real managed-auth
+/// session cookie, never from a header or request body.
+export function productionMeApi() {
+  return createMeApi({
+    db: () => getDatabase(),
+    identity: async () => {
+      try {
+        const { data, error } = await getAuth().getSession();
+        if (error) return null;
+        return identityFromSession(data);
+      } catch (error) {
+        if (error instanceof AuthConfigurationError) throw error;
+        throw new ServiceError(503, "AUTH_UNAVAILABLE", "Managed authentication is temporarily unavailable.");
+      }
+    },
+    now: () => Date.now(),
+    allowlist: readOperatorAllowlist(),
+  });
+}
+
+export async function wrapMeRoute(
+  run: (api: ReturnType<typeof createMeApi>, request: Request) => Promise<Response>,
+  request: Request,
+): Promise<Response> {
+  return withObservedRoute("account", request, async () => {
+    try {
+      return await run(productionMeApi(), request);
+    } catch (error) {
+      return errorToResponse(error);
+    }
+  });
+}
diff --git a/web/lib/me/service.ts b/web/lib/me/service.ts
new file mode 100644
index 0000000..e0eed2e
--- /dev/null
+++ b/web/lib/me/service.ts
@@ -0,0 +1,481 @@
+import "server-only";
+
+import { and, desc, eq, sql } from "drizzle-orm";
+import type { AppDatabase } from "../db/client";
+import * as tables from "../db/schema";
+import type { AccountIdentity } from "../auth/identity";
+import { roleFromVerifiedAllowlist } from "../validators";
+import type {
+  ImportHistoryItem,
+  ImportLibraryItem,
+  LibraryInput,
+  ProgressInput,
+  ReaderSettingsDto,
+} from "../validators";
+import { mergeLibrary, mergeProgress } from "../merge";
+import { levelFromXp, progressionForXp, realmForLevel } from "../progression";
+
+export class ServiceError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, code: string, message: string) {
+    super(message);
+    this.name = "ServiceError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+function uniqueViolation(error: unknown): boolean {
+  if (!error || typeof error !== "object") return false;
+  const code = "code" in error ? String((error as { code: unknown }).code) : "";
+  const message = `${"message" in error ? String((error as { message: unknown }).message) : ""} ${
+    "cause" in error && error.cause && typeof error.cause === "object" && "message" in error.cause
+      ? String((error.cause as { message: unknown }).message)
+      : ""
+  }`;
+  return code === "23505" || /duplicate key|unique constraint/i.test(message);
+}
+
+function date(ms: number): Date {
+  return new Date(Number.isFinite(ms) ? ms : Date.now());
+}
+
+const excluded = (column: string) => sql.raw(`excluded."${column}"`);
+
+export type ProfileDto = {
