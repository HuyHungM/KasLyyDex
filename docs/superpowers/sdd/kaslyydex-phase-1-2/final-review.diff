+    mangaId: MANGA_ID, chapterId, lang: "vi", chapter: "1", title: "Chương 1", coverFile: null,
+    page, total: 4, maxPage: page, lastReadAt: Date.now(), revision: 1,
+  };
+}
+
+test("restore failure exposes a retry that applies the server page", async () => {
+  const { context, page } = await signedInContext();
+  const puts = [];
+  let attempts = 0;
+  let failOnce = true;
+  await context.route("**/api/v1/me/progress", async (route) => {
+    attempts += 1;
+    if (failOnce && attempts === 1) {
+      failOnce = false;
+      await route.fulfill({ status: 503, contentType: "application/json", body: '{"error":{"code":"INTERNAL_ERROR","message":"fixture failure","details":{}}}' });
+      return;
+    }
+    await route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify({ items: [progressItem(CHAPTER_A, 3)] }) });
+  });
+  await context.route("**/api/v1/me/progress/**", async (route) => {
+    if (route.request().method() === "PUT") puts.push(JSON.parse(route.request().postData() ?? "{}"));
+    await route.fulfill({ status: 200, contentType: "application/json", body: "{}" });
+  });
+  await page.goto(`${baseUrl}/read/${CHAPTER_A}?manga=${MANGA_ID}&lang=vi`);
+  const retry = page.getByRole("button", { name: "Thử lại đồng bộ" });
+  await retry.waitFor({ timeout: 10_000 });
+  assert.equal(puts.length, 0, "no write after a failed restore");
+  await retry.click();
+  await waitFor(() => puts.length > 0);
+  assert.equal(puts[0].page, 3);
+  assert.match(await page.locator(".reader-page-count").textContent(), /Trang 3\/4/);
+  await context.close();
+});
+
+test("a follow click during session loading is not written to guest storage", async () => {
+  const { context, page } = await signedInContext();
+  const libraryPuts = [];
+  await context.route("**/api/v1/me/library/**", async (route) => {
+    if (route.request().method() === "PUT") libraryPuts.push(route.request().postData());
+    await route.fulfill({ status: 200, contentType: "application/json", body: "{}" });
+  });
+  await context.route("**/api/auth/get-session", async (route) => {
+    await delay(1500);
+    await route.continue();
+  });
+  await page.goto(`${baseUrl}/manga/${MANGA_ID}`);
+  const follow = page.locator("button[aria-pressed]");
+  await follow.waitFor();
+  assert.equal(await follow.isDisabled(), true, "follow must be gated until the session resolves");
+  await follow.evaluate((button) => button.click());
+  assert.equal(await page.evaluate(() => localStorage.getItem("truyenviet:library")), null, "early click must not write guest data");
+  assert.equal(libraryPuts.length, 0);
+  await page.waitForFunction(() => !document.querySelector("button[aria-pressed]")?.disabled, null, { timeout: 10_000 });
+  await follow.click();
+  await delay(300);
+  assert.ok(libraryPuts.length >= 1, "after resolution the synced API must be used");
+  await context.close();
+});
+
+test("reader sync fixes produced no page errors", () => {
+  assert.deepEqual(pageErrors, []);
+});
diff --git a/web/scripts/reader-sync.test.mjs b/web/scripts/reader-sync.test.mjs
new file mode 100644
index 0000000..e265fa8
--- /dev/null
+++ b/web/scripts/reader-sync.test.mjs
@@ -0,0 +1,58 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+// Pure coordinator used by ReaderClient. It owns restoration generations and
+// the "ready to write" gate; the browser test covers the visible retry UI.
+const { ReaderRestoreCoordinator } = await import("../lib/reader-sync.ts");
+
+test("delayed restore gates the first progress PUT until server page is applied", () => {
+  const coordinator = new ReaderRestoreCoordinator();
+  const key = "chapter-a|vi|opaque-user";
+  const generation = coordinator.begin(key);
+
+  // The GET is still in flight: a PUT must not be allowed, even if page state
+  // already exists locally.
+  assert.equal(coordinator.isReady(key), false);
+  assert.equal(coordinator.resolve(generation + 99, key), null, "stale generation cannot unlock writes");
+
+  // Simulate the delayed GET arriving later with the server page.
+  assert.equal(coordinator.resolve(generation, key), key);
+  assert.equal(coordinator.isReady(key), true);
+  assert.equal(coordinator.isReady("chapter-a|vi|other-user"), false);
+});
+
+test("a slow chapter A response is ignored after navigating to chapter B", () => {
+  const coordinator = new ReaderRestoreCoordinator();
+  const a = "chapter-a|vi|opaque-user";
+  const b = "chapter-b|vi|opaque-user";
+  const first = coordinator.begin(a);
+  assert.equal(coordinator.begin(b), first + 1);
+
+  assert.equal(coordinator.resolve(first, a), null, "chapter A must not unlock chapter B");
+  assert.equal(coordinator.isReady(a), false);
+  assert.equal(coordinator.resolve(first + 1, b), b);
+  assert.equal(coordinator.isReady(b), true);
+});
+
+test("failed restore clears the settle key so a retry can write", () => {
+  const coordinator = new ReaderRestoreCoordinator();
+  const key = "chapter-a|vi|opaque-user";
+  const first = coordinator.begin(key);
+  assert.equal(coordinator.fail(first, key), true);
+  assert.equal(coordinator.isReady(key), false);
+
+  const retry = coordinator.begin(key);
+  assert.equal(retry, first + 1);
+  assert.equal(coordinator.resolve(first, key), null);
+  assert.equal(coordinator.resolve(retry, key), key);
+});
+
+test("responses after cleanup cannot revive a disposed reader session", () => {
+  const coordinator = new ReaderRestoreCoordinator();
+  const key = "chapter-a|vi|opaque-user";
+  const generation = coordinator.begin(key);
+  coordinator.dispose();
+  assert.equal(coordinator.resolve(generation, key), null);
+  assert.equal(coordinator.fail(generation, key), false);
+  assert.equal(coordinator.isReady(key), false);
+});
