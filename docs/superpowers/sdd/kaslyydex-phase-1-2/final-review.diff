+  PAGES.forEach((url, index) => seed(url, PAGE_BYTES[index]));
+  COVERS.forEach((url, index) => {
+    const key = createHash("sha256").update(url).digest("hex");
+    writeFileSync(join(cacheDir, `${key}.jpg`), coverJpg(index === 0 ? 256 : 512));
+  });
+
+  const manga = {
+    id: MANGA_ID,
