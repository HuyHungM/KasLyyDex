+"use client";
+
+import Link from "next/link";
+import { useEffect, useSyncExternalStore, useState } from "react";
+import { coverImageUrl, type LibraryEntryDto } from "@/lib/contracts";
+import { accountMutate, useAccountSession, useRemoteResource } from "@/lib/account/client";
+import { refreshChapterNotifications } from "@/lib/community/client";
+import { getLibrary, subscribe, toggleLibrary, type GuestLibraryEntry } from "@/lib/guest";
+
+const EMPTY: GuestLibraryEntry[] = [];
+
+function LocalLibrary() {
+  const library = useSyncExternalStore(subscribe, getLibrary, () => EMPTY);
+  if (library.length === 0) return <EmptyLibrary />;
+  return (
+    <div className="shelf-grid">
+      {library.map((entry) => (
+        <div key={entry.mangaId} className="surface shelf-card">
+          <Link href={`/manga/${encodeURIComponent(entry.mangaId)}`} className="shelf-story">
+            <div className="card-cover">
+              {entry.coverFile ? (
+                <img src={coverImageUrl({ id: entry.mangaId, cover_file: entry.coverFile }) ?? ""} alt="" loading="lazy" />
+              ) : (
+                <div className="no-cover" aria-hidden="true">Chưa có bìa</div>
+              )}
+            </div>
+            <div>
+              <strong>{entry.title}</strong>
+              <p className="cc-ch">{entry.lastChapterId ? `Chương mới: ${entry.lastChapterId}` : "Chưa đọc"}</p>
+            </div>
+          </Link>
+          <div className="actions">
+            <button
+              type="button"
+              className="btn"
+              onClick={() => toggleLibrary({ mangaId: entry.mangaId, title: entry.title, coverFile: entry.coverFile, lang: entry.lang })}
+            >
+              Bỏ theo dõi
+            </button>
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function EmptyLibrary() {
+  return (
+    <div className="surface empty">
+      <h2>Tủ truyện còn trống</h2>
+      <p>Thêm truyện từ trang chi tiết để theo dõi chương mới và đọc tiếp tại đây.</p>
+      <Link href="/" className="btn btn-primary">Khám phá truyện</Link>
+    </div>
+  );
+}
+
+function SyncedLibrary() {
+  const { session } = useAccountSession();
+  const identityKey = session.user?.id ?? "guest";
+  const remote = useRemoteResource<{ items: LibraryEntryDto[] }>(
+    "/api/v1/me/library",
+    identityKey,
+  );
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [partialWarning, setPartialWarning] = useState(false);
+  useEffect(() => {
+    // Opening the synced library is an explicit on-demand chapter check.
+    let alive = true;
+    void refreshChapterNotifications()
+      .then((result) => { if (alive) setPartialWarning(result.partial === true); })
+      .catch(() => { if (alive) setPartialWarning(false); });
+    return () => { alive = false; };
+  }, [identityKey]);
+
+  if (remote.loading && !remote.data) return <div className="surface account-card">Đang tải tủ truyện…</div>;
+  if (remote.error || !remote.data) {
+    return <div className="surface account-card" role="alert"><p>{remote.error ?? "Không tải được tủ truyện."}</p><button type="button" className="btn" onClick={remote.reload}>Thử lại</button></div>;
+  }
+  if (remote.data.items.length === 0) return <EmptyLibrary />;
+  return (
+    <>
+      {error ? <p className="account-error" role="alert">{error}</p> : null}
+      {partialWarning ? (
+        <p className="account-error" role="status">
+          Cảnh báo: thông báo chương có thể chưa đầy đủ do giới hạn nhà cung cấp.
+        </p>
+      ) : null}
+      <div className="shelf-grid">
+        {remote.data.items.map((entry) => (
+          <div key={entry.mangaId} className="surface shelf-card">
+            <Link href={`/manga/${encodeURIComponent(entry.mangaId)}`} className="shelf-story">
+              <div className="card-cover">
+                {entry.coverFile ? (
+                  <img src={coverImageUrl({ id: entry.mangaId, cover_file: entry.coverFile }) ?? ""} alt="" loading="lazy" />
+                ) : (
+                  <div className="no-cover" aria-hidden="true">Chưa có bìa</div>
+                )}
+              </div>
+              <div>
+                <strong>{entry.title}</strong>
+                <p className="cc-ch">{entry.lastChapterId ? `Chương mới: ${entry.lastChapterId}` : "Chưa đọc"}</p>
+              </div>
+            </Link>
+            <div className="actions">
+              <button
+                type="button"
+                className="btn"
+                disabled={busy === entry.mangaId}
+                onClick={async () => {
+                  setBusy(entry.mangaId);
+                  setError(null);
+                  try {
+                    await accountMutate(`/api/v1/me/library/${encodeURIComponent(entry.mangaId)}`, "DELETE");
+                    remote.reload();
+                  } catch (cause) {
+                    setError(cause instanceof Error ? cause.message : "Không bỏ theo dõi được.");
+                  } finally {
+                    setBusy(null);
+                  }
+                }}
+              >
+                {busy === entry.mangaId ? "Đang xóa…" : "Bỏ theo dõi"}
+              </button>
+            </div>
+          </div>
+        ))}
+      </div>
+    </>
+  );
+}
+
+export default function LibraryView() {
+  const { session } = useAccountSession();
+  if (session.status === "authenticated") return <SyncedLibrary />;
+  return <LocalLibrary />;
+}
diff --git a/web/components/manga-actions.tsx b/web/components/manga-actions.tsx
new file mode 100644
index 0000000..8723876
--- /dev/null
+++ b/web/components/manga-actions.tsx
@@ -0,0 +1,89 @@
+"use client";
+
+import Link from "next/link";
+import { useState, useSyncExternalStore } from "react";
+import type { LibraryEntryDto, ProgressEntryDto } from "@/lib/contracts";
+import { chapterLabel } from "@/lib/format";
+import { useAccountSession, useRemoteResource, accountMutate } from "@/lib/account/client";
+import {
+  getHistory, getLibrary, subscribe, toggleLibrary, type GuestHistory, type GuestLibraryEntry,
+} from "@/lib/guest";
+
+type Props = {
+  mangaId: string;
+  title: string;
+  coverFile: string | null;
+  lang: string;
+  firstChapterId: string | null;
+  firstChapterLabel: string;
+  hasExternal?: boolean;
+};
+
+const NO_HISTORY: GuestHistory[] = [];
+const NO_LIBRARY: GuestLibraryEntry[] = [];
+
+export default function MangaActions({ mangaId, title, coverFile, lang, firstChapterId, firstChapterLabel, hasExternal }: Props) {
+  const history = useSyncExternalStore(subscribe, getHistory, () => NO_HISTORY);
+  const library = useSyncExternalStore(subscribe, getLibrary, () => NO_LIBRARY);
+  const { session } = useAccountSession();
+  const authed = session.status === "authenticated";
+  // While the session is unresolved (or errored), neither guest nor synced
+  // writes are safe. An explicit unconfigured auth state is a real guest.
+  const resolved = authed || session.status === "guest" || session.status === "unconfigured";
+  const useLocal = session.status === "guest" || session.status === "unconfigured";
+  const identity = session.user?.id ?? "guest";
+  const remoteLibrary = useRemoteResource<{ items: LibraryEntryDto[] }>(authed ? "/api/v1/me/library" : null, identity);
+  const remoteProgress = useRemoteResource<{ items: ProgressEntryDto[] }>(authed ? "/api/v1/me/progress" : null, identity);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const localResume = useLocal ? history.find((entry) => entry.mangaId === mangaId) : null;
+  const remoteResume = remoteProgress.data?.items.find((entry) => entry.mangaId === mangaId) ?? null;
+  const resume = authed && remoteResume
+    ? { chapterId: remoteResume.chapterId, lang: remoteResume.lang, chapter: remoteResume.chapter }
+    : localResume;
+  const followed = authed
+    ? Boolean(remoteLibrary.data?.items.some((entry) => entry.mangaId === mangaId))
+    : useLocal && library.some((entry) => entry.mangaId === mangaId);
+
+  async function toggleFollow() {
+    if (!resolved) return;
+    if (!authed) {
+      toggleLibrary({ mangaId, title, coverFile, lang });
+      return;
+    }
+    setBusy(true);
+    setError(null);
+    try {
+      const url = `/api/v1/me/library/${encodeURIComponent(mangaId)}`;
+      if (followed) await accountMutate(url, "DELETE");
+      else await accountMutate(url, "PUT", { title, coverFile, lang, status: "reading" });
+      remoteLibrary.reload();
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Không cập nhật được tủ truyện.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="actions">
+      {firstChapterId ? (
+        <Link href={`/read/${firstChapterId}?manga=${encodeURIComponent(mangaId)}&lang=${lang}`} className="btn btn-primary">
+          Đọc từ đầu · {firstChapterLabel}
+        </Link>
+      ) : (
+        <span className="btn btn-disabled">{hasExternal ? "Chapter chỉ có ở nguồn ngoài" : "Chưa có chapter"}</span>
+      )}
+      {resume && (
+        <Link href={`/read/${encodeURIComponent(resume.chapterId)}?manga=${encodeURIComponent(mangaId)}&lang=${encodeURIComponent(resume.lang)}`} className="btn">
+          Đọc tiếp · {chapterLabel(resume.chapter)}
+        </Link>
+      )}
+      <button type="button" className="btn" aria-pressed={followed} disabled={busy || !resolved} onClick={() => void toggleFollow()}>
+        {!resolved ? "Đang xác định phiên…" : followed ? "✓ Đang theo dõi" : "+ Thêm vào tủ truyện"}
+      </button>
+      {error ? <span className="account-error" role="alert">{error}</span> : null}
+    </div>
+  );
+}
diff --git a/web/components/manga-card.tsx b/web/components/manga-card.tsx
new file mode 100644
