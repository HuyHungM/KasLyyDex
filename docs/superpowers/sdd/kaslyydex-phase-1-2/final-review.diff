+
+function parsePublish(value: string): number | null {
+  if (typeof value !== "string") return null;
+  const parsed = Date.parse(value);
+  return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
+}
+
+type FeedCandidate = {
+  id: string;
+  published: number;
+  chapter: string | null;
+  title: string;
+};
+
+// Raw string comparison, not localeCompare: the replay queue must not depend
+// on ICU/locale behaviour between workers.
+function compareCandidates(a: { id: string; published: number }, b: { id: string; published: number }): number {
+  if (a.published !== b.published) return a.published - b.published;
+  return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
+}
+
+function capOffset(offset: number): number {
+  return Math.min(Math.max(0, offset), UPSTREAM_OFFSET_LIMIT - NOTIFICATION_FEED_LIMIT);
+}
+
+/// On-demand only. Equal publish timestamps are reconciled through a persisted
+/// pending queue, because upstream id order is undocumented and offset shifts
+/// make local-rank offsets unsafe. Replaying overlapping pages with SQL
+/// deduplication is intentional; completeness under adversarial live offset
+/// shifts is not claimed and is surfaced as `partial`.
+export async function refreshFollowedChapters(
+  db: Db,
+  userId: string,
+  content: ContentClient,
+  now: number,
+): Promise<{ checked: number; created: number; skipped: boolean; partial: boolean }> {
+  return db.transaction(async (tx) => {
+    const acquired = await tx.execute(sql`select pg_try_advisory_xact_lock(hashtext(${'chapter-refresh:' + userId})) as acquired`);
+    const result = acquired as unknown as { rows?: Array<{ acquired: boolean }> };
+    const rows = result.rows ?? [];
+    if (rows[0]?.acquired === false) {
+      return { checked: 0, created: 0, skipped: true, partial: false };
+    }
+
+    const followed = await tx.select({
+      mangaId: tables.libraryEntries.mangaId,
+      title: tables.libraryEntries.title,
+    }).from(tables.libraryEntries)
+      .where(and(eq(tables.libraryEntries.userId, userId), ne(tables.libraryEntries.status, "dropped")))
+      .orderBy(desc(tables.libraryEntries.followedAt))
+      .limit(LIBRARY_SCAN_LIMIT);
+
+    let created = 0;
+    let partial = false;
+
+    for (const entry of followed) {
+      for (const language of ["vi", "en"] as const) {
+        const cursorWhere = and(
+          eq(tables.notificationCursors.userId, userId),
+          eq(tables.notificationCursors.mangaId, entry.mangaId),
+          eq(tables.notificationCursors.language, language),
+        );
+        const pendingWhere = and(
+          eq(tables.notificationPending.userId, userId),
+          eq(tables.notificationPending.mangaId, entry.mangaId),
+          eq(tables.notificationPending.language, language),
+        );
+        const loadCursor = async () =>
+          (await tx.select().from(tables.notificationCursors).where(cursorWhere).limit(1))[0];
+        const cursor = await loadCursor();
+
+        if (!cursor) {
+          let page;
+          try {
+            // Descending publication order reaches the latest chapter even in a
+            // catalog far past the old 2000-item list cap.
+            page = await content.notificationFeed(entry.mangaId, {
+              lang: language, offset: 0, limit: NOTIFICATION_FEED_LIMIT,
+            });
+          } catch {
+            continue;
+          }
+          if (page.partial) partial = true;
+          const fresh = page.items
+            .map((item) => {
+              const published = parsePublish(item.publish_at);
+              return published !== null && published <= now + MAX_CHAPTER_AGE_MS
+                ? { id: item.id, published } : null;
+            })
+            .filter((value): value is { id: string; published: number } => value !== null)
+            .sort(compareCandidates)
+            .at(-1);
+          if (!fresh) continue;
+          await tx.insert(tables.notificationCursors).values({
+            userId, mangaId: entry.mangaId, language,
+            lastPublish: fresh.published, lastChapterId: fresh.id,
+            scanPublish: fresh.published, scanOffset: 0, updatedAt: date(now),
+          });
+          continue;
+        }
+
+        const alreadyNotified = async (chapterId: string): Promise<boolean> => {
+          const eventKey = `chapter:${userId}:${entry.mangaId}:${chapterId}:${language}`;
+          const rows = await tx.select({ id: tables.notifications.id })
+            .from(tables.notifications)
+            .where(and(eq(tables.notifications.userId, userId), eq(tables.notifications.eventKey, eventKey)))
+            .limit(1);
+          return rows.length > 0;
+        };
+
+        // Collect one timestamp cohort into the replay queue. Upstream id order
+        // is irrelevant: every observed row is stored by chapter id (PK), and a
+        // one-page overlap reconciles rows inserted between earlier pages.
+        const collectCohort = async (
+          current: typeof cursor,
+          cohortPublish: number,
+          initialPage: Awaited<ReturnType<ContentClient["notificationFeed"]>> | null,
+        ): Promise<{ offset: number; complete: boolean; failed: boolean }> => {
+          let offset = initialPage ? initialPage.offset : capOffset(current.scanOffset - NOTIFICATION_FEED_LIMIT);
+          let complete = false;
+          let expectedTotal: number | null = null;
+          for (let used = 0; used < COLLECTION_PAGES_PER_REFRESH && !complete; used += 1) {
+            let page = initialPage;
+            if (used > 0 || !page) {
+              try {
+                page = await content.notificationFeed(entry.mangaId, {
+                  lang: language,
+                  since: new Date(current.scanPublish).toISOString(),
+                  offset,
+                  limit: NOTIFICATION_FEED_LIMIT,
+                });
+              } catch {
+                return { offset: current.scanOffset, complete: false, failed: true };
+              }
+            }
+            if (page.partial || (page.total > UPSTREAM_OFFSET_LIMIT
+              && offset + NOTIFICATION_FEED_LIMIT >= UPSTREAM_OFFSET_LIMIT)) partial = true;
+            if (page.offset !== offset || (expectedTotal !== null && page.total !== expectedTotal)) {
+              // Provider pagination shifted while scanning; replay will reconcile
+              // overlaps, but the scan cannot be claimed complete.
+              partial = true;
+            }
+            expectedTotal = page.total;
+
+            for (const item of page.items) {
+              const published = parsePublish(item.publish_at);
+              if (published === null || published < cohortPublish) continue;
+              if (published > cohortPublish) {
+                complete = true;
+                continue;
+              }
+              if (published > now + MAX_CHAPTER_AGE_MS) continue; // future rows stay eligible
+              if (await alreadyNotified(item.id)) continue;
+              await tx.insert(tables.notificationPending).values({
+                userId, mangaId: entry.mangaId, language,
+                chapterId: item.id, publish: published,
+                chapter: item.chapter, title: item.title,
+              }).onConflictDoNothing();
+            }
+            if (complete) break;
+            if (page.items.length === 0) {
+              complete = true;
+              break;
+            }
+            const nextOffset = capOffset(offset + page.items.length);
+            if (nextOffset + NOTIFICATION_FEED_LIMIT >= UPSTREAM_OFFSET_LIMIT && page.total > UPSTREAM_OFFSET_LIMIT) {
+              break; // offset wall: keep the cohort open and report partial
+            }
+            if (nextOffset <= offset) break;
+            offset = nextOffset;
+            if (offset >= page.total) {
+              complete = true;
+              break;
+            }
+          }
+          return { offset, complete, failed: false };
+        };
+
+        const drainCohort = async (cohortPublish: number) => {
+          const batch = await tx.select().from(tables.notificationPending)
+            .where(and(pendingWhere, eq(tables.notificationPending.publish, cohortPublish)))
+            .orderBy(asc(tables.notificationPending.chapterId))
+            .limit(CHAPTERS_PER_MANGA);
+          for (const row of batch) {
+            const label = row.chapter ?? row.title ?? row.chapterId;
+            const emitted = await emitNotification(tx, {
+              userId,
+              type: "new_chapter",
+              eventKey: `chapter:${userId}:${entry.mangaId}:${row.chapterId}:${language}`,
+              title: "Chương mới",
+              body: `${entry.title} — Chương ${label} (${language})`,
+              href: `/read/${row.chapterId}?manga=${encodeURIComponent(entry.mangaId)}&lang=${language}`,
+            });
+            if (emitted) created += 1;
+            await tx.delete(tables.notificationPending).where(and(
+              pendingWhere,
+              eq(tables.notificationPending.chapterId, row.chapterId),
+            ));
+          }
+          if (batch.length > 0) {
+            await tx.update(tables.notificationCursors).set({
+              lastPublish: cohortPublish,
+              lastChapterId: batch.at(-1)!.chapterId,
+              updatedAt: date(now),
+            }).where(cursorWhere);
+          }
+          const remaining = await tx.select({ id: tables.notificationPending.chapterId })
+            .from(tables.notificationPending).where(pendingWhere).limit(1);
+          const current = await loadCursor();
+          if (remaining.length === 0 && current?.cohortComplete) {
+            await tx.update(tables.notificationCursors).set({
+              scanPublish: cohortPublish,
+              cohortPublish: null,
+              cohortComplete: false,
+              scanOffset: 0,
+              updatedAt: date(now),
+            }).where(cursorWhere);
+          }
+        };
+
+        if (cursor.cohortPublish !== null) {
+          const collected = await collectCohort(cursor, cursor.cohortPublish, null);
+          if (!collected.failed) {
+            await tx.update(tables.notificationCursors).set({
+              scanOffset: collected.offset,
+              cohortComplete: collected.complete,
+              updatedAt: date(now),
+            }).where(cursorWhere);
+          }
+          await drainCohort(cursor.cohortPublish);
+          continue;
+        }
+
+        const offset = capOffset(cursor.scanOffset);
+        let page;
+        try {
+          page = await content.notificationFeed(entry.mangaId, {
+            lang: language,
+            since: new Date(cursor.scanPublish).toISOString(),
+            offset,
+            limit: NOTIFICATION_FEED_LIMIT,
+          });
+        } catch {
+          // An upstream failure never moves the persisted continuation.
+          continue;
+        }
+        if (page.partial || (page.total > UPSTREAM_OFFSET_LIMIT
+          && offset + NOTIFICATION_FEED_LIMIT >= UPSTREAM_OFFSET_LIMIT)) partial = true;
+        const firstValid = page.items
+          .map((item) => {
+            const published = parsePublish(item.publish_at);
+            return published !== null && published <= now + MAX_CHAPTER_AGE_MS
+              ? {
+                id: item.id,
+                published,
+                chapter: item.chapter ?? null,
+                title: item.title ?? null,
+              }
+              : null;
+          })
+          .filter((value): value is FeedCandidate => value !== null)
+          .sort(compareCandidates)[0];
+        if (!firstValid) continue; // only future or invalid rows: remain revisitable
+
+        if (!(await alreadyNotified(firstValid.id))) {
+          await tx.insert(tables.notificationPending).values({
+            userId, mangaId: entry.mangaId, language,
+            chapterId: firstValid.id, publish: firstValid.published,
+            chapter: firstValid.chapter, title: firstValid.title,
+          }).onConflictDoNothing();
+        }
+        await tx.update(tables.notificationCursors).set({
+          cohortPublish: firstValid.published,
+          cohortComplete: false,
+          scanOffset: offset,
+          updatedAt: date(now),
+        }).where(cursorWhere);
+        const collected = await collectCohort(await loadCursor(), firstValid.published, page);
+        await tx.update(tables.notificationCursors).set({
+          scanOffset: collected.offset,
+          cohortComplete: collected.complete,
+          updatedAt: date(now),
+        }).where(cursorWhere);
+        await drainCohort(firstValid.published);
+      }
+    }
+    return { checked: followed.length, created, skipped: false, partial };
+  });
+}
diff --git a/web/lib/observability.ts b/web/lib/observability.ts
new file mode 100644
index 0000000..c7a21b5
--- /dev/null
+++ b/web/lib/observability.ts
@@ -0,0 +1,171 @@
+import "server-only";
+
+import { AsyncLocalStorage } from "node:async_hooks";
+import { randomUUID } from "node:crypto";
+import { metric } from "@vercel/functions";
+
+// Bounded label vocabulary. Never derive these from request paths, users or
+// upstream error strings: metric labels must stay low-cardinality and PII-free.
+export const OBSERVED_OPERATIONS = ["auth", "account", "community", "progression"] as const;
+export type ObservedOperation = (typeof OBSERVED_OPERATIONS)[number];
+
+const correlation = new AsyncLocalStorage<string>();
+
+// Longer names first so `set-cookie` wins over `cookie` and forwarded headers
+// win over plain `authorization`. Headers may use `:`/`=` or whitespace before
+// an auth scheme / cookie pair; generic fields need a real `:`/`=` separator so
+// ordinary prose such as "This ticket belongs to another account" survives.
+const HEADER_FIELDS = [
+  "x-forwarded-authorization",
+  "proxy-authorization",
+  "authorization",
+  "set-cookie",
+  "cookie",
+];
+const GENERIC_FIELDS = [
+  "connection-string",
+  "connection_string",
+  "database-url",
+  "database_url",
+  "upstream-key",
+  "upstream_key",
+  "api-key",
+  "api_key",
+  "password",
+  "passwd",
+  "pwd",
+  "secret",
+  "ticket",
+  "token",
+  "email",
+  "code",
+];
+const FIELD_PATTERN = [...HEADER_FIELDS, ...GENERIC_FIELDS].join("|");
+const HEADER_SEPARATOR = String.raw`(?:\s*[:=]\s*|\s+(?:(?=(?:Bearer|Basic)\b)|(?=[A-Za-z0-9_.%-]+=)))`;
+const GENERIC_SEPARATOR = String.raw`\s*[:=]\s*`;
+// Stop at a closing quote, line end, or the next known credential field. For
+// Cookie/Set-Cookie this redacts the whole header (every k=v pair), not just
+// the first value. `&` handles URL query strings such as ?code=...&token=...
+const VALUE_BOUNDARY = String.raw`(?=\s*(?:"|'|$|[\r\n]|[,;|&]\s*(?:${FIELD_PATTERN})(?:${HEADER_SEPARATOR}|${GENERIC_SEPARATOR})|\s+(?:${FIELD_PATTERN})(?:${HEADER_SEPARATOR}|${GENERIC_SEPARATOR})))`;
+const VALUE_PATTERN = String.raw`(?:"[^"]*"|'[^']*'|[^\r\n"']*?)`;
+const HEADER_PATTERN = new RegExp(
+  String.raw`\b(${HEADER_FIELDS.join("|")})${HEADER_SEPARATOR}${VALUE_PATTERN}${VALUE_BOUNDARY}`,
+  "gi",
+);
+const GENERIC_PATTERN = new RegExp(
+  String.raw`\b(${GENERIC_FIELDS.join("|")})${GENERIC_SEPARATOR}${VALUE_PATTERN}${VALUE_BOUNDARY}`,
+  "gi",
+);
+
+function redactValue(value: string): string {
+  return value
+    .replace(/postgres(?:ql)?:\/\/[^\s"'<>]+/gi, "[redacted-database-url]")
+    .replace(/\beyJ[A-Za-z0-9_-]{4,}\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b/g, "[redacted-token]")
+    .replace(/\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/g, "[redacted-email]")
+    .replace(HEADER_PATTERN, "$1=[redacted]")
+    .replace(GENERIC_PATTERN, "$1=[redacted]");
+}
+
+/// Shared redaction for structured logs. It never echoes raw headers, bodies,
+/// connection strings or credential-bearing query values.
+export function redactSecrets(value: unknown): string {
+  return redactValue(String(value ?? "")).slice(0, 2000);
+}
+
+type LogFields = Record<string, string | number | boolean | undefined>;
+
+export function logStructured(
+  level: "info" | "warn" | "error",
+  event: string,
+  fields: LogFields = {},
+): void {
+  const entry = JSON.stringify({
+    service: "kaslyydex-web",
+    ts: new Date().toISOString(),
+    level,
+    event,
+    correlationId: correlation.getStore() ?? "none",
+    ...fields,
+  });
+  // Defense in depth: even a future field that accidentally contains a header
+  // or body is redacted before it reaches the log sink.
+  const line = redactValue(entry);
+  if (level === "info") process.stdout.write(`${line}\n`);
+  else process.stderr.write(`${line}\n`);
+}
+
+/// Call from existing error-to-response helpers so error details are logged once
+/// in redacted form without adding them to the public error envelope.
+export function logErrorEvent(error: unknown): void {
+  const value = error as { name?: string; code?: string; message?: string };
+  logStructured("error", "error", {
+    errorName: typeof value?.name === "string" ? value.name.slice(0, 64) : "Error",
+    errorCode: typeof value?.code === "string" ? value.code.slice(0, 64) : undefined,
+    message: redactSecrets(value?.message ?? error),
+  });
+}
+
+export function outcomeFor(status: number): string {
+  if (status === 401) return "unauthenticated";
+  if (status === 403) return "forbidden";
+  if (status === 404) return "not_found";
+  if (status === 409) return "conflict";
+  if (status === 429) return "rate_limited";
+  if (status === 503) return "unavailable";
+  if (status >= 500) return "server_error";
+  if (status >= 400) return "client_error";
+  if (status >= 200 && status < 300) return "success";
+  return "other";
+}
+
+function emitMetrics(operation: ObservedOperation, outcome: string, durationMs: number): void {
+  // Local and non-Vercel runtimes are a no-op. Ingestion stays unverified until
+  // an operator explicitly enables paid Observability; no project setting changes here.
+  const attributes = { operation, outcome };
+  metric("kaslyydex.user_requests", 1, attributes);
+  metric("kaslyydex.user_request.duration_ms", durationMs, attributes);
+}
+
+/// Structured request/error logs and bounded business-operation metrics. Health,
+/// static assets and pass-through content proxies deliberately do not use this.
+export async function withObservedRoute(
+  operation: ObservedOperation,
+  request: Request,
+  run: () => Promise<Response> | Response,
+): Promise<Response> {
+  const id = randomUUID();
+  const startedAt = performance.now();
+
+  return correlation.run(id, async () => {
+    let response: Response;
+    try {
+      response = await run();
+    } catch (error) {
+      const durationMs = Math.round(performance.now() - startedAt);
+      logErrorEvent(error);
+      logStructured("error", "request.complete", { operation, status: 500, durationMs });
+      emitMetrics(operation, "server_error", durationMs);
+      throw error;
+    }
+
+    const durationMs = Math.round(performance.now() - startedAt);
+    const outcome = outcomeFor(response.status);
+    logStructured(response.status >= 500 ? "error" : response.status >= 400 ? "warn" : "info",
+      "request.complete", {
+        operation,
+        method: request.method,
+        status: response.status,
+        durationMs,
+        outcome,
+      });
+    emitMetrics(operation, outcome, durationMs);
+
+    const headers = new Headers(response.headers);
+    headers.set("x-correlation-id", id);
+    return new Response(response.body, {
+      status: response.status,
+      statusText: response.statusText,
+      headers,
+    });
+  });
+}
diff --git a/web/lib/progression-api.ts b/web/lib/progression-api.ts
new file mode 100644
index 0000000..5776bd6
--- /dev/null
+++ b/web/lib/progression-api.ts
@@ -0,0 +1,477 @@
+import "server-only";
+
+import { randomUUID } from "node:crypto";
+import { and, asc, count, eq, gt, sql } from "drizzle-orm";
+import { SignJWT, jwtVerify } from "jose";
+import { getDatabase, type AppDatabase } from "./db/client";
+import * as tables from "./db/schema";
+import { AuthConfigurationError, getAuth } from "./auth/server";
+import { identityFromSession, type AccountIdentity } from "./auth/identity";
+import { serverContent } from "./content-server";
+import type { ContentClient } from "./contracts";
+import { errorEnvelope } from "./contracts";
+import { logErrorEvent, withObservedRoute } from "./observability";
+import { errorToResponse, privateJson } from "./me/handlers";
+import { ServiceError, ensureProfile } from "./me/service";
+import { emitNotification } from "./moderation";
+import { parseLanguage, parseResourceId, readJson, requireOrigin, ValidationError } from "./validators";
+import {
+  CHECKPOINT_LIMIT, MAX_PAGE_COUNT, PROGRESSION_RULE_VERSION,
+  READER_TICKET_TTL_SECONDS, XP_PER_CHAPTER, levelFromXp, minimumElapsedMs,
+  progressionForXp, requiredPages,
+} from "./progression";
+
+// Pooled and transaction databases share these calls; `$client` exists only on
+// the pooled handle, exactly as in the Task 7 moderation services.
+type Db = Omit<AppDatabase, "$client">;
+
+const ISSUER = "kaslyydex-reader";
+const AUDIENCE = "kaslyydex-reader";
+const COMPLETE_LIMIT = 10;
+const SESSION_LIMIT = 30;
+const WINDOW_MS = 60_000;
+const MAX_CHECKPOINT_PAGES = 500;
+const CONTENT_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export class TicketSecretError extends Error {
+  readonly code = "READER_TICKET_NOT_CONFIGURED";
+  readonly missing = ["READER_TICKET_SECRET"];
+  constructor(message = "Reader ticket signing secret is not configured.") {
+    super(message);
+    this.name = "TicketSecretError";
+  }
+}
+
+/// Missing or short secrets fail closed. No known default key exists and no
+/// request may provide one.
+export function readTicketSecret(env: NodeJS.ProcessEnv = process.env): string {
+  const secret = env.READER_TICKET_SECRET?.trim();
+  if (!secret || secret.length < 32) throw new TicketSecretError();
+  return secret;
+}
+
+function secretKey(secret: string): Uint8Array {
+  return new TextEncoder().encode(secret);
+}
+
+export type TicketClaims = {
+  sid: string;
+  sub: string;
+  cid: string;
+  mid: string;
+  lang: string;
+  pages: number;
+  iat: number;
+  exp: number;
+};
+
+export async function signTicket(secret: string, claims: TicketClaims): Promise<string> {
+  return new SignJWT({
+    sid: claims.sid, sub: claims.sub, cid: claims.cid, mid: claims.mid,
+    lang: claims.lang, pages: claims.pages,
+  })
+    .setProtectedHeader({ alg: "HS256" })
+    .setIssuedAt(claims.iat)
+    .setExpirationTime(claims.exp)
+    .setIssuer(ISSUER)
+    .setAudience(AUDIENCE)
+    .sign(secretKey(secret));
+}
+
+/// Verifies the HMAC, registered claims and our own claim shape. `now` is
+/// injected by the service factory only; production supplies Date.now().
+export async function verifyTicket(token: string, secret: string, nowMs: number): Promise<TicketClaims> {
+  let payload: Record<string, unknown>;
+  try {
+    const result = await jwtVerify(token, secretKey(secret), {
+      algorithms: ["HS256"],
+      issuer: ISSUER,
+      audience: AUDIENCE,
+      currentDate: new Date(nowMs),
+    });
+    payload = result.payload as Record<string, unknown>;
+  } catch {
+    throw new ServiceError(401, "INVALID_TICKET", "Reader session ticket is invalid or expired.");
+  }
+  const text = (key: string, max: number): string => {
+    const value = payload[key];
+    if (typeof value !== "string" || value.length === 0 || value.length > max) {
+      throw new ServiceError(401, "INVALID_TICKET", "Reader session ticket is invalid.");
+    }
+    return value;
+  };
+  const integer = (key: string): number => {
+    const value = payload[key];
+    if (!Number.isSafeInteger(value)) throw new ServiceError(401, "INVALID_TICKET", "Reader session ticket is invalid.");
+    return value as number;
+  };
+  const claims: TicketClaims = {
+    sid: text("sid", 200), sub: text("sub", 200), cid: text("cid", 200),
+    mid: text("mid", 200), lang: text("lang", 20), pages: integer("pages"),
+    iat: integer("iat"), exp: integer("exp"),
+  };
+  if (claims.pages < 1 || claims.pages > MAX_PAGE_COUNT
+    || claims.exp - claims.iat !== READER_TICKET_TTL_SECONDS || claims.exp * 1000 <= nowMs) {
+    throw new ServiceError(401, "INVALID_TICKET", "Reader session ticket is invalid or expired.");
+  }
+  return claims;
+}
+
+function date(ms: number): Date {
+  return new Date(Number.isFinite(ms) ? ms : Date.now());
+}
+
+function excluded(column: string) {
+  return sql.raw(`excluded."${column}"`);
+}
+
+function assertKeys(body: Record<string, unknown>, allowed: readonly string[]): void {
+  const unknown = Object.keys(body).filter((key) => !allowed.includes(key));
+  if (unknown.length > 0) {
+    throw new ValidationError(400, "INVALID_INPUT", `Unexpected field: ${unknown[0]}`);
+  }
+}
+
+/// Sliding window in SQL with a transaction-scoped advisory lock: no
+/// process-local counters, and rejected requests roll back with the caller.
+async function consumeRateLimit(
+  db: Db,
+  userId: string,
+  action: "reader_checkpoint" | "reader_complete" | "reader_session",
+  now: number,
+  max: number,
+): Promise<void> {
+  await db.execute(sql`select pg_advisory_xact_lock(hashtext(${"progression-rate:" + action + ":" + userId}))`);
+  await db.delete(tables.actionEvents).where(and(
+    eq(tables.actionEvents.userId, userId),
+    eq(tables.actionEvents.action, action),
+    sql`${tables.actionEvents.occurredAt} <= ${now - WINDOW_MS}`,
+  ));
+  await db.insert(tables.actionEvents).values({ id: randomUUID(), userId, action, occurredAt: now });
+  const rows = await db.select({ value: count() }).from(tables.actionEvents).where(and(
+    eq(tables.actionEvents.userId, userId),
+    eq(tables.actionEvents.action, action),
+    gt(tables.actionEvents.occurredAt, now - WINDOW_MS),
+  ));
+  if ((rows[0]?.value ?? 0) > max) {
+    throw new ServiceError(429, "RATE_LIMITED", "Too many reading requests. Try again shortly.");
+  }
+}
+
+type SessionRow = typeof tables.readerSessions.$inferSelect;
+
+async function loadSession(
+  db: Db,
+  claims: TicketClaims,
+  user: AccountIdentity,
+  now: number,
+): Promise<SessionRow> {
+  if (claims.sub !== user.id) throw new ServiceError(403, "INVALID_TICKET_OWNER", "This ticket belongs to another account.");
+  const rows = await db.select().from(tables.readerSessions)
+    .where(and(eq(tables.readerSessions.id, claims.sid), eq(tables.readerSessions.userId, user.id)))
+    .limit(1);
+  const session = rows[0];
+  if (!session) throw new ServiceError(401, "INVALID_TICKET", "Reader session no longer exists.");
+  if (session.chapterId !== claims.cid || session.mangaId !== claims.mid
+    || session.language !== claims.lang || session.pageCount !== claims.pages
+    || session.issuedAt !== claims.iat * 1000 || session.expiresAt !== claims.exp * 1000) {
+    throw new ServiceError(401, "INVALID_TICKET", "Ticket does not match the persisted session.");
+  }
+  if (session.expiresAt <= now) throw new ServiceError(401, "TICKET_EXPIRED", "Reader session has expired.");
+  return session;
+}
+
+async function observedPages(db: Db, sessionId: string): Promise<number[]> {
+  const rows = await db.select({ page: tables.readerCheckpoints.page })
+    .from(tables.readerCheckpoints)
+    .where(eq(tables.readerCheckpoints.sessionId, sessionId))
+    .orderBy(asc(tables.readerCheckpoints.page));
+  return rows.map((row) => row.page);
+}
+
+export type ProgressionDeps = {
+  db: () => AppDatabase;
+  identity: () => Promise<AccountIdentity | null>;
+  now: () => number;
+  content: () => ContentClient | Promise<ContentClient>;
+  secret: () => string;
+  allowlist?: readonly string[];
+  // Test harness only. Production never supplies it; no environment bypass.
+  hooks?: { beforeCommit?: (phase: string) => void | Promise<void> };
+};
+
+export function progressionErrorResponse(error: unknown): Response {
+  if (error instanceof TicketSecretError) {
+    logErrorEvent(error);
+    return privateJson(errorEnvelope(error.code, error.message, { service: "reader", missing: "READER_TICKET_SECRET" }), 503);
+  }
+  return errorToResponse(error);
+}
+
+export function createProgressionApi(deps: ProgressionDeps) {
+  async function withUser(request: Request, action: (user: AccountIdentity) => Promise<Response>): Promise<Response> {
+    try {
+      requireOrigin(request);
+      const user = await deps.identity();
+      if (!user) return privateJson(errorEnvelope("UNAUTHENTICATED", "Sign in before reading with an account."), 401);
+      deps.secret(); // fail closed before any upstream or database work
+      return await action(user);
+    } catch (error) {
+      return progressionErrorResponse(error);
+    }
+  }
+
+  return {
+    /// Authority comes from Axum's single-chapter entity plus the actual image
+    /// list, never from a client percentage or page count.
+    sessionPost: (request: Request) => withUser(request, async (user) => {
+      const body = await readJson(request, 2048);
+      assertKeys(body, ["chapterId", "mangaId", "lang"]);
+      const chapterId = parseResourceId(body.chapterId, "chapterId");
+      const mangaId = parseResourceId(body.mangaId, "mangaId");
+      if (!CONTENT_ID.test(chapterId) || !CONTENT_ID.test(mangaId)) {
+        throw new ValidationError(400, "INVALID_INPUT", "Content ids must be MangaDex UUIDs.");
+      }
+      const lang = parseLanguage(body.lang);
+      const now = deps.now();
+      const db = deps.db();
+      await ensureProfile(db, user, { now, allowlist: deps.allowlist ?? [] });
+      await db.transaction(async (tx) => {
+        await consumeRateLimit(tx, user.id, "reader_session", now, SESSION_LIMIT);
+      });
+
+      let metadata;
+      let images;
+      try {
+        const client = await deps.content();
+        [metadata, images] = await Promise.all([
+          client.chapterMetadata(chapterId),
+          client.pages(chapterId),
+        ]);
+      } catch {
+        throw new ServiceError(503, "CONTENT_METADATA_UNAVAILABLE", "Chapter metadata is temporarily unavailable.");
+      }
+      // A missing or malformed entity is never a ticket source.
+      if (typeof metadata?.id !== "string" || typeof metadata.manga_id !== "string"
+        || typeof metadata.lang !== "string" || typeof metadata.pages !== "number"
+        || typeof metadata.unavailable !== "boolean"
+        || (metadata.external_url !== null && typeof metadata.external_url !== "string")
+        || !Array.isArray(images?.pages)) {
+        throw new ServiceError(503, "CONTENT_METADATA_UNAVAILABLE", "Chapter metadata is incomplete.");
+      }
+      if (metadata.id !== chapterId || metadata.manga_id !== mangaId || metadata.lang !== lang) {
+        throw new ServiceError(409, "CONTENT_MISMATCH", "Chapter does not belong to this manga and language.");
+      }
+      if (metadata.unavailable || metadata.external_url
+        || !Number.isInteger(metadata.pages) || metadata.pages < 1 || metadata.pages > MAX_PAGE_COUNT
+        || images.pages.length === 0 || images.pages.length > MAX_PAGE_COUNT) {
+        throw new ServiceError(409, "CONTENT_UNAVAILABLE", "This chapter has no readable pages here.");
+      }
+      if (metadata.pages !== images.pages.length) {
+        throw new ServiceError(409, "CONTENT_MISMATCH", "Chapter page count differs from the image list.");
+      }
+
+      // Align to whole seconds so the JWT iat/exp match the persisted row.
+      const issuedAt = Math.floor(now / 1000) * 1000;
+      const session = {
+        id: randomUUID(), userId: user.id, chapterId, mangaId, language: lang,
+        pageCount: metadata.pages, issuedAt,
+        expiresAt: issuedAt + READER_TICKET_TTL_SECONDS * 1000,
+      };
+      await db.insert(tables.readerSessions).values({ ...session, createdAt: date(now) });
+      const ticket = await signTicket(deps.secret(), {
+        sid: session.id, sub: user.id, cid: chapterId, mid: mangaId, lang,
+        pages: session.pageCount,
+        iat: Math.floor(session.issuedAt / 1000), exp: Math.floor(session.expiresAt / 1000),
+      });
+      return privateJson({
+        ticket, sessionId: session.id, chapterId, mangaId, lang,
+        pageCount: session.pageCount, expiresAt: session.expiresAt,
+        requiredPages: requiredPages(session.pageCount),
+        minimumElapsedMs: minimumElapsedMs(session.pageCount),
+      });
+    }),
+
+    checkpointPost: (request: Request) => withUser(request, async (user) => {
+      const body = await readJson(request, 2048);
+      assertKeys(body, ["ticket", "pages", "lastPageSeen"]);
+      const token = body.ticket;
+      if (typeof token !== "string" || token.length > 4096) {
+        throw new ValidationError(400, "INVALID_INPUT", "ticket is required.");
+      }
+      const now = deps.now();
+      const claims = await verifyTicket(token, deps.secret(), now);
+      const session = await loadSession(deps.db(), claims, user, now);
+
+      let additions: number[];
+      if (body.pages !== undefined) {
+        if (!Array.isArray(body.pages) || body.pages.length > MAX_CHECKPOINT_PAGES
+          || body.pages.some((page) => !Number.isSafeInteger(page))) {
+          throw new ValidationError(400, "INVALID_INPUT", "pages must be a bounded array of page numbers.");
+        }
+        additions = body.pages as number[];
+      } else if (body.lastPageSeen !== undefined) {
+        // Legacy interface: a single observed page, never a visited range.
+        if (!Number.isSafeInteger(body.lastPageSeen)) {
+          throw new ValidationError(400, "INVALID_INPUT", "lastPageSeen must be a page number.");
+        }
+        additions = [body.lastPageSeen as number];
+      } else {
+        throw new ValidationError(400, "INVALID_INPUT", "pages is required.");
+      }
+      if (additions.some((page) => page < 1 || page > session.pageCount)) {
+        throw new ValidationError(400, "INVALID_INPUT", "Page is outside this chapter.");
+      }
+
+      return deps.db().transaction(async (tx) => {
+        await consumeRateLimit(tx, user.id, "reader_checkpoint", now, CHECKPOINT_LIMIT);
+        await tx.insert(tables.readerCheckpoints).values(
+          [...new Set(additions)].map((page) => ({ sessionId: session.id, page, seenAt: now })),
+        ).onConflictDoNothing();
+        const seen = await observedPages(tx, session.id);
+        const need = requiredPages(session.pageCount);
+        return privateJson({
+          sessionId: session.id, seenPages: seen, pageCount: session.pageCount,
+          requiredPages: need, complete: seen.length >= need,
+        });
+      });
+    }),
+
+    completePost: (request: Request) => withUser(request, async (user) => {
+      const body = await readJson(request, 2048);
+      assertKeys(body, ["ticket"]);
+      const token = body.ticket;
+      if (typeof token !== "string" || token.length > 4096) {
+        throw new ValidationError(400, "INVALID_INPUT", "ticket is required.");
+      }
+      const now = deps.now();
+      const claims = await verifyTicket(token, deps.secret(), now);
+      const session = await loadSession(deps.db(), claims, user, now);
+
+      return deps.db().transaction(async (tx) => {
+        await consumeRateLimit(tx, user.id, "reader_complete", now, COMPLETE_LIMIT);
+        // Serialize every chapter completion by the same account: concurrent
+        // sessions cannot read a stale total or emit duplicate level events.
+        await tx.execute(sql`select pg_advisory_xact_lock(hashtext(${"progression-profile:" + user.id}))`);
+        const seen = await observedPages(tx, session.id);
+        const need = requiredPages(session.pageCount);
+        if (seen.length < need) {
+          throw new ServiceError(409, "COVERAGE_INSUFFICIENT", "Not enough distinct pages were observed.");
+        }
+        if (now - session.issuedAt < minimumElapsedMs(session.pageCount)) {
+          throw new ServiceError(429, "TOO_FAST", "This chapter was completed too quickly.");
+        }
+        const lastPageSeen = Math.max(...seen);
+        await tx.insert(tables.chapterProgress).values({
+          userId: user.id, mangaId: session.mangaId, chapterId: session.chapterId,
+          language: session.language, chapter: null, title: null, coverFile: null,
+          page: lastPageSeen, maxPage: lastPageSeen, total: session.pageCount,
+          lastReadAt: now, revision: 1, updatedAt: date(now),
+        }).onConflictDoUpdate({
+          target: [
+            tables.chapterProgress.userId, tables.chapterProgress.mangaId,
+            tables.chapterProgress.chapterId, tables.chapterProgress.language,
+          ],
+          set: {
+            // `page` is the ordinary reread position owned by PUT /me/progress;
+            // completion evidence must never move it on conflict. Only the
+            // monotone max page consumes this session's observed last page.
+            maxPage: sql`greatest(${tables.chapterProgress.maxPage}, ${excluded("page")})`,
+            total: excluded("total"),
+            lastReadAt: sql`greatest(${tables.chapterProgress.lastReadAt} + 1, ${excluded("last_read_at")})`,
+            revision: sql`${tables.chapterProgress.revision} + 1`,
+            updatedAt: date(now),
+          },
+        });
+
+        const completion = await tx.insert(tables.readingCompletions).values({
+          userId: user.id, chapterId: session.chapterId, mangaId: session.mangaId,
+          language: session.language, pageCount: session.pageCount, lastPageSeen,
+          readerSessionId: session.id, completedAt: now,
+        }).onConflictDoNothing().returning({ userId: tables.readingCompletions.userId });
+
+        const profileRows = await tx.select({ totalXp: tables.profiles.totalXp, level: tables.profiles.level })
+          .from(tables.profiles).where(eq(tables.profiles.userId, user.id)).limit(1).for("update");
+        const before = profileRows[0];
+        if (!before) throw new ServiceError(404, "PROFILE_UNAVAILABLE", "Account profile is missing.");
+        let totalXp = before.totalXp;
+        let awarded = false;
+        if (completion.length > 0) {
+          const event = await tx.insert(tables.xpEvents).values({
+            id: randomUUID(), userId: user.id, eventType: "chapter_complete",
+            chapterId: session.chapterId, amount: XP_PER_CHAPTER,
+            ruleVersion: PROGRESSION_RULE_VERSION, createdAt: date(now),
+          }).onConflictDoNothing().returning({ id: tables.xpEvents.id });
+          if (event.length > 0) {
+            awarded = true;
+            totalXp += XP_PER_CHAPTER;
+            const level = levelFromXp(totalXp);
+            await tx.update(tables.profiles)
+              .set({ totalXp, level, updatedAt: date(now) })
+              .where(eq(tables.profiles.userId, user.id));
+            if (level > before.level) {
+              const snapshot = progressionForXp(totalXp);
+              await emitNotification(tx, {
+                userId: user.id, type: "level_up", eventKey: `level:${level}`,
+                title: `Đạt cấp ${level}`,
+                body: `Bạn đã đạt cấp ${level} · ${snapshot.title}.`,
+                href: "/tai-khoan",
+              });
+            }
+          }
+        }
+        // Old rows may predate the persisted level column; keep it consistent
+        // even on idempotent retries without minting another XP event.
+        const consistentLevel = levelFromXp(totalXp);
+        if (consistentLevel !== before.level && !awarded) {
+          await tx.update(tables.profiles)
+            .set({ level: consistentLevel, updatedAt: date(now) })
+            .where(eq(tables.profiles.userId, user.id));
+        }
+        await deps.hooks?.beforeCommit?.("complete");
+        const snapshot = progressionForXp(totalXp);
+        return privateJson({
+          awarded, xp: XP_PER_CHAPTER, level: snapshot.level, totalXp: snapshot.totalXp,
+          title: snapshot.title, realm: snapshot.realm.key, ruleVersion: snapshot.ruleVersion,
+          chapterId: session.chapterId, completed: true,
+        });
+      });
+    }),
+  };
+}
+
+export type ProgressionApi = ReturnType<typeof createProgressionApi>;
+
+/// Production wiring: identity comes from the managed session, content from
+/// Axum, and the signing secret stays server-side. No header/env request bypass.
+export async function wrapProgressionRoute(
+  run: (api: ProgressionApi, request: Request) => Promise<Response>,
+  request: Request,
+): Promise<Response> {
+  return withObservedRoute("progression", request, async () => {
+    try {
+      return await run(productionProgressionApi(), request);
+    } catch (error) {
+      return progressionErrorResponse(error);
+    }
+  });
+}
+
+export function productionProgressionApi(): ProgressionApi {
+  return createProgressionApi({
+    db: () => getDatabase(),
+    identity: async () => {
+      try {
+        const { data, error } = await getAuth().getSession();
+        if (error) return null;
+        return identityFromSession(data);
+      } catch (error) {
+        if (error instanceof AuthConfigurationError) throw error;
+        throw new ServiceError(503, "AUTH_UNAVAILABLE", "Managed authentication is temporarily unavailable.");
+      }
+    },
+    now: () => Date.now(),
+    content: () => serverContent(),
+    secret: () => readTicketSecret(),
+  });
+}
