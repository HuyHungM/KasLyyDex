+
+test("validators reject cross-origin mutations, oversize bodies and implausible timestamps", () => {
+  assert.throws(
+    () => validators.requireOrigin(request("/api/v1/me", { method: "PATCH" }, "http://evil.example")),
+    (error) => error.status === 403,
