+
+async function waitFor(predicate, timeout = 10_000) {
+  const deadline = Date.now() + timeout;
+  while (Date.now() < deadline) {
+    if (predicate()) return;
+    await delay(50);
+  }
+  throw new Error("timed out waiting for condition");
+}
+
+function progressItem(chapterId, page) {
