+impl CultivationRealm {
+    pub fn for_level(level: CultivationLevel) -> Self {
+        match level.get() {
+            1..=9 => Self::Mortal,
+            10..=49 => Self::QiRefining,
+            50..=99 => Self::FoundationEstablishment,
