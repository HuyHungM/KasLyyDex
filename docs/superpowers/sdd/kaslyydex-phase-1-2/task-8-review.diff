+      body: JSON.stringify({ seenPages: seen, complete: seen.length >= 4 }),
+    });
+  });
+  await context.route("**/api/v1/progress/complete", (route) => {
+    calls.completions += 1;
+    return route.fulfill({
+      status: 200, contentType: "application/json",
+      body: JSON.stringify({
