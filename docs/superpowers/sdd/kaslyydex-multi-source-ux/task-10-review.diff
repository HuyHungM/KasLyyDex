+  const args = process.argv.slice(2);
+  let baselineFile;
+  if (args[0] === "--baseline") {
+    baselineFile = args[1];
+    args.splice(0, 2);
+    if (!baselineFile) throw new Error("--baseline requires a file path");
+  }
+  await main(baselineFile, args[0] ?? fileURLToPath(new URL("../..", import.meta.url)));
