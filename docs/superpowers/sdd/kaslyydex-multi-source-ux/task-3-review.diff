+    #[test]
+    fn fallback_negative_result_is_cached_briefly() {
+        let dir = temp_dir("fallback-negative");
+        let key = fallback_cache_key("manga-1", "10.1", "vi");
+        assert!(!key.contains(':'));
+        assert!(!key.contains('/'));
+        assert!(!key.contains('\\'));
+        write_cache_value_at(&dir, &key, &CacheValue::Miss, NEGATIVE_TTL_SECS, 1_000);
+        assert_eq!(
