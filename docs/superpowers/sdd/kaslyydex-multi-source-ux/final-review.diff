@@ -0,0 +1,301 @@
+// Verified 2026-11-21 from the official Comick catalog OpenAPI document at
+// https://api.comick.dev/docs/json (rendered by https://api.comick.dev/docs/):
+// - GET /v1.0/search/?q=...&page=1&limit=15 — bare array; page <= 50 with
+//   limit <= 50, or page <= 5 with limit <= 300; defaults page=1, limit=15.
+// - GET /v1.0/comic/{hid}/chapters?lang=...&page=1&limit=12 — returns
+//   { chapters, total, limit, checkVol2Chap1 }; default page size 12, no max.
+// - GET /chapter/{hid}/get_images — ordered image metadata array, may be [].
+// - Origin budget: 200 requests/minute/client IP.
+// - Verified CDN image host in the official spec: meo.comick.pictures (HTTPS).
+// OAuth/Library endpoints are deliberately not used.
+
+use percent_encoding::{utf8_percent_encode, NON_ALPHANUMERIC};
+use serde_json::Value;
+use std::time::Duration;
+
+const API: &str = "https://api.comick.dev";
+const CDN: &str = "https://meo.comick.pictures";
+const CDN_HOST: &str = "meo.comick.pictures";
+const TIMEOUT: Duration = Duration::from_secs(10);
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(3);
+const UPSTREAM_ERR: &str = "Comick catalog unavailable";
+
+type Err = String;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ComickTitle {
+    pub hid: String,
+    pub title: String,
+    pub aliases: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ComickChapter {
+    pub id: String,
+    pub chapter: Option<String>,
+    pub lang: String,
+    pub title: String,
+    pub publish_at: String,
+    pub group: String,
+}
+
+#[derive(Clone)]
+pub struct Comick {
+    http: reqwest::Client,
+    api: String,
+}
+
+impl Default for Comick {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Comick {
+    pub fn new() -> Self {
+        let origin = std::env::var("COMICK_API_ORIGIN").unwrap_or_else(|_| API.to_owned());
+        Self::with_origin(origin)
+    }
+
+    /// Explicit origin for local upstream fixtures; production uses `new()`.
+    pub fn with_origin(origin: String) -> Self {
+        let trimmed = origin.trim().trim_end_matches('/').to_owned();
+        Self {
+            http: reqwest::Client::builder()
+                .timeout(TIMEOUT)
+                .connect_timeout(CONNECT_TIMEOUT)
+                .build()
+                .expect("comick http client"),
+            api: if trimmed.is_empty() {
+                API.to_owned()
+            } else {
+                trimmed
+            },
+        }
+    }
+
+    pub async fn search_titles(&self, query: &str) -> Result<Vec<ComickTitle>, Err> {
+        let body = self.get_json(&search_path(query)).await?;
+        let results = body.as_array().ok_or_else(upstream_err)?;
+        results.iter().map(title_from_value).collect()
+    }
+
+    pub async fn chapters(&self, hid: &str, lang: &str) -> Result<Vec<ComickChapter>, Err> {
+        let body = self.get_json(&chapters_path(hid, lang)?).await?;
+        let chapters = body["chapters"].as_array().ok_or_else(upstream_err)?;
+        chapters
+            .iter()
+            .map(|value| chapter_from_value(value, lang).ok_or_else(upstream_err))
+            .collect()
+    }
+
+    pub async fn page_urls(&self, chapter_id: &str) -> Result<Vec<String>, Err> {
+        let body = self.get_json(&images_path(chapter_id)?).await?;
+        let images = body.as_array().ok_or_else(upstream_err)?;
+        page_urls_from(images)
+    }
+
+    async fn get_json(&self, path: &str) -> Result<Value, Err> {
+        let response = self
+            .http
+            .get(format!("{}{path}", self.api))
+            .send()
+            .await
+            .map_err(|_| upstream_err())?;
+        if !response.status().is_success() {
+            return Err(upstream_err());
+        }
+        response.json::<Value>().await.map_err(|_| upstream_err())
+    }
+}
+
+/// Provider-prefixed chapter IDs used by content routes and progress records.
+pub fn is_comick_chapter_id(id: &str) -> bool {
+    id.strip_prefix("comick:").is_some_and(valid_opaque)
+}
+
+fn upstream_err() -> Err {
+    UPSTREAM_ERR.to_owned()
+}
+
+fn valid_opaque(value: &str) -> bool {
+    !value.is_empty() && value.chars().all(|c| !c.is_whitespace() && !c.is_control())
+}
+
+/// Accepts a provider-prefixed ID or a bare HID for internal catalog calls.
+fn request_opaque(id: &str) -> Option<&str> {
+    let raw = id.strip_prefix("comick:").unwrap_or(id);
+    valid_opaque(raw).then_some(raw)
+}
+
+fn encode(value: &str) -> String {
+    utf8_percent_encode(value, NON_ALPHANUMERIC).to_string()
+}
+
+fn search_path(query: &str) -> String {
+    format!("/v1.0/search/?q={}&page=1&limit=15", encode(query))
+}
+
+fn chapters_path(hid: &str, lang: &str) -> Result<String, Err> {
+    let hid = request_opaque(hid).ok_or_else(upstream_err)?;
+    let lang = request_opaque(lang).ok_or_else(upstream_err)?;
+    Ok(format!(
+        "/v1.0/comic/{}/chapters?lang={}&page=1&limit=12",
+        encode(hid),
+        encode(lang)
+    ))
+}
+
+fn images_path(chapter_id: &str) -> Result<String, Err> {
+    let hid = request_opaque(chapter_id).ok_or_else(upstream_err)?;
+    Ok(format!("/chapter/{}/get_images", encode(hid)))
+}
+
+fn title_from_value(value: &Value) -> Result<ComickTitle, Err> {
+    let hid = value["hid"]
+        .as_str()
+        .filter(|hid| valid_opaque(hid))
+        .ok_or_else(upstream_err)?;
+    let title = value["title"].as_str().ok_or_else(upstream_err)?.to_owned();
+    let aliases = value["md_titles"]
+        .as_array()
+        .map(|titles| {
+            titles
+                .iter()
+                .filter_map(|title| {
+                    title["title"]
+                        .as_str()
+                        .filter(|title| !title.trim().is_empty())
+                        .map(str::to_owned)
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    Ok(ComickTitle {
+        hid: format!("comick:{hid}"),
+        title,
+        aliases,
+    })
+}
+
+fn string_or_number(value: &Value) -> Option<String> {
+    match value {
+        Value::String(text) => Some(text.clone()),
+        Value::Number(number) => Some(number.to_string()),
+        _ => None,
+    }
+}
+
+fn chapter_from_value(value: &Value, fallback_lang: &str) -> Option<ComickChapter> {
+    let hid = value["hid"].as_str().filter(|hid| valid_opaque(hid))?;
+    let lang = value["lang"]
+        .as_str()
+        .filter(|lang| !lang.trim().is_empty())
+        .unwrap_or(fallback_lang);
+    if !valid_opaque(lang) {
+        return None;
+    }
+    Some(ComickChapter {
+        id: format!("comick:{hid}"),
+        chapter: string_or_number(&value["chapter"]),
+        lang: lang.to_owned(),
+        title: value["title"].as_str().unwrap_or_default().to_owned(),
+        publish_at: value["published_at"]
+            .as_str()
+            .or(value["publish_at"].as_str())
+            .or(value["created_at"].as_str())
+            .unwrap_or_default()
+            .to_owned(),
+        group: value["group"]
+            .as_str()
+            .or(value["groups"][0]["title"].as_str())
+            .unwrap_or_default()
+            .to_owned(),
+    })
+}
+
+fn page_urls_from(images: &[Value]) -> Result<Vec<String>, Err> {
+    images.iter().map(image_url).collect()
+}
+
+fn image_url(image: &Value) -> Result<String, Err> {
+    if let Some(url) = image["url"].as_str().or(image["optimized"].as_str()) {
+        let parsed = reqwest::Url::parse(url).map_err(|_| upstream_err())?;
+        if parsed.scheme() != "https"
+            || parsed.host_str() != Some(CDN_HOST)
+            || parsed.port_or_known_default() != Some(443)
+            || !parsed.username().is_empty()
+            || parsed.password().is_some()
+        {
+            return Err(upstream_err());
+        }
+        return Ok(parsed.to_string());
+    }
+    let key = image["b2key"]
+        .as_str()
+        .filter(|key| valid_opaque(key) && !key.contains('/') && !key.contains(".."))
+        .ok_or_else(upstream_err)?;
+    Ok(format!("{CDN}/{key}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn comick_id_requires_prefix_and_nonempty_opaque_id() {
+        assert!(is_comick_chapter_id("comick:abc123"));
+        for invalid in ["abc123", "comick:", "comick:bad id", ""] {
+            assert!(!is_comick_chapter_id(invalid), "accepted {invalid:?}");
+        }
+    }
+
+    #[test]
+    fn comick_chapter_normalizes_missing_title_and_language() {
+        let value = json!({
+            "hid": "chap-1",
+            "chapter": "7.5",
+            "lang": "vi",
+            "title": null
+        });
+        let chapter = chapter_from_value(&value, "en").expect("valid chapter");
+        assert_eq!(chapter.id, "comick:chap-1");
+        assert_eq!(chapter.chapter.as_deref(), Some("7.5"));
+        assert_eq!(chapter.lang, "vi");
+        assert_eq!(chapter.title, "");
+
+        let missing_lang = chapter_from_value(
+            &json!({ "hid": "chap-2", "chapter": 8, "lang": null, "title": "" }),
+            "en",
+        )
+        .expect("missing language uses the requested language");
+        assert_eq!(missing_lang.id, "comick:chap-2");
+        assert_eq!(missing_lang.chapter.as_deref(), Some("8"));
+        assert_eq!(missing_lang.lang, "en");
+        assert_eq!(missing_lang.title, "");
+        assert!(chapter_from_value(&json!({ "lang": "vi" }), "en").is_none());
+    }
+
+    #[test]
+    fn comick_page_urls_are_https_and_ordered() {
+        let urls = page_urls_from(&[json!({ "b2key": "a.jpg" }), json!({ "b2key": "b.jpg" })])
+            .expect("valid image metadata");
+        assert_eq!(urls, vec![format!("{CDN}/a.jpg"), format!("{CDN}/b.jpg")]);
+
+        for bad in [
+            json!({ "b2key": "a.jpg", "url": "http://meo.comick.pictures/a.jpg" }),
+            json!({ "b2key": "a.jpg", "url": "https://evil.example/a.jpg" }),
+        ] {
+            assert!(page_urls_from(&[bad]).is_err(), "accepted unsafe image URL");
+        }
+    }
+
+    #[test]
+    fn comick_search_path_encodes_query() {
+        assert_eq!(
+            search_path("solo leveling & 100%"),
+            "/v1.0/search/?q=solo%20leveling%20%26%20100%25&page=1&limit=15"
+        );
+    }
+}
diff --git a/crates/core/src/fallback.rs b/crates/core/src/fallback.rs
new file mode 100644
index 0000000..3a65ef6
--- /dev/null
+++ b/crates/core/src/fallback.rs
@@ -0,0 +1,583 @@
+use crate::{comick, imgcache, mangadex, Comick, Md};
+use comick::{is_comick_chapter_id, ComickChapter};
+use contracts::{ChapterDto, ChapterMetadataDto, ChaptersResponse, MangaSummaryDto, PagesResponse};
+use mangadex::is_uuid;
+use percent_encoding::{utf8_percent_encode, NON_ALPHANUMERIC};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const SOURCE: &str = "comick";
+const SOURCE_LABEL: &str = "Comick";
+const POSITIVE_TTL_SECS: u64 = 3_600;
+const NEGATIVE_TTL_SECS: u64 = 60;
+const MAX_TTL_SECS: u64 = 86_400;
+const MAX_CACHE_BYTES: u64 = 4_096;
+const MAX_CACHE_FILES: usize = 512;
+const MAX_TITLE_CANDIDATES: usize = 3;
+
+#[derive(Clone)]
+pub struct ContentState {
+    pub md: Md,
+    pub comick: Option<Comick>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+struct CachedMatch {
+    manga_id: String,
+    comic_id: String,
+    chapter_id: String,
+    chapter: String,
+    lang: String,
+    title: String,
+    publish_at: String,
+    group: String,
+    pages: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum CacheValue {
+    Hit { mapping: CachedMatch },
+    Miss,
+}
+
+#[derive(Serialize, Deserialize)]
+struct CacheEnvelope {
+    expires: u64,
+    value: CacheValue,
+}
+
+/// Source-aware chapter lists: MangaDex stays primary; Comick only fills gaps.
+pub async fn enrich_chapters(
+    state: &ContentState,
+    manga: &MangaSummaryDto,
+    mut chapters: ChaptersResponse,
+) -> Result<ChaptersResponse, String> {
+    let Some(comick) = state.comick.as_ref() else {
+        return Ok(chapters);
+    };
+    let needs_fallback = chapters
+        .vi
+        .iter()
+        .chain(chapters.en.iter())
+        .any(|chapter| !is_readable(chapter));
+    if !needs_fallback {
+        return Ok(chapters);
+    }
+    let titles = comick.search_titles(&manga.title).await.unwrap_or_default();
+    let titles: Vec<_> = titles
+        .into_iter()
+        .filter(|title| title_matches(&manga.title, title))
+        .take(MAX_TITLE_CANDIDATES)
+        .collect();
+    if titles.is_empty() {
+        return Ok(chapters);
+    }
+
+    // One bounded search + up to two language fetches per title candidate.
+    let mut candidates = Vec::new();
+    let mut comic_by_chapter = HashMap::new();
+    for title in &titles {
+        for lang in ["vi", "en"] {
+            if let Ok(found) = comick.chapters(&title.hid, lang).await {
+                for candidate in found {
+                    comic_by_chapter.insert(candidate.id.clone(), title.hid.clone());
+                    candidates.push(candidate);
+                }
+            }
+        }
+    }
+    if candidates.is_empty() {
+        return Ok(chapters);
+    }
+
+    chapters.vi = enrich_list(
+        comick,
+        manga.id.as_str(),
+        chapters.vi,
+        &candidates,
+        &comic_by_chapter,
+    )
+    .await;
+    chapters.en = enrich_list(
+        comick,
+        manga.id.as_str(),
+        chapters.en,
+        &candidates,
+        &comic_by_chapter,
+    )
+    .await;
+    Ok(chapters)
+}
+
+/// Source-aware page lookup; every returned URL stays on this origin.
+pub async fn chapter_pages(
+    state: &ContentState,
+    chapter_id: &str,
+) -> Result<PagesResponse, String> {
+    if is_comick_chapter_id(chapter_id) {
+        let comick = state
+            .comick
+            .as_ref()
+            .ok_or_else(|| "Comick catalog unavailable".to_owned())?;
+        let urls = comick.page_urls(chapter_id).await?;
+        if urls.is_empty() {
+            return Err("Comick chapter has no readable pages.".to_owned());
+        }
+        return Ok(PagesResponse {
+            pages: urls.iter().map(|url| image_proxy_path(url)).collect(),
+        });
+    }
+    if !is_uuid(chapter_id) {
+        return Err("Mã chương không hợp lệ.".to_owned());
+    }
+    state.md.pages(chapter_id).await
+}
+
+/// Fallback metadata comes from the cached mapping made by `enrich_chapters`.
+pub async fn chapter_metadata(
+    state: &ContentState,
+    chapter_id: &str,
+) -> Result<ChapterMetadataDto, String> {
+    if is_comick_chapter_id(chapter_id) {
+        let mapping = cached_mapping(chapter_id)
+            .ok_or_else(|| "Comick chapter mapping unavailable".to_owned())?;
+        return Ok(ChapterMetadataDto {
+            id: mapping.chapter_id,
+            manga_id: mapping.manga_id,
+            lang: mapping.lang,
+            pages: mapping.pages,
+            external_url: None,
+            unavailable: mapping.pages == 0,
+            chapter: Some(mapping.chapter),
+            title: mapping.title,
+        });
+    }
+    if !is_uuid(chapter_id) {
+        return Err("Mã chương không hợp lệ.".to_owned());
+    }
+    state.md.chapter_metadata(chapter_id).await
+}
+
+/// Bounded, path-safe disk key: source, primary manga, chapter and language.
+pub fn fallback_cache_key(manga_id: &str, chapter: &str, lang: &str) -> String {
+    let number = normalize_chapter_number(Some(chapter)).unwrap_or_else(|| chapter.to_owned());
+    let raw = format!("{SOURCE}\0{manga_id}\0{number}\0{lang}");
+    format!("fallback-comick-{:x}", Sha256::digest(raw.as_bytes()))
+}
+
+async fn enrich_list(
+    comick: &Comick,
+    manga_id: &str,
+    chapters: Vec<ChapterDto>,
+    candidates: &[ComickChapter],
+    comic_by_chapter: &HashMap<String, String>,
+) -> Vec<ChapterDto> {
+    let mut out = Vec::with_capacity(chapters.len());
+    for chapter in chapters {
+        if is_readable(&chapter) {
+            out.push(chapter);
+            continue;
+        }
+        let number = chapter.chapter.as_deref().unwrap_or("");
+        let key = fallback_cache_key(manga_id, number, &chapter.lang);
+        let mapping = match read_cache_value(&key) {
+            Some(CacheValue::Hit { mapping }) if is_comick_chapter_id(&mapping.chapter_id) => {
+                Some(mapping)
+            }
+            Some(CacheValue::Miss) => None,
+            _ => {
+                let mut found = None;
+                if let Some(candidate) = match_chapter(number, &chapter.lang, candidates) {
+                    if let Ok(urls) = comick.page_urls(&candidate.id).await {
+                        if !urls.is_empty() {
+                            found = Some(CachedMatch {
+                                manga_id: manga_id.to_owned(),
+                                comic_id: comic_by_chapter
+                                    .get(&candidate.id)
+                                    .cloned()
+                                    .unwrap_or_else(|| candidate.id.clone()),
+                                chapter_id: candidate.id.clone(),
+                                chapter: number.to_owned(),
+                                lang: candidate.lang.clone(),
+                                title: candidate.title.clone(),
+                                publish_at: candidate.publish_at.clone(),
+                                group: candidate.group.clone(),
+                                pages: urls.len() as u64,
+                            });
+                        }
+                    }
+                }
+                match found {
+                    Some(mapping) => {
+                        write_cache_value(
+                            &key,
+                            &CacheValue::Hit {
+                                mapping: mapping.clone(),
+                            },
+                            POSITIVE_TTL_SECS,
+                        );
+                        Some(mapping)
+                    }
+                    None => {
+                        write_cache_value(&key, &CacheValue::Miss, NEGATIVE_TTL_SECS);
+                        None
+                    }
+                }
+            }
+        };
+        out.push(mapping.map(fallback_chapter).unwrap_or(chapter));
+    }
+    out
+}
+
+fn fallback_chapter(mapping: CachedMatch) -> ChapterDto {
+    ChapterDto {
+        id: mapping.chapter_id.into(),
+        chapter: Some(mapping.chapter),
+        volume: None,
+        title: mapping.title,
+        lang: mapping.lang,
+        pages: mapping.pages,
+        external_url: None,
+        publish_at: mapping.publish_at,
+        group: mapping.group,
+        source: SOURCE.to_owned(),
+        source_label: SOURCE_LABEL.to_owned(),
+        readable: true,
+    }
+}
+
+fn is_readable(chapter: &ChapterDto) -> bool {
+    chapter.readable || (chapter.pages > 0 && chapter.external_url.is_none())
+}
+
+fn title_matches(manga_title: &str, candidate: &comick::ComickTitle) -> bool {
+    let wanted = normalize_title(manga_title);
+    wanted == normalize_title(&candidate.title)
+        || candidate
+            .aliases
+            .iter()
+            .any(|alias| wanted == normalize_title(alias))
+}
+
+fn normalize_title(value: &str) -> String {
+    value
+        .chars()
+        .flat_map(char::to_lowercase)
+        .filter(|c| c.is_alphanumeric() || c.is_whitespace())
+        .collect::<String>()
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// Canonical numeric chapter label. Decimal labels stay distinct from neighbors.
+fn normalize_chapter_number(raw: Option<&str>) -> Option<String> {
+    let value = raw?.trim();
+    let value = value.strip_prefix('#').unwrap_or(value).trim();
+    if value.is_empty() {
+        return None;
+    }
+    let (whole, fraction) = match value.split_once('.') {
+        Some((whole, fraction)) => (whole, Some(fraction)),
+        None => (value, None),
+    };
+    if whole.is_empty() || !whole.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    if fraction.is_some_and(|fraction| {
+        fraction.is_empty() || !fraction.bytes().all(|b| b.is_ascii_digit())
+    }) {
+        return None;
+    }
+    let whole = whole.trim_start_matches('0');
+    let mut out = if whole.is_empty() { "0" } else { whole }.to_owned();
+    if let Some(fraction) = fraction {
+        let fraction = fraction.trim_end_matches('0');
+        if !fraction.is_empty() {
+            out.push('.');
+            out.push_str(fraction);
+        }
+    }
+    Some(out)
+}
+
+fn match_chapter<'a>(
+    chapter: &str,
+    lang: &str,
+    candidates: &'a [ComickChapter],
+) -> Option<&'a ComickChapter> {
+    let number = normalize_chapter_number(Some(chapter))?;
+    let mut matches: Vec<_> = candidates
+        .iter()
+        .enumerate()
+        .filter(|(_, candidate)| {
+            candidate.lang.eq_ignore_ascii_case(lang)
+                && normalize_chapter_number(candidate.chapter.as_deref()).as_deref()
+                    == Some(number.as_str())
+        })
+        .collect();
+    // Language preference first (vi before en), provider order breaks ties.
+    matches.sort_by_key(|(index, candidate)| (language_rank(&candidate.lang), *index));
+    matches.first().map(|(_, candidate)| *candidate)
+}
+
+fn language_rank(lang: &str) -> u8 {
+    if lang.eq_ignore_ascii_case("vi") {
+        0
+    } else if lang.eq_ignore_ascii_case("en") {
+        1
+    } else {
+        2
+    }
+}
+
+fn image_proxy_path(url: &str) -> String {
+    format!(
+        "/api/content/img?u={}",
+        utf8_percent_encode(url, NON_ALPHANUMERIC)
+    )
+}
+
+fn now_secs() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+}
+
+fn read_cache_value(key: &str) -> Option<CacheValue> {
+    read_cache_value_at(&imgcache::cache_dir(), key, now_secs())
+}
+
+fn read_cache_value_at(dir: &Path, key: &str, now: u64) -> Option<CacheValue> {
+    let path = dir.join(key);
+    let meta = std::fs::metadata(&path).ok()?;
+    if meta.len() > MAX_CACHE_BYTES {
+        return None;
+    }
+    let bytes = std::fs::read(&path).ok()?;
+    let envelope: CacheEnvelope = serde_json::from_slice(&bytes).ok()?;
+    (envelope.expires > now).then_some(envelope.value)
+}
+
+fn write_cache_value(key: &str, value: &CacheValue, ttl_secs: u64) {
+    write_cache_value_at(&imgcache::cache_dir(), key, value, ttl_secs, now_secs());
+}
+
+fn write_cache_value_at(dir: &Path, key: &str, value: &CacheValue, ttl_secs: u64, now: u64) {
+    let Ok(bytes) = serde_json::to_vec(&CacheEnvelope {
+        expires: now.saturating_add(ttl_secs.min(MAX_TTL_SECS)),
+        value: value.clone(),
+    }) else {
+        return;
+    };
+    if bytes.len() as u64 > MAX_CACHE_BYTES || std::fs::create_dir_all(dir).is_err() {
+        return;
+    }
+    prune_cache(dir);
+    let _ = std::fs::write(dir.join(key), bytes);
+}
+
+fn prune_cache(dir: &Path) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    let mut files: Vec<(PathBuf, SystemTime)> = entries
+        .filter_map(Result::ok)
+        .filter(|entry| {
+            entry
+                .file_name()
+                .to_string_lossy()
+                .starts_with("fallback-comick-")
+        })
+        .filter_map(|entry| Some((entry.path(), entry.metadata().ok()?.modified().ok()?)))
+        .collect();
+    if files.len() < MAX_CACHE_FILES {
+        return;
+    }
+    files.sort_by_key(|(_, modified)| *modified);
+    let excess = files.len() - MAX_CACHE_FILES + 1;
+    for (path, _) in files.into_iter().take(excess) {
+        let _ = std::fs::remove_file(path);
+    }
+}
+
+fn cached_mapping(chapter_id: &str) -> Option<CachedMatch> {
+    let dir = imgcache::cache_dir();
+    let entries = std::fs::read_dir(dir).ok()?;
+    let now = now_secs();
+    for entry in entries.filter_map(Result::ok) {
+        let path = entry.path();
+        if !path
+            .file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| name.starts_with("fallback-comick-"))
+        {
+            continue;
+        }
+        let bytes = match std::fs::read(&path) {
+            Ok(bytes) => bytes,
+            Err(_) => continue,
+        };
+        let envelope: CacheEnvelope = match serde_json::from_slice(&bytes) {
+            Ok(envelope) => envelope,
+            Err(_) => continue,
+        };
+        if envelope.expires <= now {
+            continue;
+        }
+        if let CacheValue::Hit { mapping } = envelope.value {
+            if mapping.chapter_id == chapter_id {
+                return Some(mapping);
