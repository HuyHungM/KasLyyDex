+++ b/web/scripts/whitespace-check.mjs
@@ -1,11 +1,14 @@
-// Usage: node scripts/whitespace-check.mjs [repoDir]
+// Usage: node scripts/whitespace-check.mjs [--baseline <file>] [repoDir]
 // Inspects tracked files from the checkout/index, unlike `git diff --check`
 // on a clean checkout. Reports file:line without printing file contents.
+// With --baseline, findings listed in the baseline file (`file:line:rule`
+// per line, `#` comments allowed) are pre-existing and do not fail the gate;
+// any new finding still fails.
 import { execFileSync } from "node:child_process";
 import { readFile } from "node:fs/promises";
 import { join, resolve } from "node:path";
 import { fileURLToPath } from "node:url";
 
 export function scanText(text, file = "<text>") {
   const findings = [];
   const lines = text.split(/\r?\n/);
@@ -15,16 +18,30 @@ export function scanText(text, file = "<text>") {
     }
     if (/^(<{7}|>{7})(?:\s|$)/.test(lines[index])) {
       findings.push({ file, line: index + 1, rule: "conflict-marker" });
     }
   }
   return findings;
 }
 
+export function findingKey(finding) {
+  return `${finding.file}:${finding.line}:${finding.rule}`;
+}
+
+export async function loadBaseline(baselineFile) {
+  const text = await readFile(baselineFile, "utf8");
+  return new Set(
+    text
+      .split(/\r?\n/)
+      .map((line) => line.trim())
+      .filter((line) => line && !line.startsWith("#")),
+  );
+}
+
 export async function scanRepo(repoDir) {
   const files = execFileSync("git", ["ls-files", "-z"], { cwd: repoDir, encoding: "utf8" })
     .split("\0")
     .filter(Boolean);
   const findings = [];
   for (const file of files) {
     let text;
     try {
@@ -33,24 +50,37 @@ export async function scanRepo(repoDir) {
       continue;
     }
     if (text.includes("\0")) continue; // binary
     findings.push(...scanText(text, file));
   }
   return { files: files.length, findings };
 }
 
-async function main(repoDir) {
+async function main(baselineFile, repoDir) {
   const { files, findings } = await scanRepo(resolve(repoDir));
-  if (findings.length > 0) {
-    for (const finding of findings) {
+  const baseline = baselineFile ? await loadBaseline(baselineFile) : new Set();
+  const fresh = findings.filter((finding) => !baseline.has(findingKey(finding)));
+  const known = findings.length - fresh.length;
+  if (fresh.length > 0) {
+    for (const finding of fresh) {
       console.error(`${finding.file}:${finding.line}: ${finding.rule}`);
     }
-    console.error(`whitespace check failed: ${findings.length} finding(s)`);
+    console.error(`whitespace check failed: ${fresh.length} new finding(s), ${known} baselined`);
     process.exitCode = 1;
     return;
   }
-  console.log(`whitespace check passed: ${files} tracked files inspected, 0 findings`);
+  console.log(
+    `whitespace check passed: ${files} tracked files inspected, ` +
+      (known > 0 ? `0 new findings (${known} baselined)` : "0 findings"),
+  );
 }
 
 if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
-  await main(process.argv[2] ?? fileURLToPath(new URL("../..", import.meta.url)));
+  const args = process.argv.slice(2);
+  let baselineFile;
+  if (args[0] === "--baseline") {
+    baselineFile = args[1];
+    args.splice(0, 2);
+    if (!baselineFile) throw new Error("--baseline requires a file path");
+  }
+  await main(baselineFile, args[0] ?? fileURLToPath(new URL("../..", import.meta.url)));
 }
diff --git a/web/scripts/whitespace-check.test.mjs b/web/scripts/whitespace-check.test.mjs
index 51b144e..cd15497 100644
--- a/web/scripts/whitespace-check.test.mjs
+++ b/web/scripts/whitespace-check.test.mjs
@@ -35,8 +35,33 @@ test("tracked-file whitespace gate RED on seeded file, GREEN after cleanup", ()
     execFileSync("git", ["add", "trailing.txt"], { cwd: fixture });
     const green = spawnSync(process.execPath, [script, fixture], { encoding: "utf8" });
     assert.equal(green.status, 0, green.stderr);
     assert.match(green.stdout, /0 findings/);
   } finally {
     rmSync(fixture, { recursive: true, force: true });
   }
 });
+
+test("--baseline tolerates listed findings but still fails on new ones", () => {
+  const fixture = join(webDir, ".test-cache", `whitespace-baseline-${process.pid}`);
+  mkdirSync(fixture, { recursive: true });
+  try {
+    execFileSync("git", ["init", "-q"], { cwd: fixture });
+    writeFileSync(join(fixture, "old.txt"), "known line \n");
+    writeFileSync(join(fixture, "new.txt"), "new line \n");
+    execFileSync("git", ["add", "."], { cwd: fixture });
+    const baseline = join(fixture, "baseline.txt");
+    writeFileSync(baseline, "# comment\nold.txt:1:trailing-whitespace\n");
+
+    const tolerated = spawnSync(process.execPath, [script, "--baseline", baseline, fixture], { encoding: "utf8" });
+    assert.equal(tolerated.status, 1, tolerated.stderr);
+    assert.match(tolerated.stderr, /new\.txt:1: trailing-whitespace/);
+    assert.match(tolerated.stderr, /1 baselined/);
+
+    writeFileSync(baseline, "old.txt:1:trailing-whitespace\nnew.txt:1:trailing-whitespace\n");
+    const passed = spawnSync(process.execPath, [script, "--baseline", baseline, fixture], { encoding: "utf8" });
+    assert.equal(passed.status, 0, passed.stderr);
+    assert.match(passed.stdout, /0 new findings \(2 baselined\)/);
+  } finally {
+    rmSync(fixture, { recursive: true, force: true });
+  }
+});
