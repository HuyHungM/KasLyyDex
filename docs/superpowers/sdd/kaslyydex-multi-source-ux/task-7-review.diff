+/* Shared dropdown: the trigger keeps focus while the listbox handles selection. */
+.select { position: relative; display: inline-block; width: 100%; min-width: 0; }
+.select-trigger {
+  display: flex; width: 100%; min-height: 44px; align-items: center; justify-content: space-between;
+  gap: 8px; padding: 8px 11px; border: 1px solid var(--line); border-radius: 8px;
+  background: var(--surface); color: var(--text); text-align: left; font-size: .875rem; font-weight: 600;
+}
+.select-trigger:hover:not(:disabled) { background: var(--hover); }
+.select[data-open="true"] .select-trigger { border-color: var(--accent); }
+.select-value { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+.select-chevron { color: var(--muted); transition: transform .12s ease; }
+.select[data-open="true"] .select-chevron { transform: rotate(180deg); }
+.select-list {
+  position: absolute; z-index: 20; inset: calc(100% + 4px) 0 auto; display: block;
+  max-height: min(280px, 50dvh); overflow-y: auto; margin: 0; padding: 4px;
+  border: 1px solid var(--line); border-radius: 9px; background: var(--surface);
+  box-shadow: 0 10px 24px #0003; list-style: none;
+}
+.select-list[hidden] { display: none; }
+.select-option { min-height: 40px; padding: 8px 10px; border-radius: 6px; color: var(--text); font-size: .875rem; cursor: pointer; }
+.select-option:hover { background: var(--hover); }
+.select-option[aria-selected="true"] { background: var(--soft); color: var(--accent); font-weight: 600; }
+.select-option[aria-disabled="true"] { opacity: .5; cursor: default; }
+@media (prefers-reduced-motion: no-preference) {
+  .select[data-open="true"] .select-list:not([hidden]) { animation: select-in .12s ease-out both; }
+  @keyframes select-in { from { opacity: 0; transform: translateY(-3px); } }
